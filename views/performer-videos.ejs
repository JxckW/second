<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            background: #0a0a0a; 
            color: #e0e0e0; 
            min-height: 100vh;
        }
        .app { max-width: 1400px; margin: 0 auto; padding: 16px; }
        
        header { 
            margin-bottom: 20px; 
            padding: 16px 0; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            flex-wrap: wrap;
            border-bottom: 1px solid #1a1a1a;
        }
        header h1 { 
            font-size: 24px; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
        }
        .back-link { 
            display: inline-block; 
            color: #667eea; 
            text-decoration: none; 
            font-size: 14px;
            padding: 8px 16px;
            border: 1px solid #667eea;
            border-radius: 8px;
        }
        .back-link:hover { 
            background: #667eea; 
            color: #fff;
        }

        .performer-header {
            background: #1a1a1a;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid #2a2a2a;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }
        .performer-header .name {
            font-size: 28px;
            font-weight: bold;
            color: #fff;
        }
        .performer-header .stats {
            color: #888;
            font-size: 14px;
        }
        .performer-header .stats span {
            margin-left: 16px;
        }

        .mode-switcher {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .mode-btn {
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid #333;
            background: transparent;
            color: #888;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            font-size: 14px;
        }
        .mode-btn:hover {
            border-color: #667eea;
            color: #667eea;
        }
        .mode-btn.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: #667eea;
            color: #fff;
        }

        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }

        .video-card {
            background: #1a1a1a;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2a2a2a;
            transition: transform 0.2s, border-color 0.2s;
            cursor: pointer;
        }
        .video-card:hover {
            transform: translateY(-4px);
            border-color: #667eea;
        }

        .video-thumbnail {
            position: relative;
            width: 100%;
            padding-top: 56.25%;
            background: #111;
            overflow: hidden;
        }
        .video-thumbnail img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .video-thumbnail .no-image {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 40px;
            opacity: 0.3;
        }
        .video-thumbnail .duration {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(0,0,0,0.8);
            padding: 2px 10px;
            border-radius: 4px;
            font-size: 12px;
            color: #fff;
        }
        .video-thumbnail .play-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            background: rgba(102, 126, 234, 0.9);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: #fff;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .video-card:hover .play-btn {
            opacity: 1;
        }
        .video-thumbnail .quality-badge {
            position: absolute;
            top: 8px;
            left: 8px;
            background: rgba(0,0,0,0.8);
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 11px;
            color: #f0c040;
            border: 1px solid #f0c040;
        }

        .video-info {
            padding: 12px;
        }
        .video-info .title {
            font-size: 14px;
            color: #fff;
            margin-bottom: 4px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.3;
        }
        .video-info .meta {
            font-size: 12px;
            color: #888;
        }
        .video-info .studio {
            color: #667eea;
        }

        .no-videos {
            text-align: center;
            padding: 60px;
            color: #888;
        }
        .no-videos h3 { color: #fff; margin-bottom: 8px; }
        
        .video-stats {
            color: #888;
            font-size: 14px;
            margin-bottom: 16px;
        }

        /* Video Player Modal */
        .video-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        .video-modal.active {
            display: flex;
        }
        .video-modal .close-modal {
            position: absolute;
            top: 20px;
            right: 30px;
            font-size: 40px;
            color: #fff;
            cursor: pointer;
            z-index: 1001;
            font-family: Arial, sans-serif;
            background: none;
            border: none;
            padding: 10px;
            line-height: 1;
        }
        .video-modal .close-modal:hover {
            color: #667eea;
            transform: scale(1.2);
        }
        .video-modal .video-container {
            width: 90%;
            max-width: 1000px;
            max-height: 90vh;
            position: relative;
        }
        .video-modal video {
            width: 100%;
            max-height: 80vh;
            background: #000;
            border-radius: 8px;
        }
        .video-modal .video-title {
            color: #fff;
            font-size: 18px;
            margin-top: 12px;
            text-align: center;
            max-width: 90%;
        }
        .video-modal .video-controls {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 12px;
            flex-wrap: wrap;
        }
        .video-modal .video-controls button {
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid #667eea;
            background: transparent;
            color: #667eea;
            cursor: pointer;
            transition: all 0.2s;
        }
        .video-modal .video-controls button:hover {
            background: #667eea;
            color: #fff;
        }
        .video-modal .video-loading {
            color: #888;
            text-align: center;
            padding: 40px;
            font-size: 18px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
        }
        .video-modal .video-error {
            color: #ff6b6b;
            text-align: center;
            padding: 40px;
            font-size: 18px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
        }
        .video-modal .video-error a {
            color: #667eea;
        }

        /* Pagination */
        .pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
            flex-wrap: wrap;
        }
        .page-link {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 8px;
            background: #1a1a1a;
            color: #e0e0e0;
            text-decoration: none;
            border: 1px solid #2a2a2a;
            font-size: 14px;
            transition: background 0.2s;
            cursor: pointer;
        }
        .page-link:hover {
            background: #2a2a2a;
            border-color: #667eea;
        }
        .page-link.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: #667eea;
            color: #fff;
        }

        @media (max-width: 768px) {
            .video-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
            .performer-header .name { font-size: 20px; }
            .performer-header .stats { font-size: 12px; }
            .video-modal .video-container { width: 98%; }
            .video-modal .close-modal { top: 10px; right: 20px; font-size: 30px; }
            .mode-btn { font-size: 12px; padding: 6px 14px; }
        }
    </style>
</head>
<body>
    <div class="app">
        <header>
            <div>
                <a href="/performer/<%= performerId %>" class="back-link">← Back to Profile</a>
                <h1>🎬 Video Mode</h1>
            </div>
            <div>
                <span style="color: #888; font-size: 14px;">
                    <%= totalWowScenes %> videos found
                </span>
            </div>
        </header>

        <div class="performer-header">
            <div>
                <div class="name"><%= performer.name %></div>
                <div class="stats">
                    <span>🎬 <%= totalWowScenes %> scenes</span>
                    <span>📹 <%= videosFound %> with 720p</span>
                </div>
            </div>
            <div class="mode-switcher">
                <a href="/performer/<%= performerId %>" class="mode-btn">📋 Profile Mode</a>
                <a href="/performer/<%= performerId %>/videos" class="mode-btn active">🎬 Video Mode</a>
            </div>
        </div>

        <% if (hasWowData && wowScenes && wowScenes.length > 0) { %>
            <div class="video-stats">
                Showing <%= (currentPage - 1) * perPage + 1 %> - <%= Math.min(currentPage * perPage, totalWowScenes) %> of <%= totalWowScenes %> videos
            </div>

            <div class="video-grid">
                <% wowScenes.forEach(scene => { %>
                    <%
                        const safeTitle = JSON.stringify(scene.title || 'Untitled Scene');
                        const safeThumbnail = JSON.stringify(scene.thumbnail || '');
                        // Use the scene URL from the data
                        const sceneUrl = scene.url || scene.scene_url || '';
                        const safeSceneUrl = JSON.stringify(sceneUrl);
                        const videoId = scene.videoId || '';
                    %>
                    <div class="video-card" onclick="playVideo(<%= safeSceneUrl %>, <%= safeTitle %>, <%= safeThumbnail %>)">
                        <div class="video-thumbnail">
                            <% if (scene.thumbnail) { %>
                                <img src="<%= scene.thumbnail %>" alt="<%= scene.title %>" loading="lazy">
                            <% } else { %>
                                <div class="no-image">🎬</div>
                            <% } %>
                            <div class="duration"><%= scene.duration || 'N/A' %></div>
                            <div class="play-btn">▶</div>
                            <% if (scene.allQualities && scene.allQualities.includes('2160')) { %>
                                <div class="quality-badge">4K</div>
                            <% } else if (scene.allQualities && scene.allQualities.some(q => q === '1080' || q === '1080p')) { %>
                                <div class="quality-badge">HD</div>
                            <% } %>
                        </div>
                        <div class="video-info">
                            <div class="title"><%= scene.title %></div>
                            <div class="meta">
                                <% if (scene.studio) { %>
                                    <span class="studio">🏢 <%= scene.studio.name || scene.studio %></span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Test/Dev Tool -->
            <div style="margin: 20px 0; padding: 15px; background: #1a1a1a; border-radius: 8px; border: 1px solid #2a2a2a;">
                <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                    <input type="text" id="testSceneUrl" placeholder="Paste scene URL to test..." style="flex: 1; min-width: 200px; padding: 10px; background: #252525; color: #e0e0e0; border: 1px solid #333; border-radius: 6px; font-size: 13px;">
                    <button onclick="testVideoUrl()" style="padding: 10px 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">🔍 Test</button>
                    <button onclick="document.getElementById('testSceneUrl').value=''; document.getElementById('testResult').textContent=''" style="padding: 10px 16px; background: #333; color: #888; border: none; border-radius: 6px; cursor: pointer;">✕</button>
                </div>
                <div id="testResult" style="margin-top: 8px; font-size: 13px; color: #888; min-height: 20px;"></div>
            </div>

            <% if (totalPages > 1) { %>
                <div class="pagination">
                    <% if (currentPage > 1) { %>
                        <a href="/performer/<%= performerId %>/videos?page=<%= currentPage - 1 %>" class="page-link">← Previous</a>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <% if (i === currentPage) { %>
                            <span class="page-link active"><%= i %></span>
                        <% } else if (i <= 3 || i > totalPages - 3 || Math.abs(i - currentPage) <= 1) { %>
                            <a href="/performer/<%= performerId %>/videos?page=<%= i %>" class="page-link"><%= i %></a>
                        <% } else if (i === 4 && currentPage > 5) { %>
                            <span class="page-link">…</span>
                        <% } else if (i === totalPages - 3 && currentPage < totalPages - 4) { %>
                            <span class="page-link">…</span>
                        <% } %>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <a href="/performer/<%= performerId %>/videos?page=<%= currentPage + 1 %>" class="page-link">Next →</a>
                    <% } %>
                </div>
            <% } %>
        <% } else { %>
            <div class="no-videos">
                <h3>🎬 No Videos Found</h3>
                <p>No wow.xxx videos found for <%= performer.name %></p>
            </div>
        <% } %>
    </div>

    <!-- Video Player Modal -->
    <div class="video-modal" id="videoModal">
        <button class="close-modal" onclick="closeVideoModal()">✕</button>
        <div class="video-container">
            <div id="videoLoading" class="video-loading">⏳ Loading video...</div>
            <div id="videoError" class="video-error" style="display:none;"></div>
            
            <video id="videoPlayer" width="100%" controls preload="metadata" playsinline>
                <source id="videoSource" src="" type="video/mp4">
                Your browser does not support the video tag.
            </video>
            
            <div id="videoTitle" class="video-title">Video</div>
            <div class="video-controls">
                <button onclick="closeVideoModal()">✕ Close</button>
                <button onclick="document.getElementById('videoPlayer').requestFullscreen()">⛶ Fullscreen</button>
                <button onclick="document.getElementById('videoPlayer').play()">▶ Play</button>
                <button onclick="document.getElementById('videoPlayer').pause()">⏸ Pause</button>
            </div>
        </div>
    </div>

    <script>
        // =========================
        // VIDEO PLAYER - Uses fresh token from scene URL
        // =========================
        
        // Current video URL for reference
        let currentVideoUrl = null;

        // Main play function - called when user clicks a video card
        async function playVideo(sceneUrl, title, thumbnail) {
            console.log('🎬 Playing video:', title);
            console.log('   Scene URL:', sceneUrl);
            
            // Show loading state
            const modal = document.getElementById('videoModal');
            const loading = document.getElementById('videoLoading');
            const errorEl = document.getElementById('videoError');
            const video = document.getElementById('videoPlayer');
            const titleEl = document.getElementById('videoTitle');
            const source = document.getElementById('videoSource');
            
            // Reset modal
            modal.classList.add('active');
            loading.style.display = 'block';
            loading.textContent = '⏳ Fetching fresh video token...';
            errorEl.style.display = 'none';
            errorEl.textContent = '';
            titleEl.textContent = title || 'Video';
            video.pause();
            video.currentTime = 0;
            source.src = '';
            video.load();
            currentVideoUrl = null;
            
            try {
                // Step 1: Get fresh video URL from server
                const response = await fetch(
                    `/api/video/fresh?sceneUrl=${encodeURIComponent(sceneUrl)}`
                );
                
                const data = await response.json();
                
                if (!data.success || !data.videoUrl) {
                    throw new Error(data.error || 'Could not get video URL');
                }
                
                currentVideoUrl = data.videoUrl;
                console.log('✅ Fresh video URL:', currentVideoUrl.substring(0, 80) + '...');
                
                // Step 2: Load the video
                loading.textContent = '⏳ Loading video...';
                
                source.src = currentVideoUrl;
                video.load();
                
                // Step 3: Handle video events
                video.oncanplay = function() {
                    console.log('✅ Video can play');
                    loading.style.display = 'none';
                    video.play().catch(e => console.log('Autoplay prevented:', e));
                };
                
                video.onerror = function(e) {
                    console.error('❌ Video error:', e);
                    loading.style.display = 'none';
                    errorEl.style.display = 'block';
                    errorEl.innerHTML = `
                        ❌ Error loading video
                        <br><br>
                        <a href="${currentVideoUrl}" target="_blank" style="color: #667eea; text-decoration: underline;">
                            📥 Try opening directly in new tab
                        </a>
                        <br><br>
                        <span style="font-size: 13px; color: #888;">
                            If the video doesn't open, the token may have expired.
                            Try refreshing the page and clicking again.
                        </span>
                    `;
                };
                
            } catch (error) {
                console.error('❌ Error:', error.message);
                loading.style.display = 'none';
                errorEl.style.display = 'block';
                errorEl.innerHTML = `
                    ❌ Failed to get video: ${error.message}
                    <br><br>
                    <button onclick="closeVideoModal()" style="
                        padding: 8px 20px;
                        border-radius: 8px;
                        border: 1px solid #667eea;
                        background: transparent;
                        color: #667eea;
                        cursor: pointer;
                    ">Close</button>
                `;
            }
        }

        // Close video modal
        function closeVideoModal() {
            console.log('🔒 Closing video modal');
            const modal = document.getElementById('videoModal');
            const video = document.getElementById('videoPlayer');
            const source = document.getElementById('videoSource');
            
            video.pause();
            video.currentTime = 0;
            source.src = '';
            video.load();
            modal.classList.remove('active');
            currentVideoUrl = null;
            
            document.getElementById('videoLoading').style.display = 'block';
            document.getElementById('videoLoading').textContent = '⏳ Loading video...';
            document.getElementById('videoError').style.display = 'none';
        }

        // Test function for debugging
        async function testVideoUrl() {
            const sceneUrl = document.getElementById('testSceneUrl').value.trim();
            const result = document.getElementById('testResult');
            
            if (!sceneUrl) {
                result.textContent = '❌ Please enter a scene URL';
                result.style.color = '#ff6b6b';
                return;
            }
            
            result.textContent = '⏳ Testing...';
            result.style.color = '#888';
            
            try {
                const response = await fetch(`/api/video/fresh?sceneUrl=${encodeURIComponent(sceneUrl)}`);
                const data = await response.json();
                
                if (data.success && data.videoUrl) {
                    result.innerHTML = `✅ Success! <a href="${data.videoUrl}" target="_blank" style="color: #667eea; text-decoration: underline;">Open video</a>`;
                    result.style.color = '#4caf50';
                    
                    // Optionally play the video
                    playVideo(sceneUrl, 'Test Video', '');
                } else {
                    result.textContent = '❌ Failed: ' + (data.error || 'Unknown error');
                    result.style.color = '#ff6b6b';
                }
            } catch (error) {
                result.textContent = '❌ Error: ' + error.message;
                result.style.color = '#ff6b6b';
            }
        }

        // Keyboard shortcut: Escape to close
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeVideoModal();
            }
        });

        // Click outside to close
        document.getElementById('videoModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeVideoModal();
            }
        });

        // Handle page unload - clean up
        window.addEventListener('beforeunload', function() {
            closeVideoModal();
        });
    </script>
</body>
</html>