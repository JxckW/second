<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            background: #0a0a0a; 
            color: #e0e0e0; 
            min-height: 100vh;
        }
        .app { max-width: 1400px; margin: 0 auto; padding: 16px; }
        
        header { 
            margin-bottom: 20px; 
            padding: 16px 0; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            flex-wrap: wrap;
            border-bottom: 1px solid #1a1a1a;
        }
        header h1 { 
            font-size: 24px; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
        }
        .back-link { 
            display: inline-block; 
            color: #667eea; 
            text-decoration: none; 
            font-size: 14px;
            padding: 8px 16px;
            border: 1px solid #667eea;
            border-radius: 8px;
        }
        .back-link:hover { 
            background: #667eea; 
            color: #fff;
        }

        .performer-header {
            background: #1a1a1a;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid #2a2a2a;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }
        .performer-header .name {
            font-size: 28px;
            font-weight: bold;
            color: #fff;
        }
        .performer-header .stats {
            color: #888;
            font-size: 14px;
        }
        .performer-header .stats span {
            margin-left: 16px;
        }

        .mode-switcher {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .mode-btn {
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid #333;
            background: transparent;
            color: #888;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            font-size: 14px;
        }
        .mode-btn:hover {
            border-color: #667eea;
            color: #667eea;
        }
        .mode-btn.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: #667eea;
            color: #fff;
        }

        .controls-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
            padding: 16px;
            background: #1a1a1a;
            border-radius: 12px;
            border: 1px solid #2a2a2a;
            align-items: center;
        }
        .controls-bar .search-input {
            flex: 1;
            min-width: 200px;
            padding: 8px 14px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
        }
        .controls-bar .search-input:focus {
            outline: none;
            border-color: #667eea;
        }
        .controls-bar .search-btn {
            padding: 8px 20px;
            border-radius: 8px;
            border: none;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .controls-bar .search-btn:hover {
            opacity: 0.85;
        }
        .controls-bar .sort-select {
            padding: 8px 14px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
            cursor: pointer;
        }
        .controls-bar .sort-select:focus {
            outline: none;
            border-color: #667eea;
        }
        .controls-bar .clear-btn {
            padding: 8px 16px;
            border-radius: 8px;
            border: 1px solid #ff6b6b;
            background: transparent;
            color: #ff6b6b;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
        }
        .controls-bar .clear-btn:hover {
            background: #ff6b6b;
            color: #fff;
        }

        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }

        .video-card {
            background: #1a1a1a;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2a2a2a;
            transition: transform 0.2s, border-color 0.2s;
            position: relative;
            cursor: pointer;
        }
        .video-card:hover {
            transform: translateY(-4px);
            border-color: #667eea;
        }

        .video-thumbnail {
            position: relative;
            width: 100%;
            padding-top: 56.25%;
            background: #111;
            overflow: hidden;
        }
        .video-thumbnail img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .video-thumbnail .no-image {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 40px;
            opacity: 0.3;
        }
        .video-thumbnail .duration {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(0,0,0,0.8);
            padding: 2px 10px;
            border-radius: 4px;
            font-size: 12px;
            color: #fff;
        }
        .video-thumbnail .play-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            background: rgba(102, 126, 234, 0.9);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: #fff;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .video-card:hover .play-btn {
            opacity: 1;
        }

        .video-info {
            padding: 12px;
        }
        .video-info .title {
            font-size: 14px;
            color: #fff;
            margin-bottom: 4px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.3;
        }
        .video-info .meta {
            font-size: 12px;
            color: #888;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }
        .video-info .studio {
            color: #667eea;
        }
        .video-info .date {
            color: #888;
            font-size: 11px;
        }
        .video-info .performers {
            color: #888;
            font-size: 11px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 100%;
            display: block;
            margin-top: 2px;
        }

        /* Rating Summary on card */
        .rating-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            padding: 6px 12px 10px 12px;
            font-size: 11px;
            color: #888;
            border-top: 1px solid #1a1a1a;
            background: #111;
        }
        .rating-summary .score {
            color: #4caf50;
            font-weight: bold;
        }
        .rating-summary .clips {
            color: #ff9f43;
            font-weight: bold;
        }
        .rating-summary .x-badge {
            color: #ff6b6b;
            font-weight: bold;
        }
        .rating-summary .unrated {
            color: #666;
            font-style: italic;
        }
        .rating-summary .clip-badge {
            background: #1a1a1a;
            padding: 1px 6px;
            border-radius: 4px;
            font-size: 10px;
        }

        .no-videos {
            text-align: center;
            padding: 60px;
            color: #888;
        }
        .no-videos h3 { color: #fff; margin-bottom: 8px; }
        
        .video-stats {
            color: #888;
            font-size: 14px;
            margin-bottom: 16px;
        }

        /* ===== RATING MODAL ===== */
        .rating-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.92);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .rating-modal.active {
            display: flex;
        }
        .rating-modal .modal-content {
            background: #1a1a1a;
            border-radius: 16px;
            max-width: 600px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 24px;
            border: 1px solid #2a2a2a;
            position: relative;
        }
        .rating-modal .close-modal {
            position: absolute;
            top: 12px;
            right: 16px;
            font-size: 28px;
            color: #888;
            cursor: pointer;
            background: none;
            border: none;
            padding: 4px 8px;
            line-height: 1;
            transition: color 0.2s;
        }
        .rating-modal .close-modal:hover {
            color: #fff;
        }
        .rating-modal .modal-title {
            font-size: 18px;
            font-weight: bold;
            color: #fff;
            margin-bottom: 4px;
            padding-right: 30px;
        }
        .rating-modal .modal-subtitle {
            font-size: 13px;
            color: #888;
            margin-bottom: 16px;
        }
        .rating-modal .modal-subtitle .performer-name {
            color: #667eea;
        }
        .rating-modal .modal-subtitle .duration-text {
            color: #ff9f43;
        }

        .rating-categories {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            margin: 12px 0 16px 0;
        }
        .category-row {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #111;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid #2a2a2a;
        }
        .category-row .category-icon {
            font-size: 18px;
            min-width: 30px;
            text-align: center;
        }
        .category-row .category-label {
            font-size: 12px;
            color: #888;
            flex: 1;
        }
        .category-row .clip-input {
            width: 44px;
            padding: 4px 6px;
            border-radius: 6px;
            border: 1px solid #333;
            background: #0a0a0a;
            color: #e0e0e0;
            font-size: 14px;
            text-align: center;
            font-weight: bold;
        }
        .category-row .clip-input:focus {
            outline: none;
            border-color: #667eea;
        }
        .category-row .clip-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
        }
        .category-row .clip-input[type="number"] {
            -moz-appearance: textfield;
        }

        .rating-modal .rating-actions {
            display: flex;
            gap: 10px;
            margin-top: 16px;
            flex-wrap: wrap;
        }
        .rating-modal .btn-rating {
            flex: 1;
            min-width: 120px;
            padding: 10px 20px;
            border-radius: 8px;
            border: none;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: opacity 0.2s;
        }
        .rating-modal .btn-rating:hover {
            opacity: 0.85;
        }
        .rating-modal .btn-x {
            flex: 1;
            min-width: 100px;
            padding: 10px 20px;
            border-radius: 8px;
            border: 2px solid #ff6b6b;
            background: transparent;
            color: #ff6b6b;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s;
        }
        .rating-modal .btn-x:hover {
            background: #ff6b6b;
            color: #fff;
        }
        .rating-modal .btn-x.active {
            background: #ff6b6b;
            color: #fff;
        }
        .rating-modal .btn-close-modal {
            padding: 10px 20px;
            border-radius: 8px;
            border: 1px solid #333;
            background: transparent;
            color: #888;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
        }
        .rating-modal .btn-close-modal:hover {
            border-color: #667eea;
            color: #fff;
        }

        .rating-modal .current-rating-info {
            background: #111;
            border-radius: 8px;
            padding: 10px 14px;
            margin-bottom: 12px;
            border: 1px solid #2a2a2a;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            font-size: 13px;
        }
        .rating-modal .current-rating-info .info-item {
            color: #888;
        }
        .rating-modal .current-rating-info .info-item strong {
            color: #fff;
        }
        .rating-modal .current-rating-info .info-item .score-value {
            color: #4caf50;
        }
        .rating-modal .current-rating-info .info-item .x-value {
            color: #ff6b6b;
        }

        /* ===== VIDEO MODAL ===== */
        .video-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        .video-modal.active {
            display: flex;
        }
        .video-modal .close-modal {
            position: absolute;
            top: 20px;
            right: 30px;
            font-size: 40px;
            color: #fff;
            cursor: pointer;
            z-index: 1001;
            font-family: Arial, sans-serif;
            background: none;
            border: none;
            padding: 10px;
            line-height: 1;
        }
        .video-modal .close-modal:hover {
            color: #667eea;
            transform: scale(1.2);
        }
        .video-modal .video-container {
            width: 90%;
            max-width: 1000px;
            max-height: 90vh;
            position: relative;
        }
        .video-modal video {
            width: 100%;
            max-height: 80vh;
            background: #000;
            border-radius: 8px;
        }
        .video-modal .video-title {
            color: #fff;
            font-size: 18px;
            margin-top: 12px;
            text-align: center;
            max-width: 90%;
        }

        .video-modal .video-controls {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 12px;
            flex-wrap: wrap;
            align-items: center;
        }
        .video-modal .video-controls button {
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid #667eea;
            background: transparent;
            color: #667eea;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 14px;
        }
        .video-modal .video-controls button:hover {
            background: #667eea;
            color: #fff;
        }
        .video-modal .video-controls .download-btn {
            background: #4caf50;
            color: white;
            border-color: #4caf50;
            display: inline-block;
        }
        .video-modal .video-controls .download-btn:hover {
            background: #45a049;
            border-color: #45a049;
        }
        .video-modal .video-controls .quality-selector {
            padding: 8px 14px;
            border-radius: 20px;
            border: 1px solid #333;
            background: #1a1a1a;
            color: #e0e0e0;
            font-size: 13px;
            cursor: pointer;
            outline: none;
        }
        .video-modal .video-controls .quality-selector:focus {
            border-color: #667eea;
        }
        .video-modal .video-controls .quality-selector option {
            background: #1a1a1a;
            color: #e0e0e0;
        }

        .original-link-btn {
            display: inline-block;
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid #ff9f43;
            background: transparent;
            color: #ff9f43;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 14px;
            font-family: inherit;
        }
        .original-link-btn:hover {
            background: #ff9f43;
            color: #fff;
        }

        .video-modal .video-loading {
            color: #888;
            text-align: center;
            padding: 40px;
            font-size: 18px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
        }
        .video-modal .video-error {
            color: #ff6b6b;
            text-align: center;
            padding: 40px;
            font-size: 18px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
        }
        .video-modal .video-error a {
            color: #667eea;
        }

        .pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
            flex-wrap: wrap;
        }
        .page-link {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 8px;
            background: #1a1a1a;
            color: #e0e0e0;
            text-decoration: none;
            border: 1px solid #2a2a2a;
            font-size: 14px;
            transition: background 0.2s;
            cursor: pointer;
        }
        .page-link:hover {
            background: #2a2a2a;
            border-color: #667eea;
        }
        .page-link.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: #667eea;
            color: #fff;
        }

        @media (max-width: 768px) {
            .video-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
            .performer-header .name { font-size: 20px; }
            .performer-header .stats { font-size: 12px; }
            .video-modal .video-container { width: 98%; }
            .video-modal .close-modal { top: 10px; right: 20px; font-size: 30px; }
            .mode-btn { font-size: 12px; padding: 6px 14px; }
            .controls-bar { flex-direction: column; align-items: stretch; }
            .controls-bar .search-input { min-width: auto; }
            .rating-categories { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
<body>
    <div class="app">
        <header>
            <div>
                <a href="/performer/<%= performerId %>" class="back-link">← Back to Profile</a>
                <h1>🎬 Video Mode</h1>
            </div>
            <div>
                <span style="color: #888; font-size: 14px;">
                    <%= totalWowScenes %> videos found
                </span>
            </div>
        </header>

        <div class="performer-header">
            <div>
                <div class="name"><%= performer.name %></div>
                <div class="stats">
                    <span>🎬 <%= totalWowScenes %> scenes</span>
                </div>
            </div>
            <div class="mode-switcher">
                <a href="/performer/<%= performerId %>" class="mode-btn">📋 Profile Mode</a>
                <a href="/performer/<%= performerId %>/videos" class="mode-btn active">🎬 Video Mode</a>
                <a href="/rankings?type=performers" class="mode-btn">🏆 Rankings</a>
            </div>
        </div>

        <!-- Search and Sort Controls -->
        <div class="controls-bar">
            <form method="get" action="" style="display: flex; flex-wrap: wrap; gap: 12px; flex: 1; width: 100%;">
                <input type="text" name="search" class="search-input" placeholder="Search by title, studio, or performer..." value="<%= searchTerm %>">
                <select name="sort" class="sort-select">
                    <option value="date" <%= sortBy === 'date' ? 'selected' : '' %>>Sort by Date</option>
                    <option value="title" <%= sortBy === 'title' ? 'selected' : '' %>>Sort by Title</option>
                    <option value="duration" <%= sortBy === 'duration' ? 'selected' : '' %>>Sort by Duration</option>
                </select>
                <button type="submit" class="search-btn">🔍 Search</button>
                <% if (searchTerm) { %>
                    <a href="/performer/<%= performerId %>/videos?sort=<%= sortBy %>" class="clear-btn">✕ Clear</a>
                <% } %>
            </form>
        </div>

        <% if (wowScenes && wowScenes.length > 0) { %>
            <div class="video-stats">
                Showing <%= (currentPage - 1) * perPage + 1 %> - <%= Math.min(currentPage * perPage, totalWowScenes) %> of <%= totalWowScenes %> videos
                <% if (searchTerm) { %>
                    <span style="color: #667eea;">— Search: "<%= searchTerm %>"</span>
                <% } %>
            </div>

            <div class="video-grid">
                <% wowScenes.forEach(scene => { 
                    // Generate thumbnail
                    let thumbnail = '';
                    let videoId = null;
                    
                    if (scene.video720p) {
                        const match = scene.video720p.match(/\/(\d+)_\d+[pm]\.mp4/);
                        if (match) videoId = match[1];
                    }
                    
                    if (!videoId && scene.video480p) {
                        const match = scene.video480p.match(/\/(\d+)_\d+[pm]\.mp4/);
                        if (match) videoId = match[1];
                    }
                    
                    if (!videoId && scene.url) {
                        const match = scene.url.match(/\/videos\/(\d+)/);
                        if (match) videoId = match[1];
                    }
                    
                    if (videoId) {
                        const prefix = String(videoId).substring(0, 5);
                        thumbnail = `https://img.freesexvideos.xxx/${prefix}000/${videoId}/medium@2x/1.jpg`;
                    }
                    
                    let displayDate = '';
                    if (scene.date) {
                        const parts = scene.date.split('.');
                        if (parts.length === 3) {
                            displayDate = `${parts[1]}/${parts[0]}/${parts[2]}`;
                        }
                    }
                    
                    // Rating data - 8 categories
                    const isX = parseInt(scene.is_x) || 0;
                    const totalClips = parseInt(scene.total_clips) || 0;
                    const score = parseFloat(scene.score) || 0;
                    const introClips = parseInt(scene.intro_clips) || 0;
                    const headClips = parseInt(scene.head_clips) || 0;
                    const doggystyleClips = parseInt(scene.doggystyle_clips) || 0;
                    const cowgirlClips = parseInt(scene.cowgirl_clips) || 0;
                    const reverseCowgirlClips = parseInt(scene.reverse_cowgirl_clips) || 0;
                    const lyingClips = parseInt(scene.lying_clips) || 0;
                    const lyingDoggystyleClips = parseInt(scene.lying_doggystyle_clips) || 0;
                    const outroClips = parseInt(scene.outro_clips) || 0;
                    const durationMinutes = parseInt(scene.duration_minutes) || 0;
                    const hasRating = isX === 1 || totalClips > 0 || score > 0;
                    
                    // ESCAPE FOR JAVASCRIPT
                    const safeTitle = JSON.stringify(scene.title || 'Untitled Scene');
                    const safeSceneUrl = JSON.stringify(scene.url || '');
                    const safeThumbnail = JSON.stringify(thumbnail || '');
                    const safeVideo720p = JSON.stringify(scene.video720p || '');
                    const safeVideo480p = JSON.stringify(scene.video480p || '');
                %>
                <div class="video-card" onclick="openRatingModal(
                    <%= safeSceneUrl %>,
                    <%= safeTitle %>,
                    '<%= scene.duration || '' %>',
                    <%= durationMinutes %>,
                    <%= introClips %>,
                    <%= headClips %>,
                    <%= doggystyleClips %>,
                    <%= cowgirlClips %>,
                    <%= reverseCowgirlClips %>,
                    <%= lyingClips %>,
                    <%= lyingDoggystyleClips %>,
                    <%= outroClips %>,
                    <%= isX %>,
                    <%= totalClips %>,
                    <%= score %>,
                    '<%= scene.performer || performer.name %>'
                )">
                    <div class="video-thumbnail">
                        <% if (thumbnail && thumbnail.startsWith('http')) { %>
                            <img src="<%= thumbnail %>" alt="<%= scene.title %>" loading="lazy">
                        <% } else { %>
                            <div class="no-image">🎬</div>
                        <% } %>
                        <div class="duration"><%= scene.duration || 'N/A' %></div>
                        <div class="play-btn" onclick="event.stopPropagation(); playVideo(<%= safeSceneUrl %>, <%= safeTitle %>, <%= safeThumbnail %>, <%= safeVideo720p %>, <%= safeVideo480p %>)">▶</div>
                    </div>
                    <div class="video-info">
                        <div class="title"><%= scene.title %></div>
                        <div class="meta">
                            <% if (scene.studio) { %>
                                <span class="studio">🏢 <%= scene.studio %></span>
                            <% } %>
                            <% if (displayDate) { %>
                                <span class="date">📅 <%= displayDate %></span>
                            <% } %>
                            <% if (scene.performers && scene.performers.length > 0) { %>
                                <span class="performers">👥 <%= scene.performers %></span>
                            <% } %>
                        </div>
                    </div>
                    <!-- Rating Summary -->
                    <div class="rating-summary">
                        <% if (isX === 1) { %>
                            <span class="x-badge">✕ Marked as X (Skip)</span>
                        <% } else if (hasRating) { %>
                            <span class="score">⭐ <%= score.toFixed(2) %></span>
                            <span class="clips">📊 <%= totalClips %> clips</span>
                            <% if (introClips > 0) { %><span class="clip-badge">💋<%= introClips %></span><% } %>
                            <% if (headClips > 0) { %><span class="clip-badge">👄<%= headClips %></span><% } %>
                            <% if (doggystyleClips > 0) { %><span class="clip-badge">🐕<%= doggystyleClips %></span><% } %>
                            <% if (cowgirlClips > 0) { %><span class="clip-badge">🤠<%= cowgirlClips %></span><% } %>
                            <% if (reverseCowgirlClips > 0) { %><span class="clip-badge">🔄<%= reverseCowgirlClips %></span><% } %>
                            <% if (lyingClips > 0) { %><span class="clip-badge">😴<%= lyingClips %></span><% } %>
                            <% if (lyingDoggystyleClips > 0) { %><span class="clip-badge">🐕😴<%= lyingDoggystyleClips %></span><% } %>
                            <% if (outroClips > 0) { %><span class="clip-badge">👋<%= outroClips %></span><% } %>
                        <% } else { %>
                            <span class="unrated">📝 Click to rate</span>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            </div>

            <% if (totalPages > 1) { %>
                <div class="pagination">
                    <% if (currentPage > 1) { %>
                        <a href="/performer/<%= performerId %>/videos?page=<%= currentPage - 1 %><% if (searchTerm) { %>&search=<%= encodeURIComponent(searchTerm) %><% } %><% if (sortBy !== 'date') { %>&sort=<%= sortBy %><% } %>" class="page-link">← Previous</a>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <% if (i === currentPage) { %>
                            <span class="page-link active"><%= i %></span>
                        <% } else if (i <= 3 || i > totalPages - 3 || Math.abs(i - currentPage) <= 1) { %>
                            <a href="/performer/<%= performerId %>/videos?page=<%= i %><% if (searchTerm) { %>&search=<%= encodeURIComponent(searchTerm) %><% } %><% if (sortBy !== 'date') { %>&sort=<%= sortBy %><% } %>" class="page-link"><%= i %></a>
                        <% } else if (i === 4 && currentPage > 5) { %>
                            <span class="page-link">…</span>
                        <% } else if (i === totalPages - 3 && currentPage < totalPages - 4) { %>
                            <span class="page-link">…</span>
                        <% } %>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <a href="/performer/<%= performerId %>/videos?page=<%= currentPage + 1 %><% if (searchTerm) { %>&search=<%= encodeURIComponent(searchTerm) %><% } %><% if (sortBy !== 'date') { %>&sort=<%= sortBy %><% } %>" class="page-link">Next →</a>
                    <% } %>
                </div>
            <% } %>
        <% } else { %>
            <div class="no-videos">
                <h3>🎬 No Videos Found</h3>
                <p>No videos found for <%= performer.name %><% if (searchTerm) { %> matching "<%= searchTerm %>"<% } %></p>
                <% if (searchTerm) { %>
                    <a href="/performer/<%= performerId %>/videos?sort=<%= sortBy %>" style="color: #667eea; text-decoration: underline;">Clear search</a>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- ===== RATING MODAL ===== -->
    <div class="rating-modal" id="ratingModal">
        <div class="modal-content">
            <button class="close-modal" onclick="closeRatingModal()">✕</button>
            
            <form method="POST" action="/video-rating/save" id="ratingForm">
                <input type="hidden" name="scene_url" id="ratingSceneUrl">
                <input type="hidden" name="is_x" id="ratingIsX" value="0">
                
                <div class="modal-title" id="ratingModalTitle">Rating Video</div>
                <div class="modal-subtitle">
                    <span class="performer-name" id="ratingPerformerName"></span>
                    <span> • </span>
                    <span class="duration-text" id="ratingDurationText"></span>
                </div>
                
                <!-- Current rating info -->
                <div class="current-rating-info" id="currentRatingInfo">
                    <span class="info-item">Status: <strong id="ratingStatusDisplay">Not rated</strong></span>
                    <span class="info-item">Score: <strong class="score-value" id="ratingScoreDisplay">0.00</strong></span>
                    <span class="info-item">Total Clips: <strong id="ratingTotalClipsDisplay">0</strong></span>
                </div>
                
                <div class="rating-categories">
                    <div class="category-row">
                        <span class="category-icon">💋</span>
                        <span class="category-label">Intro</span>
                        <input type="number" name="intro_clips" id="intro_clips" min="0" max="99" value="0" class="clip-input">
                    </div>
                    <div class="category-row">
                        <span class="category-icon">👄</span>
                        <span class="category-label">Head</span>
                        <input type="number" name="head_clips" id="head_clips" min="0" max="99" value="0" class="clip-input">
                    </div>
                    <div class="category-row">
                        <span class="category-icon">🐕</span>
                        <span class="category-label">Doggystyle</span>
                        <input type="number" name="doggystyle_clips" id="doggystyle_clips" min="0" max="99" value="0" class="clip-input">
                    </div>
                    <div class="category-row">
                        <span class="category-icon">🤠</span>
                        <span class="category-label">Cowgirl</span>
                        <input type="number" name="cowgirl_clips" id="cowgirl_clips" min="0" max="99" value="0" class="clip-input">
                    </div>
                    <div class="category-row">
                        <span class="category-icon">🔄</span>
                        <span class="category-label">Reverse Cowgirl</span>
                        <input type="number" name="reverse_cowgirl_clips" id="reverse_cowgirl_clips" min="0" max="99" value="0" class="clip-input">
                    </div>
                    <div class="category-row">
                        <span class="category-icon">😴</span>
                        <span class="category-label">Lying</span>
                        <input type="number" name="lying_clips" id="lying_clips" min="0" max="99" value="0" class="clip-input">
                    </div>
                    <div class="category-row">
                        <span class="category-icon">🐕😴</span>
                        <span class="category-label">Lying Doggystyle</span>
                        <input type="number" name="lying_doggystyle_clips" id="lying_doggystyle_clips" min="0" max="99" value="0" class="clip-input">
                    </div>
                    <div class="category-row">
                        <span class="category-icon">👋</span>
                        <span class="category-label">Outro</span>
                        <input type="number" name="outro_clips" id="outro_clips" min="0" max="99" value="0" class="clip-input">
                    </div>
                </div>
                
                <div class="rating-actions">
                    <button type="submit" class="btn-rating">⭐ Save Rating</button>
                    <button type="button" class="btn-x" id="btnX" onclick="toggleX()">✕ Mark as X</button>
                    <button type="button" class="btn-close-modal" onclick="closeRatingModal()">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ===== VIDEO MODAL ===== -->
    <div class="video-modal" id="videoModal">
        <button class="close-modal" onclick="closeVideoModal()">✕</button>
        <div class="video-container">
            <div id="videoLoading" class="video-loading" style="display: none;">⏳ Loading video...</div>
            <div id="videoError" class="video-error" style="display:none;"></div>
            
            <video id="videoPlayer" width="100%" controls preload="metadata" playsinline>
                <source id="videoSource" src="" type="video/mp4">
                Your browser does not support the video tag.
            </video>
            
            <div id="videoTitle" class="video-title">Video</div>
            
            <div class="video-controls">
                <button onclick="closeVideoModal()">✕ Close</button>
                <button onclick="document.getElementById('videoPlayer').requestFullscreen()">⛶ Fullscreen</button>
                <button onclick="document.getElementById('videoPlayer').play()">▶ Play</button>
                <button onclick="document.getElementById('videoPlayer').pause()">⏸ Pause</button>
                <select id="qualitySelector" class="quality-selector" onchange="changeQuality(this.value)">
                    <option value="720p">720p (HD)</option>
                    <option value="480p">480p (SD)</option>
                </select>
                <button onclick="downloadVideo()" class="download-btn" id="downloadBtn">⬇️ Download</button>
                <a href="#" id="originalSceneLink" target="_blank" class="original-link-btn" rel="noopener noreferrer" style="display: none;">
                    🌐 Original Scene
                </a>
            </div>
        </div>
    </div>

    <script>
        // =========================
        // RATING MODAL
        // =========================
        let currentRatingData = {
            sceneUrl: '',
            title: '',
            duration: '',
            durationMinutes: 0,
            introClips: 0,
            headClips: 0,
            doggystyleClips: 0,
            cowgirlClips: 0,
            reverseCowgirlClips: 0,
            lyingClips: 0,
            lyingDoggystyleClips: 0,
            outroClips: 0,
            isX: 0,
            totalClips: 0,
            score: 0,
            performerName: ''
        };

        function openRatingModal(sceneUrl, title, duration, durationMinutes, 
                                 introClips, headClips, doggystyleClips, cowgirlClips,
                                 reverseCowgirlClips, lyingClips, lyingDoggystyleClips, outroClips,
                                 isX, totalClips, score, performerName) {
            
            currentRatingData = {
                sceneUrl, title, duration, durationMinutes,
                introClips, headClips, doggystyleClips, cowgirlClips,
                reverseCowgirlClips, lyingClips, lyingDoggystyleClips, outroClips,
                isX, totalClips, score, performerName
            };
            
            // Set form values
            document.getElementById('ratingSceneUrl').value = sceneUrl;
            document.getElementById('ratingModalTitle').textContent = 'Rating: ' + title;
            document.getElementById('ratingPerformerName').textContent = performerName || 'Unknown';
            document.getElementById('ratingDurationText').textContent = duration || 'N/A';
            
            document.getElementById('intro_clips').value = introClips || 0;
            document.getElementById('head_clips').value = headClips || 0;
            document.getElementById('doggystyle_clips').value = doggystyleClips || 0;
            document.getElementById('cowgirl_clips').value = cowgirlClips || 0;
            document.getElementById('reverse_cowgirl_clips').value = reverseCowgirlClips || 0;
            document.getElementById('lying_clips').value = lyingClips || 0;
            document.getElementById('lying_doggystyle_clips').value = lyingDoggystyleClips || 0;
            document.getElementById('outro_clips').value = outroClips || 0;
            
            // Update status display
            updateRatingDisplay(isX, totalClips, score);
            
            // Update X button
            const btnX = document.getElementById('btnX');
            if (isX === 1) {
                btnX.classList.add('active');
                btnX.textContent = '✕ X (Active)';
            } else {
                btnX.classList.remove('active');
                btnX.textContent = '✕ Mark as X';
            }
            document.getElementById('ratingIsX').value = isX || 0;
            
            // Show modal
            document.getElementById('ratingModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function updateRatingDisplay(isX, totalClips, score) {
            const statusEl = document.getElementById('ratingStatusDisplay');
            const scoreEl = document.getElementById('ratingScoreDisplay');
            const clipsEl = document.getElementById('ratingTotalClipsDisplay');
            
            if (isX === 1) {
                statusEl.textContent = '✕ X (Skipped)';
                statusEl.style.color = '#ff6b6b';
            } else if (totalClips > 0 || score > 0) {
                statusEl.textContent = '✅ Rated';
                statusEl.style.color = '#4caf50';
            } else {
                statusEl.textContent = '📝 Not rated';
                statusEl.style.color = '#888';
            }
            
            scoreEl.textContent = (score || 0).toFixed(2);
            clipsEl.textContent = totalClips || 0;
        }

        function toggleX() {
            const btnX = document.getElementById('btnX');
            const isXInput = document.getElementById('ratingIsX');
            const currentIsX = parseInt(isXInput.value) || 0;
            
            if (currentIsX === 1) {
                // Unmark X - restore previous values
                isXInput.value = '0';
                btnX.classList.remove('active');
                btnX.textContent = '✕ Mark as X';
                
                // Restore the clip values from currentRatingData
                document.getElementById('intro_clips').value = currentRatingData.introClips || 0;
                document.getElementById('head_clips').value = currentRatingData.headClips || 0;
                document.getElementById('doggystyle_clips').value = currentRatingData.doggystyleClips || 0;
                document.getElementById('cowgirl_clips').value = currentRatingData.cowgirlClips || 0;
                document.getElementById('reverse_cowgirl_clips').value = currentRatingData.reverseCowgirlClips || 0;
                document.getElementById('lying_clips').value = currentRatingData.lyingClips || 0;
                document.getElementById('lying_doggystyle_clips').value = currentRatingData.lyingDoggystyleClips || 0;
                document.getElementById('outro_clips').value = currentRatingData.outroClips || 0;
                
                // Update display
                updateRatingDisplay(0, currentRatingData.totalClips, currentRatingData.score);
            } else {
                // Mark as X - save current values to restore later
                currentRatingData.introClips = parseInt(document.getElementById('intro_clips').value) || 0;
                currentRatingData.headClips = parseInt(document.getElementById('head_clips').value) || 0;
                currentRatingData.doggystyleClips = parseInt(document.getElementById('doggystyle_clips').value) || 0;
                currentRatingData.cowgirlClips = parseInt(document.getElementById('cowgirl_clips').value) || 0;
                currentRatingData.reverseCowgirlClips = parseInt(document.getElementById('reverse_cowgirl_clips').value) || 0;
                currentRatingData.lyingClips = parseInt(document.getElementById('lying_clips').value) || 0;
                currentRatingData.lyingDoggystyleClips = parseInt(document.getElementById('lying_doggystyle_clips').value) || 0;
                currentRatingData.outroClips = parseInt(document.getElementById('outro_clips').value) || 0;
                
                isXInput.value = '1';
                btnX.classList.add('active');
                btnX.textContent = '✕ X (Active)';
                
                // Clear all clip values
                document.getElementById('intro_clips').value = 0;
                document.getElementById('head_clips').value = 0;
                document.getElementById('doggystyle_clips').value = 0;
                document.getElementById('cowgirl_clips').value = 0;
                document.getElementById('reverse_cowgirl_clips').value = 0;
                document.getElementById('lying_clips').value = 0;
                document.getElementById('lying_doggystyle_clips').value = 0;
                document.getElementById('outro_clips').value = 0;
                
                // Update display
                updateRatingDisplay(1, 0, 0);
            }
        }

        function closeRatingModal() {
            document.getElementById('ratingModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        // Close modal on escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeRatingModal();
                closeVideoModal();
            }
        });

        // Close modal on outside click
        document.getElementById('ratingModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeRatingModal();
            }
        });

        // =========================
        // VIDEO PLAYER
        // =========================
        let currentVideoUrl = null;
        let currentSceneUrl = null;
        let currentVideoTitle = '';
        let currentDownloadUrl = null;
        let currentVideo720p = null;
        let currentVideo480p = null;
        let currentQuality = '720p';
        let isLoadingQuality = false;
        let videoLoaded = false;

        async function playVideo(sceneUrl, title, thumbnail, video720p, video480p) {
            console.log('🎬 Playing video:', title);
            
            currentSceneUrl = sceneUrl;
            currentVideoTitle = title;
            currentVideo720p = video720p;
            currentVideo480p = video480p;
            currentQuality = '720p';
            isLoadingQuality = false;
            videoLoaded = false;
            
            const loading = document.getElementById('videoLoading');
            const modal = document.getElementById('videoModal');
            const errorEl = document.getElementById('videoError');
            const video = document.getElementById('videoPlayer');
            const titleEl = document.getElementById('videoTitle');
            const source = document.getElementById('videoSource');
            const downloadBtn = document.getElementById('downloadBtn');
            const qualitySelector = document.getElementById('qualitySelector');
            const originalLink = document.getElementById('originalSceneLink');
            
            downloadBtn.style.display = 'inline-block';
            
            if (originalLink) {
                originalLink.href = sceneUrl;
                originalLink.style.display = 'inline-block';
            }
            
            qualitySelector.value = '720p';
            
            modal.classList.add('active');
            loading.style.display = 'block';
            loading.textContent = '⏳ Loading video...';
            errorEl.style.display = 'none';
            titleEl.textContent = title || 'Video';
            video.pause();
            video.currentTime = 0;
            source.src = '';
            video.load();
            
            try {
                let videoUrl = video720p;
                
                if (!videoUrl || !videoUrl.includes('get_file')) {
                    videoUrl = video480p;
                    if (videoUrl && videoUrl.includes('get_file')) {
                        qualitySelector.value = '480p';
                        currentQuality = '480p';
                    }
                }
                
                if (!videoUrl || !videoUrl.includes('get_file')) {
                    const response = await fetch(`/api/video/url?sceneUrl=${encodeURIComponent(sceneUrl)}`);
                    const data = await response.json();
                    if (data.success && data.videoUrl) {
                        videoUrl = data.videoUrl;
                    } else {
                        throw new Error(data.error || 'Video URL not found');
                    }
                }
                
                console.log('🎬 Video URL:', videoUrl);
                
                currentVideoUrl = videoUrl;
                currentDownloadUrl = videoUrl;
                source.src = videoUrl;
                video.load();
                
                video.oncanplay = function() {
                    console.log('✅ Video can play');
                    videoLoaded = true;
                    loading.style.display = 'none';
                    video.play().catch(e => console.log('Autoplay prevented:', e));
                };
                
                video.onerror = function(e) {
                    console.error('❌ Video error:', e);
                    loading.style.display = 'none';
                    errorEl.style.display = 'block';
                    errorEl.innerHTML = `
                        ❌ Error loading video
                        <br><br>
                        <a href="${videoUrl}" target="_blank" style="color: #667eea; text-decoration: underline;">
                            📥 Try opening directly in new tab
                        </a>
                        <br><br>
                        <span style="font-size: 12px; color: #666;">
                            If the video doesn't play, the link may have expired.
                        </span>
                    `;
                };
                
            } catch (error) {
                console.error('❌ Error:', error.message);
                loading.style.display = 'none';
                errorEl.style.display = 'block';
                errorEl.innerHTML = `
                    ❌ ${error.message}
                    <br><br>
                    <button onclick="closeVideoModal()" style="
                        padding: 8px 20px;
                        border-radius: 8px;
                        border: 1px solid #667eea;
                        background: transparent;
                        color: #667eea;
                        cursor: pointer;
                    ">Close</button>
                `;
            }
        }

        function changeQuality(quality) {
            if (isLoadingQuality) {
                console.log('⚠️ Already switching quality, please wait...');
                return;
            }
            
            console.log('🔄 Switching to:', quality);
            
            const video = document.getElementById('videoPlayer');
            const source = document.getElementById('videoSource');
            const loading = document.getElementById('videoLoading');
            const errorEl = document.getElementById('videoError');
            const downloadBtn = document.getElementById('downloadBtn');
            
            downloadBtn.style.display = 'inline-block';
            
            const currentTime = video.currentTime;
            const wasPlaying = !video.paused;
            
            isLoadingQuality = true;
            loading.style.display = 'block';
            loading.textContent = '⏳ Switching quality...';
            errorEl.style.display = 'none';
            
            let videoUrl = null;
            if (quality === '720p') {
                videoUrl = currentVideo720p;
            } else {
                videoUrl = currentVideo480p;
            }
            
            if (!videoUrl || !videoUrl.includes('get_file')) {
                if (quality === '720p' && currentVideo480p && currentVideo480p.includes('get_file')) {
                    videoUrl = currentVideo480p;
                    document.getElementById('qualitySelector').value = '480p';
                    currentQuality = '480p';
                    console.log('⚠️ 720p not available, switching to 480p');
                } else if (quality === '480p' && currentVideo720p && currentVideo720p.includes('get_file')) {
                    videoUrl = currentVideo720p;
                    document.getElementById('qualitySelector').value = '720p';
                    currentQuality = '720p';
                    console.log('⚠️ 480p not available, switching to 720p');
                } else {
                    loading.style.display = 'none';
                    isLoadingQuality = false;
                    alert('This quality is not available for this video');
                    return;
                }
            }
            
            currentQuality = quality;
            currentVideoUrl = videoUrl;
            currentDownloadUrl = videoUrl;
            
            source.src = videoUrl;
            video.load();
            
            let qualitySwitchDone = false;
            
            const onCanPlay = function() {
                if (!qualitySwitchDone) {
                    qualitySwitchDone = true;
                    console.log('✅ Quality switched to:', quality);
                    loading.style.display = 'none';
                    video.currentTime = currentTime;
                    if (wasPlaying) {
                        video.play().catch(e => console.log('Autoplay prevented:', e));
                    }
                    isLoadingQuality = false;
                    video.removeEventListener('canplay', onCanPlay);
                    video.removeEventListener('error', onError);
                }
            };
            
            const onError = function(e) {
                if (!qualitySwitchDone) {
                    qualitySwitchDone = true;
                    console.error('❌ Error switching quality:', e);
                    loading.style.display = 'none';
                    errorEl.style.display = 'block';
                    errorEl.innerHTML = `
                        ❌ Failed to switch quality
                        <br><br>
                        <span style="font-size: 12px; color: #666;">
                            The video may not be available in this quality.
                        </span>
                        <br><br>
                        <button onclick="closeVideoModal()" style="
                            padding: 8px 20px;
                            border-radius: 8px;
                            border: 1px solid #667eea;
                            background: transparent;
                            color: #667eea;
                            cursor: pointer;
                        ">Close</button>
                    `;
                    isLoadingQuality = false;
                    video.removeEventListener('canplay', onCanPlay);
                    video.removeEventListener('error', onError);
                }
            };
            
            video.addEventListener('canplay', onCanPlay);
            video.addEventListener('error', onError);
        }

        function downloadVideo() {
            if (!currentDownloadUrl) {
                alert('No video URL available');
                return;
            }
            
            let filename = currentVideoTitle || 'video';
            filename = filename.replace(/[^a-zA-Z0-9 ]/g, '').trim();
            filename = filename.replace(/\s+/g, '_') || 'video';
            filename += '.mp4';
            
            let downloadUrl = currentDownloadUrl;
            
            if (downloadUrl && downloadUrl.includes('fpvcdn.com')) {
                downloadUrl = currentQuality === '720p' ? currentVideo720p : currentVideo480p;
            }
            
            if (!downloadUrl || !downloadUrl.includes('get_file')) {
                alert('Download URL not available');
                return;
            }
            
            if (!downloadUrl.includes('download=true')) {
                downloadUrl = downloadUrl + 
                    (downloadUrl.includes('?') ? '&' : '?') + 
                    `download=true&download_filename=${encodeURIComponent(filename)}`;
            }
            
            console.log('⬇️ Downloading:', downloadUrl);
            window.open(downloadUrl, '_blank');
        }

        function closeVideoModal() {
            console.log('🔒 Closing video modal');
            const modal = document.getElementById('videoModal');
            const video = document.getElementById('videoPlayer');
            const source = document.getElementById('videoSource');
            
            isLoadingQuality = false;
            
            video.pause();
            video.currentTime = 0;
            source.src = '';
            video.load();
            modal.classList.remove('active');
            currentVideoUrl = null;
            
            document.getElementById('videoLoading').style.display = 'none';
            document.getElementById('videoLoading').textContent = '⏳ Loading video...';
            document.getElementById('videoError').style.display = 'none';
        }

        document.getElementById('videoModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeVideoModal();
            }
        });

        window.addEventListener('beforeunload', function() {
            closeVideoModal();
        });
    </script>
