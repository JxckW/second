                currentRatingData.headClips = parseInt(document.getElementById('head_clips').value) || 0;
                currentRatingData.doggystyleClips = parseInt(document.getElementById('doggystyle_clips').value) || 0;
                currentRatingData.cowgirlClips = parseInt(document.getElementById('cowgirl_clips').value) || 0;
                currentRatingData.reverseCowgirlClips = parseInt(document.getElementById('reverse_cowgirl_clips').value) || 0;
                currentRatingData.lyingClips = parseInt(document.getElementById('lying_clips').value) || 0;
                currentRatingData.lyingDoggystyleClips = parseInt(document.getElementById('lying_doggystyle_clips').value) || 0;
                currentRatingData.outroClips = parseInt(document.getElementById('outro_clips').value) || 0;
                
                isXInput.value = '1';
                btnX.classList.add('active');
                btnX.textContent = '✕ X (Active)';
                document.getElementById('intro_clips').value = 0;
                document.getElementById('head_clips').value = 0;
                document.getElementById('doggystyle_clips').value = 0;
                document.getElementById('cowgirl_clips').value = 0;
                document.getElementById('reverse_cowgirl_clips').value = 0;
                document.getElementById('lying_clips').value = 0;
                document.getElementById('lying_doggystyle_clips').value = 0;
                document.getElementById('outro_clips').value = 0;
                updateRatingDisplay(1, 0, 0);
            }
        }

        function closeRatingModal() {
            document.getElementById('ratingModal').classList.remove('active');
            document.body.style.overflow = '';
        }

        // =========================
        // RANDOM VIDEO - GET version (for proxy compatibility)
        // =========================
        async function getRandomVideo() {
            const modal = document.getElementById('randomModal');
            const content = document.getElementById('randomContent');
            
            modal.classList.add('active');
            content.innerHTML = '<div class="random-loading">⏳ Finding a random video...</div>';
            
            try {
                const urlParams = new URLSearchParams(window.location.search);
                const q = urlParams.get('q') || '';
                const cupsize = urlParams.get('cupsize') || '';
                const rating = urlParams.get('rating') || '';
                const minScenes = urlParams.get('min_scenes') || 0;
                const minScore = urlParams.get('min_score') || 0;
                const ratingStatus = urlParams.get('rating_status') || 'all';
                const firstVideos = parseInt(urlParams.get('first')) || 0;
                
                // ⭐ Build URL with query parameters (GET request)
                let randomUrl = '/api/random-video?';
                const params = [];
                if (q) params.push(`q=${encodeURIComponent(q)}`);
                if (cupsize) params.push(`cupsize=${encodeURIComponent(cupsize)}`);
                if (rating) params.push(`rating=${encodeURIComponent(rating)}`);
                if (minScenes) params.push(`min_scenes=${encodeURIComponent(minScenes)}`);
                if (minScore) params.push(`min_score=${encodeURIComponent(minScore)}`);
                if (ratingStatus) params.push(`rating_status=${encodeURIComponent(ratingStatus)}`);
                if (firstVideos > 0) params.push(`first=${encodeURIComponent(firstVideos)}`);
                randomUrl += params.join('&');
                
                console.log('🎲 Fetching random video from:', randomUrl);
                
                const response = await fetch(randomUrl);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const contentType = response.headers.get('content-type');
                if (!contentType || !contentType.includes('application/json')) {
                    throw new Error('Server returned HTML instead of JSON. Proxy may be blocking the request.');
                }
                
                const data = await response.json();
                
                if (!data.success || !data.video) {
                    content.innerHTML = `
                        <p style="color: #ff6b6b;">❌ ${data.error || 'No videos found matching your filters'}</p>
                        <div style="margin-top: 12px; text-align: center;">
                            <button onclick="closeRandomModal()" style="padding: 8px 20px; border-radius: 6px; border: 1px solid #333; background: transparent; color: #888; cursor: pointer;">Close</button>
                        </div>
                    `;
                    return;
                }
                
                const video = data.video;
                
                let performerOptions = '';
                if (video.performer_name) {
                    performerOptions = `<option value="${video.performer_name}">${video.performer_name}</option>`;
                }
                
                content.innerHTML = `
                    <!-- Thumbnail -->
                    <div class="video-thumbnail-container">
                        ${video.thumbnail && video.thumbnail.startsWith('http') ? 
                            `<img src="${video.thumbnail}" alt="${video.title}">` : 
                            `<div class="no-image">🎬</div>`
                        }
                        <div class="duration-badge">${video.duration || 'N/A'}</div>
                    </div>
                    
                    <div class="video-title">${video.title || 'Untitled Scene'}</div>
                    <div class="video-meta">
                        ${video.studio ? `🏢 ${video.studio}` : ''}
                        ${video.performer_name ? `<br>👤 ${video.performer_name}` : ''}
                    </div>
                    
                    <form method="POST" action="/video-rating/save" id="randomRatingForm" style="border-top: 1px solid #2a2a2a; padding-top: 12px;">
                        <input type="hidden" name="scene_url" value="${video.url}">
                        <input type="hidden" name="is_x" id="randomRatingIsX" value="0">
                        
                        <div class="performer-selector">
                            <label>👤 Performer:</label>
                            <select name="performer_name" id="randomPerformerSelect">
                                ${performerOptions}
                            </select>
                        </div>
                        
                        <div class="rating-categories">
                            <div class="category-row">
                                <span class="category-icon">💋</span>
                                <span class="category-label">Intro</span>
                                <input type="number" name="intro_clips" min="0" max="99" value="0" class="clip-input">
                            </div>
                            <div class="category-row">
                                <span class="category-icon">👄</span>
                                <span class="category-label">Head</span>
                                <input type="number" name="head_clips" min="0" max="99" value="0" class="clip-input">
                            </div>
                            <div class="category-row">
                                <span class="category-icon">🐕</span>
                                <span class="category-label">Doggystyle</span>
                                <input type="number" name="doggystyle_clips" min="0" max="99" value="0" class="clip-input">
                            </div>
                            <div class="category-row">
                                <span class="category-icon">🤠</span>
                                <span class="category-label">Cowgirl</span>
                                <input type="number" name="cowgirl_clips" min="0" max="99" value="0" class="clip-input">
                            </div>
                            <div class="category-row">
                                <span class="category-icon">🔄</span>
                                <span class="category-label">Reverse Cowgirl</span>
                                <input type="number" name="reverse_cowgirl_clips" min="0" max="99" value="0" class="clip-input">
                            </div>
                            <div class="category-row">
                                <span class="category-icon">😴</span>
                                <span class="category-label">Lying</span>
                                <input type="number" name="lying_clips" min="0" max="99" value="0" class="clip-input">
                            </div>
                            <div class="category-row">
                                <span class="category-icon">🐕😴</span>
                                <span class="category-label">Lying Doggystyle</span>
                                <input type="number" name="lying_doggystyle_clips" min="0" max="99" value="0" class="clip-input">
                            </div>
                            <div class="category-row">
                                <span class="category-icon">👋</span>
                                <span class="category-label">Outro</span>
                                <input type="number" name="outro_clips" min="0" max="99" value="0" class="clip-input">
                            </div>
                        </div>
                        
                        <div class="rating-actions">
                            <button type="submit" class="btn-rating">⭐ Save Rating</button>
                            <button type="button" class="btn-x" id="randomBtnX" onclick="toggleRandomX()">✕ Mark as X</button>
                            <button type="button" class="btn-close-modal" onclick="closeRandomModal()">Close</button>
                        </div>
                    </form>
                    
                    <div class="watch-buttons">
                        <button class="watch-btn play-btn" onclick="closeRandomModal(); playVideo('${video.url}', '${video.title.replace(/'/g, "\\'")}', '${video.thumbnail || ''}', '${video.video720p || ''}', '')">▶ Watch Video</button>
                        <button class="watch-btn original-btn" onclick="window.open('${video.url}', '_blank')">🌐 Original Scene</button>
                    </div>
                `;
                
            } catch (error) {
                console.error('❌ Random video error:', error);
                content.innerHTML = `
                    <p style="color: #ff6b6b;">❌ Error: ${error.message}</p>
                    <p style="color: #888; font-size: 13px; margin-top: 8px;">
                        ${error.message.includes('proxy') || error.message.includes('HTML') ? 
                            'The proxy service may be blocking API requests. Try accessing the site directly.' : 
                            'Please try again or refresh the page.'}
                    </p>
                    <div style="margin-top: 12px; text-align: center;">
                        <button onclick="closeRandomModal()" style="padding: 8px 20px; border-radius: 6px; border: 1px solid #333; background: transparent; color: #888; cursor: pointer;">Close</button>
                    </div>
                `;
            }
        }

        function toggleRandomX() {
            const btnX = document.getElementById('randomBtnX');
            const isXInput = document.getElementById('randomRatingIsX');
            const currentIsX = parseInt(isXInput.value) || 0;
            
            if (currentIsX === 1) {
                isXInput.value = '0';
                btnX.classList.remove('active');
                btnX.textContent = '✕ Mark as X';
                btnX.style.background = 'transparent';
                btnX.style.color = '#ff6b6b';
            } else {
                isXInput.value = '1';
                btnX.classList.add('active');
                btnX.textContent = '✕ X (Active)';
                btnX.style.background = '#ff6b6b';
                btnX.style.color = '#fff';
                document.querySelectorAll('#randomRatingForm .clip-input').forEach(input => {
                    input.value = 0;
                });
            }
        }

        function closeRandomModal() {
            document.getElementById('randomModal').classList.remove('active');
        }

        // =========================
        // VIDEO PLAYER FUNCTIONS
        // =========================
        function getApiBase() {
            const hostname = window.location.hostname;
            const href = window.location.href;
            
            if (hostname === 'localhost' || hostname === '127.0.0.1') {
                return '';
            }
            if (hostname.includes('onrender.com')) {
                return '';
            }
            if (hostname.includes('proxysite') || hostname.includes('proxy') || href.includes('proxysite')) {
                return 'https://second-hmg0.onrender.com';
            }
            return '';
        }

        async function playVideo(sceneUrl, title, thumbnail, video720p, video480p) {
            console.log('🎬 Playing video:', title);
            
            currentSceneUrl = sceneUrl;
            currentVideoTitle = title;
            currentVideo720p = video720p;
            currentVideo480p = video480p;
            currentQuality = '720p';
            isLoadingQuality = false;
            videoLoaded = false;
            
            const loading = document.getElementById('videoLoading');
            const modal = document.getElementById('videoModal');
            const errorEl = document.getElementById('videoError');
            const video = document.getElementById('videoPlayer');
            const titleEl = document.getElementById('videoTitle');
            const source = document.getElementById('videoSource');
            const downloadBtn = document.getElementById('downloadBtn');
            const qualitySelector = document.getElementById('qualitySelector');
            const originalLink = document.getElementById('originalSceneLink');
            
            downloadBtn.style.display = 'inline-block';
            
            if (originalLink) {
                originalLink.href = sceneUrl;
                originalLink.style.display = 'inline-block';
            }
            
            qualitySelector.value = '720p';
            
            modal.classList.add('active');
            loading.style.display = 'block';
            loading.textContent = '⏳ Loading video...';
            errorEl.style.display = 'none';
            titleEl.textContent = title || 'Video';
            video.pause();
            video.currentTime = 0;
            source.src = '';
            video.load();
            
            try {
                let videoUrl = video720p;
                
                if (!videoUrl || !videoUrl.includes('get_file')) {
                    videoUrl = video480p;
                    if (videoUrl && videoUrl.includes('get_file')) {
                        qualitySelector.value = '480p';
                        currentQuality = '480p';
                    }
                }
                
                if (!videoUrl || !videoUrl.includes('get_file')) {
                    if (sceneUrl) {
                        const response = await fetch(`/api/video/url?sceneUrl=${encodeURIComponent(sceneUrl)}`);
                        const data = await response.json();
                        if (data.success && data.videoUrl) {
                            videoUrl = data.videoUrl;
                        } else {
                            throw new Error(data.error || 'Video URL not found');
                        }
                    } else {
                        throw new Error('No video URL or scene URL provided');
                    }
                }
                
                console.log('🎬 Video URL:', videoUrl);
                
                currentVideoUrl = videoUrl;
                currentDownloadUrl = videoUrl;
                source.src = videoUrl;
                video.load();
                
                video.oncanplay = function() {
                    console.log('✅ Video can play');
                    videoLoaded = true;
                    loading.style.display = 'none';
                    video.play().catch(e => console.log('Autoplay prevented:', e));
                };
                
                video.onerror = function(e) {
                    console.error('❌ Video error:', e);
                    loading.style.display = 'none';
                    errorEl.style.display = 'block';
                    errorEl.innerHTML = `
                        ❌ Error loading video
                        <br><br>
                        <a href="${videoUrl}" target="_blank" style="color: #667eea; text-decoration: underline;">
                            📥 Try opening directly in new tab
                        </a>
                        <br><br>
                        <span style="font-size: 12px; color: #666;">
                            If the video doesn't play, the link may have expired.
                        </span>
                    `;
                };
                
            } catch (error) {
                console.error('❌ Error:', error.message);
                loading.style.display = 'none';
                errorEl.style.display = 'block';
                errorEl.innerHTML = `
                    ❌ ${error.message}
                    <br><br>
                    <button onclick="closeVideoModal()" style="
                        padding: 8px 20px;
                        border-radius: 8px;
                        border: 1px solid #667eea;
                        background: transparent;
                        color: #667eea;
                        cursor: pointer;
                    ">Close</button>
                `;
            }
        }

        function changeQuality(quality) {
            if (isLoadingQuality) {
                console.log('⚠️ Already switching quality, please wait...');
                return;
            }
            
            console.log('🔄 Switching to:', quality);
            
            const video = document.getElementById('videoPlayer');
            const source = document.getElementById('videoSource');
            const loading = document.getElementById('videoLoading');
            const errorEl = document.getElementById('videoError');
            const downloadBtn = document.getElementById('downloadBtn');
            
            downloadBtn.style.display = 'inline-block';
            
            const currentTime = video.currentTime;
            const wasPlaying = !video.paused;
            
            isLoadingQuality = true;
            loading.style.display = 'block';
            loading.textContent = '⏳ Switching quality...';
            errorEl.style.display = 'none';
            
            let videoUrl = null;
            if (quality === '720p') {
                videoUrl = currentVideo720p;
            } else {
                videoUrl = currentVideo480p;
            }
            
            if (!videoUrl || !videoUrl.includes('get_file')) {
                if (quality === '720p' && currentVideo480p && currentVideo480p.includes('get_file')) {
                    videoUrl = currentVideo480p;
                    document.getElementById('qualitySelector').value = '480p';
                    currentQuality = '480p';
                    console.log('⚠️ 720p not available, switching to 480p');
                } else if (quality === '480p' && currentVideo720p && currentVideo720p.includes('get_file')) {
                    videoUrl = currentVideo720p;
                    document.getElementById('qualitySelector').value = '720p';
                    currentQuality = '720p';
                    console.log('⚠️ 480p not available, switching to 720p');
                } else {
                    loading.style.display = 'none';
                    isLoadingQuality = false;
                    alert('This quality is not available for this video');
                    return;
                }
            }
            
            currentQuality = quality;
            currentVideoUrl = videoUrl;
            currentDownloadUrl = videoUrl;
            
            source.src = videoUrl;
            video.load();
            
            let qualitySwitchDone = false;
            
            const onCanPlay = function() {
                if (!qualitySwitchDone) {
                    qualitySwitchDone = true;
                    console.log('✅ Quality switched to:', quality);
                    loading.style.display = 'none';
                    video.currentTime = currentTime;
                    if (wasPlaying) {
                        video.play().catch(e => console.log('Autoplay prevented:', e));
                    }
                    isLoadingQuality = false;
                    video.removeEventListener('canplay', onCanPlay);
                    video.removeEventListener('error', onError);
                }
            };
            
            const onError = function(e) {
                if (!qualitySwitchDone) {
                    qualitySwitchDone = true;
                    console.error('❌ Error switching quality:', e);
                    loading.style.display = 'none';
                    errorEl.style.display = 'block';
                    errorEl.innerHTML = `
                        ❌ Failed to switch quality
                        <br><br>
                        <span style="font-size: 12px; color: #666;">
                            The video may not be available in this quality.
                        </span>
                        <br><br>
                        <button onclick="closeVideoModal()" style="
                            padding: 8px 20px;
                            border-radius: 8px;
                            border: 1px solid #667eea;
                            background: transparent;
                            color: #667eea;
                            cursor: pointer;
                        ">Close</button>
                    `;
                    isLoadingQuality = false;
                    video.removeEventListener('canplay', onCanPlay);
                    video.removeEventListener('error', onError);
                }
            };
            
            video.addEventListener('canplay', onCanPlay);
            video.addEventListener('error', onError);
        }

        function downloadVideo() {
            if (!currentDownloadUrl) {
                alert('No video URL available');
                return;
            }
            
            let filename = currentVideoTitle || 'video';
            filename = filename.replace(/[^a-zA-Z0-9 ]/g, '').trim();
            filename = filename.replace(/\s+/g, '_') || 'video';
            filename += '.mp4';
            
            let downloadUrl = currentDownloadUrl;
            
            if (downloadUrl && downloadUrl.includes('fpvcdn.com')) {
                downloadUrl = currentQuality === '720p' ? currentVideo720p : currentVideo480p;
            }
            
            if (!downloadUrl || !downloadUrl.includes('get_file')) {
                alert('Download URL not available');
                return;
            }
            
            if (!downloadUrl.includes('download=true')) {
                downloadUrl = downloadUrl + 
                    (downloadUrl.includes('?') ? '&' : '?') + 
                    `download=true&download_filename=${encodeURIComponent(filename)}`;
            }
            
            console.log('⬇️ Downloading:', downloadUrl);
            window.open(downloadUrl, '_blank');
        }

        function closeVideoModal() {
            console.log('🔒 Closing video modal');
            const modal = document.getElementById('videoModal');
            const video = document.getElementById('videoPlayer');
            const source = document.getElementById('videoSource');
            
            isLoadingQuality = false;
            
            video.pause();
            video.currentTime = 0;
            source.src = '';
            video.load();
            modal.classList.remove('active');
            currentVideoUrl = null;
            
            document.getElementById('videoLoading').style.display = 'none';
            document.getElementById('videoLoading').textContent = '⏳ Loading video...';
            document.getElementById('videoError').style.display = 'none';
        }

        document.getElementById('videoModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeVideoModal();
            }
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeVideoModal();
                closeRatingModal();
                closeRandomModal();
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            
            const cupsizeSelect = document.getElementById('cupsizeFilter');
            if (cupsizeSelect && urlParams.get('cupsize')) {
                cupsizeSelect.value = urlParams.get('cupsize');
            }
            
            const ratingSelect = document.getElementById('ratingFilter');
            if (ratingSelect && urlParams.get('rating')) {
                ratingSelect.value = urlParams.get('rating');
            }
            
            const minScenesInput = document.getElementById('minScenesFilter');
            if (minScenesInput && urlParams.get('min_scenes')) {
                minScenesInput.value = urlParams.get('min_scenes');
            }
            
            const minScoreInput = document.getElementById('minScoreFilter');
            if (minScoreInput && urlParams.get('min_score')) {
                minScoreInput.value = urlParams.get('min_score');
            }
            
            const ratingStatusSelect = document.getElementById('ratingStatusFilter');
            if (ratingStatusSelect && urlParams.get('rating_status')) {
                ratingStatusSelect.value = urlParams.get('rating_status');
            }
            
            const autoSortCheckbox = document.getElementById('autoSortRated');
            if (autoSortCheckbox && urlParams.get('auto_sort_rated') === 'true') {
                autoSortCheckbox.checked = true;
            }
            
            const firstVideosInput = document.querySelector('input[name="first"]');
            if (firstVideosInput && urlParams.get('first')) {
                firstVideosInput.value = urlParams.get('first');
            }
        });
    </script>
