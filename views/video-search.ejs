<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            background: #0a0a0a; 
            color: #e0e0e0; 
            min-height: 100vh;
        }
        .container { max-width: 1400px; margin: 0 auto; padding: 16px; }
        
        header { 
            margin-bottom: 20px; 
            padding: 16px 0; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            flex-wrap: wrap;
            border-bottom: 1px solid #1a1a1a;
        }
        header h1 { 
            font-size: 24px; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
        }
        .back-link { 
            display: inline-block; 
            color: #667eea; 
            text-decoration: none; 
            font-size: 14px;
            padding: 8px 16px;
            border: 1px solid #667eea;
            border-radius: 8px;
        }
        .back-link:hover { 
            background: #667eea; 
            color: #fff;
        }

        .search-section {
            background: #1a1a1a;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid #2a2a2a;
        }
        .search-row {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 12px;
        }
        .search-row label {
            color: #888;
            font-size: 14px;
            min-width: 80px;
        }
        .search-row input[type="text"] {
            flex: 1;
            min-width: 200px;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
        }
        .search-row input[type="text"]:focus {
            outline: none;
            border-color: #667eea;
        }
        .search-row .hint {
            color: #666;
            font-size: 12px;
            width: 100%;
        }
        .search-btn {
            padding: 10px 28px;
            border-radius: 8px;
            border: none;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .search-btn:hover { opacity: 0.85; }

        .controls-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
            padding: 16px;
            background: #1a1a1a;
            border-radius: 12px;
            border: 1px solid #2a2a2a;
            align-items: center;
        }
        .controls-bar .sort-select {
            padding: 8px 14px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
            cursor: pointer;
            outline: none;
        }
        .controls-bar .sort-select:focus {
            border-color: #667eea;
        }
        .controls-bar .filter-checkbox {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #888;
            font-size: 14px;
            cursor: pointer;
        }
        .controls-bar .filter-checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #667eea;
        }
        .controls-bar .results-count {
            color: #888;
            font-size: 14px;
            margin-left: auto;
        }

        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }

        .video-card {
            background: #1a1a1a;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2a2a2a;
            transition: transform 0.2s, border-color 0.2s;
            cursor: pointer;
            position: relative;
        }
        .video-card:hover {
            transform: translateY(-4px);
            border-color: #667eea;
        }
        
        .video-card .favorite-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 10;
            background: rgba(0,0,0,0.7);
            border: none;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            font-size: 18px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #666;
            pointer-events: auto;
        }
        .video-card .favorite-btn:hover {
            transform: scale(1.15);
        }
        .video-card .favorite-btn.favorited {
            color: #ff6b6b;
        }
        .video-card .favorite-btn.favorited:hover {
            color: #ff4444;
        }

        .video-thumbnail {
            position: relative;
            width: 100%;
            padding-top: 56.25%;
            background: #111;
            overflow: hidden;
        }
        .video-thumbnail img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .video-thumbnail .no-image {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 40px;
            opacity: 0.3;
        }
        .video-thumbnail .duration {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(0,0,0,0.8);
            padding: 2px 10px;
            border-radius: 4px;
            font-size: 12px;
            color: #fff;
        }
        .video-thumbnail .play-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            background: rgba(102, 126, 234, 0.9);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: #fff;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .video-card:hover .play-btn { opacity: 1; }
        .video-info { padding: 12px; }
        .video-info .title {
            font-size: 14px;
            color: #fff;
            margin-bottom: 4px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.3;
        }
        .video-info .meta {
            font-size: 12px;
            color: #888;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }
        .video-info .studio { color: #667eea; }
        .video-info .date { color: #888; font-size: 11px; }
        .video-info .performers {
            color: #888;
            font-size: 11px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 100%;
            display: block;
            margin-top: 2px;
        }

        .no-results {
            text-align: center;
            padding: 60px;
            color: #888;
        }
        .no-results h3 { color: #fff; margin-bottom: 8px; }

        .pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
            flex-wrap: wrap;
        }
        .page-link {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 8px;
            background: #1a1a1a;
            color: #e0e0e0;
            text-decoration: none;
            border: 1px solid #2a2a2a;
            font-size: 14px;
            transition: background 0.2s;
            cursor: pointer;
        }
        .page-link:hover {
            background: #2a2a2a;
            border-color: #667eea;
        }
        .page-link.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: #667eea;
            color: #fff;
        }

        /* ⭐ NEW: Original Scene Link Button */
        .original-link-btn {
            display: inline-block;
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid #ff9f43;
            background: transparent;
            color: #ff9f43;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 14px;
            font-family: inherit;
        }
        .original-link-btn:hover {
            background: #ff9f43;
            color: #fff;
        }

        .video-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        .video-modal.active { display: flex; }
        .video-modal .close-modal {
            position: absolute;
            top: 20px;
            right: 30px;
            font-size: 40px;
            color: #fff;
            cursor: pointer;
            z-index: 1001;
            background: none;
            border: none;
            padding: 10px;
            line-height: 1;
        }
        .video-modal .close-modal:hover { color: #667eea; transform: scale(1.2); }
        .video-modal .video-container {
            width: 90%;
            max-width: 1000px;
            max-height: 90vh;
            position: relative;
        }
        .video-modal video {
            width: 100%;
            max-height: 80vh;
            background: #000;
            border-radius: 8px;
        }
        .video-modal .video-title {
            color: #fff;
            font-size: 18px;
            margin-top: 12px;
            text-align: center;
            max-width: 90%;
        }
        .video-modal .video-controls {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 12px;
            flex-wrap: wrap;
        }
        .video-modal .video-controls button {
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid #667eea;
            background: transparent;
            color: #667eea;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 14px;
        }
        .video-modal .video-controls button:hover {
            background: #667eea;
            color: #fff;
        }
        .video-modal .video-controls .download-btn {
            background: #4caf50;
            color: white;
            border-color: #4caf50;
        }
        .video-modal .video-controls .download-btn:hover {
            background: #45a049;
            border-color: #45a049;
        }
        .video-modal .video-controls .quality-selector {
            padding: 8px 14px;
            border-radius: 20px;
            border: 1px solid #333;
            background: #1a1a1a;
            color: #e0e0e0;
            font-size: 13px;
            cursor: pointer;
            outline: none;
        }
        .video-modal .video-controls .quality-selector:focus {
            border-color: #667eea;
        }
        .video-modal .video-loading {
            color: #888;
            text-align: center;
            padding: 40px;
            font-size: 18px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
        }
        .video-modal .video-error {
            color: #ff6b6b;
            text-align: center;
            padding: 40px;
            font-size: 18px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
        }

        @media (max-width: 768px) {
            .video-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
            .search-row { flex-direction: column; align-items: stretch; }
            .search-row label { min-width: auto; }
            .search-row input[type="text"] { min-width: auto; }
            .video-modal .video-container { width: 98%; }
            .video-modal .close-modal { top: 10px; right: 20px; font-size: 30px; }
            .controls-bar { flex-direction: column; align-items: stretch; }
            .controls-bar .results-count { margin-left: 0; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <div>
                <a href="/" class="back-link">← Back to Home</a>
                <h1>🎬 Global Video Search</h1>
            </div>
        </header>

        <div class="search-section">
            <div class="search-row">
                <label>🔍 Search</label>
                <input type="text" id="searchInput" placeholder="Search by studio or performer..." value="<%= searchTerm || '' %>">
            </div>
            <div class="search-row">
                <div class="hint">
                    💡 Separate terms with commas: <strong>Studio X, Performer A, Performer B</strong>
                    <br>Examples: 
                    <span style="color: #667eea; cursor: pointer;" onclick="setSearch('Brazzers, Mia Malkova')">Brazzers, Mia Malkova</span> | 
                    <span style="color: #667eea; cursor: pointer;" onclick="setSearch('Riley Reid, Abella Danger')">Riley Reid, Abella Danger</span> | 
                    <span style="color: #667eea; cursor: pointer;" onclick="setSearch('BLACKED, Chloe Temple')">BLACKED, Chloe Temple</span>
                </div>
            </div>
            <button class="search-btn" onclick="performSearch()">🔍 Search Videos</button>
        </div>

        <div id="resultsContainer">
            <% if (!searchTerm) { %>
                <div class="no-results">
                    <h3>🔍 Search for Videos</h3>
                    <p>Search by studio or performer to find scenes</p>
                    <p style="margin-top: 8px; font-size: 13px; color: #666;">
                        💡 Try: <span style="color: #667eea; cursor: pointer;" onclick="setSearch('Brazzers')">Brazzers</span> or 
                        <span style="color: #667eea; cursor: pointer;" onclick="setSearch('Riley Reid')">Riley Reid</span> or 
                        <span style="color: #667eea; cursor: pointer;" onclick="setSearch('BLACKED, Chloe Temple')">BLACKED, Chloe Temple</span>
                    </p>
                </div>
            <% } else { %>
                <div id="searchResults"></div>
            <% } %>
        </div>
    </div>

    <!-- Video Player Modal -->
    <div class="video-modal" id="videoModal">
        <button class="close-modal" onclick="closeVideoModal()">✕</button>
        <div class="video-container">
            <div id="videoLoading" class="video-loading">⏳ Loading video...</div>
            <div id="videoError" class="video-error" style="display:none;"></div>
            
            <video id="videoPlayer" width="100%" controls preload="metadata" playsinline>
                <source id="videoSource" src="" type="video/mp4">
                Your browser does not support the video tag.
            </video>
            
            <div id="videoTitle" class="video-title">Video</div>
            
            <!-- ⭐ UPDATED: Video Controls with Original Scene Link -->
            <div class="video-controls">
                <button onclick="closeVideoModal()">✕ Close</button>
                <button onclick="document.getElementById('videoPlayer').requestFullscreen()">⛶ Fullscreen</button>
                <button onclick="document.getElementById('videoPlayer').play()">▶ Play</button>
                <button onclick="document.getElementById('videoPlayer').pause()">⏸ Pause</button>
                <select id="qualitySelector" class="quality-selector" onchange="changeQuality(this.value)">
                    <option value="720p">720p (HD)</option>
                    <option value="480p">480p (SD)</option>
                </select>
                <button onclick="downloadVideo()" class="download-btn" id="downloadBtn">⬇️ Download</button>
                <!-- ⭐ NEW: Original Scene Link -->
                <a href="#" id="originalSceneLink" target="_blank" class="original-link-btn" rel="noopener noreferrer" style="display: none;">
                    🌐 Original Scene
                </a>
            </div>
        </div>
    </div>

    <script>
        // =========================
        // GLOBAL VARIABLES
        // =========================
        let currentVideoUrl = null;
        let currentSceneUrl = null;
        let currentVideoTitle = '';
        let currentDownloadUrl = null;
        let currentVideo720p = null;
        let currentVideo480p = null;
        let currentQuality = '720p';
        let isLoadingQuality = false;
        let videoLoaded = false;
        let currentPage = 1;
        let currentSearchTerm = '<%= searchTerm || "" %>';
        let currentSort = 'date';
        let cachedVideos = []; // Store ALL raw video data
        let favoriteUrls = new Set(); // Store favorited scene URLs
        const perPage = 24;
        let showFavoritesOnly = false;

        // =========================
        // FAVORITE FUNCTIONS
        // =========================
        async function loadFavorites() {
            try {
                const response = await fetch('/api/video-favorites/urls');
                const data = await response.json();
                if (data.success) {
                    favoriteUrls = new Set(data.urls);
                    console.log('✅ Loaded', favoriteUrls.size, 'favorites');
                }
            } catch (error) {
                console.error('❌ Error loading favorites:', error);
            }
        }

        async function toggleFavorite(sceneUrl, button) {
            // Find the video data from cachedVideos
            const video = cachedVideos.find(v => v.url === sceneUrl);
            if (!video) {
                console.error('Video not found in cache:', sceneUrl);
                return;
            }

            try {
                const response = await fetch('/api/video-favorites/toggle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        scene_url: video.url,
                        title: video.title,
                        thumbnail: video.thumbnail,
                        video720p: video.video720p,
                        video480p: video.video480p,
                        studio: video.studio,
                        performers: video.performers,
                        duration: video.duration,
                        date: video.date
                    })
                });
                const data = await response.json();
                
                if (data.success) {
                    if (data.favorited) {
                        favoriteUrls.add(sceneUrl);
                        button.classList.add('favorited');
                        button.textContent = '❤️';
                    } else {
                        favoriteUrls.delete(sceneUrl);
                        button.classList.remove('favorited');
                        button.textContent = '🤍';
                    }
                    
                    // If showing favorites only, re-render
                    if (showFavoritesOnly) {
                        renderResultsWithPagination(cachedVideos, currentSort, currentPage);
                    }
                }
            } catch (error) {
                console.error('❌ Error toggling favorite:', error);
            }
        }

        function isFavorited(sceneUrl) {
            return favoriteUrls.has(sceneUrl);
        }

        // =========================
        // CLICK HANDLER FOR VIDEO CARDS
        // =========================
        document.addEventListener('DOMContentLoaded', function() {
            // Load favorites on page load
            loadFavorites();
            
            // Use event delegation for all clicks in results container
            document.getElementById('resultsContainer').addEventListener('click', function(e) {
                // Check if favorite button was clicked
                const favBtn = e.target.closest('.favorite-btn');
                if (favBtn) {
                    e.preventDefault();
                    e.stopPropagation();
                    const card = favBtn.closest('.video-card');
                    if (card) {
                        const sceneUrl = card.dataset.sceneUrl;
                        console.log('❤️ Favorite button clicked for:', sceneUrl);
                        toggleFavorite(sceneUrl, favBtn);
                    }
                    return;
                }
                
                // Otherwise handle video card click
                const card = e.target.closest('.video-card');
                if (card) {
                    const sceneUrl = card.dataset.sceneUrl;
                    const title = card.dataset.title;
                    const thumbnail = card.dataset.thumbnail;
                    const video720p = card.dataset.video720p;
                    const video480p = card.dataset.video480p;
                    playVideo(sceneUrl, title, thumbnail, video720p, video480p);
                }
            });

            // Auto-search if there's a search term
            if (currentSearchTerm) {
                performSearch();
            }
        });

        function setSearch(term) {
            document.getElementById('searchInput').value = term;
            performSearch();
        }

        // =========================
        // SEARCH FUNCTION
        // =========================
        async function performSearch(page = 1) {
            const searchTerm = document.getElementById('searchInput').value.trim();
            
            if (!searchTerm) {
                document.getElementById('resultsContainer').innerHTML = `
                    <div class="no-results">
                        <h3>🔍 Enter a Search</h3>
                        <p>Search by studio or performer to find scenes</p>
                    </div>
                `;
                return;
            }

            currentSearchTerm = searchTerm;
            currentPage = page;

            document.getElementById('resultsContainer').innerHTML = `
                <div class="loading" style="text-align: center; padding: 40px; color: #888;">
                    <div style="display: inline-block; width: 30px; height: 30px; border: 3px solid #333; border-top-color: #667eea; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
                    <p style="margin-top: 12px;">Searching for "${searchTerm}"...</p>
                </div>
                <style>
                    @keyframes spin {
                        to { transform: rotate(360deg); }
                    }
                </style>
            `;

            try {
                const response = await fetch(`/api/search/videos?q=${encodeURIComponent(searchTerm)}&page=1&perPage=10000`);
                const data = await response.json();

                if (!data.success) {
                    throw new Error(data.error || 'Search failed');
                }

                if (data.videos.length === 0) {
                    document.getElementById('resultsContainer').innerHTML = `
                        <div class="no-results">
                            <h3>🔍 No Results Found</h3>
                            <p>No videos found for "${searchTerm}"</p>
                        </div>
                    `;
                    return;
                }

                // Store ALL videos
                cachedVideos = data.allVideos || data.videos;
                
                // Reload favorites to ensure we have latest
                await loadFavorites();
                
                // Render with pagination
                renderResultsWithPagination(cachedVideos, currentSort, currentPage);

            } catch (error) {
                console.error('Search error:', error);
                document.getElementById('resultsContainer').innerHTML = `
                    <div class="no-results">
                        <h3>❌ Error</h3>
                        <p>${error.message}</p>
                    </div>
                `;
            }
        }

        // =========================
        // SORTING FUNCTIONS
        // =========================
        function getSortedVideos(videos, sortBy) {
            const sorted = [...videos];
            
            if (sortBy === 'date') {
                sorted.sort((a, b) => {
                    const dateA = a.date ? a.date.split('.').reverse().join('-') : '1970-01-01';
                    const dateB = b.date ? b.date.split('.').reverse().join('-') : '1970-01-01';
                    return dateB.localeCompare(dateA);
                });
            } else if (sortBy === 'title') {
                sorted.sort((a, b) => {
                    return (a.title || '').localeCompare(b.title || '');
                });
            } else if (sortBy === 'duration') {
                sorted.sort((a, b) => {
                    const durA = a.duration ? a.duration.split(':').reduce((acc, time) => (acc * 60) + parseInt(time), 0) : 0;
                    const durB = b.duration ? b.duration.split(':').reduce((acc, time) => (acc * 60) + parseInt(time), 0) : 0;
                    return durB - durA;
                });
            }
            
            return sorted;
        }

        // =========================
        // RENDER RESULTS WITH PAGINATION
        // =========================
        function renderResultsWithPagination(videos, sortBy, page) {
            // Filter by favorites if enabled
            let filteredVideos = videos;
            if (showFavoritesOnly) {
                filteredVideos = videos.filter(v => favoriteUrls.has(v.url));
            }
            
            const total = filteredVideos.length;
            const totalPages = Math.ceil(total / perPage);
            
            // Sort ALL videos first
            const sortedVideos = getSortedVideos(filteredVideos, sortBy);
            
            // Then paginate
            const startIndex = (page - 1) * perPage;
            const endIndex = Math.min(startIndex + perPage, total);
            const pageVideos = sortedVideos.slice(startIndex, endIndex);

            let html = `
                <div class="controls-bar">
                    <select id="sortSelect" class="sort-select" onchange="changeSort(this.value)">
                        <option value="date" ${sortBy === 'date' ? 'selected' : ''}>Sort by Date</option>
                        <option value="title" ${sortBy === 'title' ? 'selected' : ''}>Sort by Title</option>
                        <option value="duration" ${sortBy === 'duration' ? 'selected' : ''}>Sort by Duration</option>
                    </select>
                    <label class="filter-checkbox">
                        <input type="checkbox" id="favoritesFilter" onchange="toggleFavoritesFilter()" ${showFavoritesOnly ? 'checked' : ''}>
                        ⭐ Favorites Only
                    </label>
                    <span class="results-count">${total} videos found for "${currentSearchTerm}"</span>
                </div>
                <div class="video-grid">
            `;

            for (const video of pageVideos) {
                const titleEncoded = (video.title || 'Untitled Scene').replace(/"/g, '&quot;');
                const sceneUrlEncoded = (video.url || '').replace(/"/g, '&quot;');
                const thumbnailEncoded = (video.thumbnail || '').replace(/"/g, '&quot;');
                const video720pEncoded = (video.video720p || '').replace(/"/g, '&quot;');
                const video480pEncoded = (video.video480p || '').replace(/"/g, '&quot;');
                const isFav = isFavorited(video.url);
                
                let displayDate = '';
                if (video.date) {
                    const parts = video.date.split('.');
                    if (parts.length === 3) {
                        displayDate = `${parts[1]}/${parts[0]}/${parts[2]}`;
                    }
                }

                html += `
                    <div class="video-card" 
                         data-scene-url="${sceneUrlEncoded}"
                         data-title="${titleEncoded}"
                         data-thumbnail="${thumbnailEncoded}"
                         data-video720p="${video720pEncoded}"
                         data-video480p="${video480pEncoded}">
                        <button class="favorite-btn ${isFav ? 'favorited' : ''}" onclick="event.stopPropagation(); handleFavoriteClick(this, '${sceneUrlEncoded}')">
                            ${isFav ? '❤️' : '🤍'}
                        </button>
                        <div class="video-thumbnail">
                            ${video.thumbnail ? `<img src="${video.thumbnail}" alt="${video.title}" loading="lazy">` : '<div class="no-image">🎬</div>'}
                            <div class="duration">${video.duration || 'N/A'}</div>
                            <div class="play-btn">▶</div>
                        </div>
                        <div class="video-info">
                            <div class="title">${video.title}</div>
                            <div class="meta">
                                ${video.studio ? `<span class="studio">🏢 ${video.studio}</span>` : ''}
                                ${displayDate ? `<span class="date">📅 ${displayDate}</span>` : ''}
                                ${video.performers ? `<span class="performers">👥 ${video.performers}</span>` : ''}
                            </div>
                        </div>
                    </div>
                `;
            }

            html += `</div>`;

            if (totalPages > 1) {
                html += `<div class="pagination">`;
                if (page > 1) {
                    html += `<button class="page-link" onclick="goToPage(${page - 1})">← Previous</button>`;
                }
                for (let i = 1; i <= totalPages; i++) {
                    if (i === page) {
                        html += `<span class="page-link active">${i}</span>`;
                    } else if (i <= 3 || i > totalPages - 3 || Math.abs(i - page) <= 1) {
                        html += `<button class="page-link" onclick="goToPage(${i})">${i}</button>`;
                    } else if (i === 4 && page > 5) {
                        html += `<span class="page-link">…</span>`;
                    } else if (i === totalPages - 3 && page < totalPages - 4) {
                        html += `<span class="page-link">…</span>`;
                    }
                }
                if (page < totalPages) {
                    html += `<button class="page-link" onclick="goToPage(${page + 1})">Next →</button>`;
                }
                html += `</div>`;
            }

            document.getElementById('resultsContainer').innerHTML = html;
        }

        // ⭐ NEW: Standalone function for favorite button clicks
        function handleFavoriteClick(button, sceneUrl) {
            event.preventDefault();
            event.stopPropagation();
            console.log('❤️ Favorite button clicked for:', sceneUrl);
            toggleFavorite(sceneUrl, button);
        }

        // =========================
        // NAVIGATION FUNCTIONS
        // =========================
        function goToPage(page) {
            currentPage = page;
            renderResultsWithPagination(cachedVideos, currentSort, page);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function changeSort(sortBy) {
            console.log('🔄 Changing sort to:', sortBy);
            currentSort = sortBy;
            currentPage = 1;
            
            if (cachedVideos.length === 0) {
                console.log('⚠️ No cached videos to sort');
                return;
            }
            
            renderResultsWithPagination(cachedVideos, sortBy, 1);
        }

        function toggleFavoritesFilter() {
            const checkbox = document.getElementById('favoritesFilter');
            showFavoritesOnly = checkbox.checked;
            currentPage = 1;
            
            if (cachedVideos.length === 0) {
                return;
            }
            
            renderResultsWithPagination(cachedVideos, currentSort, 1);
        }

        // Enter key support
        document.getElementById('searchInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });

        // =========================
        // VIDEO PLAYER FUNCTIONS
        // =========================
        async function playVideo(sceneUrl, title, thumbnail, video720p, video480p) {
            console.log('🎬 playVideo called!');
            
            if (!sceneUrl && !video720p && !video480p) {
                console.error('❌ No video URL provided');
                alert('Video URL not available');
                return;
            }
            
            currentSceneUrl = sceneUrl;
            currentVideoTitle = title;
            currentVideo720p = video720p;
            currentVideo480p = video480p;
            currentQuality = '720p';
            isLoadingQuality = false;
            videoLoaded = false;
            
            const loading = document.getElementById('videoLoading');
            const modal = document.getElementById('videoModal');
            const errorEl = document.getElementById('videoError');
            const video = document.getElementById('videoPlayer');
            const titleEl = document.getElementById('videoTitle');
            const source = document.getElementById('videoSource');
            const downloadBtn = document.getElementById('downloadBtn');
            const qualitySelector = document.getElementById('qualitySelector');
            const originalLink = document.getElementById('originalSceneLink');
            
            downloadBtn.style.display = 'inline-block';
            qualitySelector.value = '720p';
            
            // ⭐ Set the original scene link
            if (originalLink) {
                originalLink.href = sceneUrl;
                originalLink.style.display = 'inline-block';
            }
            
            modal.classList.add('active');
            loading.style.display = 'block';
            loading.textContent = '⏳ Loading video...';
            errorEl.style.display = 'none';
            titleEl.textContent = title || 'Video';
            video.pause();
            video.currentTime = 0;
            source.src = '';
            video.load();
            
            try {
                let videoUrl = video720p;
                
                if (!videoUrl || !videoUrl.includes('get_file')) {
                    videoUrl = video480p;
                    if (videoUrl && videoUrl.includes('get_file')) {
                        qualitySelector.value = '480p';
                        currentQuality = '480p';
                    }
                }
                
                if (!videoUrl || !videoUrl.includes('get_file')) {
                    if (sceneUrl) {
                        const response = await fetch(`/api/video/url?sceneUrl=${encodeURIComponent(sceneUrl)}`);
                        const data = await response.json();
                        if (data.success && data.videoUrl) {
                            videoUrl = data.videoUrl;
                        } else {
                            throw new Error(data.error || 'Video URL not found');
                        }
                    } else {
                        throw new Error('No video URL or scene URL provided');
                    }
                }
                
                console.log('🎬 Video URL:', videoUrl);
                
                currentVideoUrl = videoUrl;
                currentDownloadUrl = videoUrl;
                source.src = videoUrl;
                video.load();
                
                video.oncanplay = function() {
                    console.log('✅ Video can play');
                    videoLoaded = true;
                    loading.style.display = 'none';
                    video.play().catch(e => console.log('Autoplay prevented:', e));
                };
                
                video.onerror = function(e) {
                    console.error('❌ Video error:', e);
                    loading.style.display = 'none';
                    errorEl.style.display = 'block';
                    errorEl.innerHTML = `
                        ❌ Error loading video
                        <br><br>
                        <a href="${videoUrl}" target="_blank" style="color: #667eea; text-decoration: underline;">
                            📥 Try opening directly in new tab
                        </a>
                        <br><br>
                        <span style="font-size: 12px; color: #666;">
                            If the video doesn't play, the link may have expired.
                        </span>
                    `;
                };
                
            } catch (error) {
                console.error('❌ Error:', error.message);
                loading.style.display = 'none';
                errorEl.style.display = 'block';
                errorEl.innerHTML = `
                    ❌ ${error.message}
                    <br><br>
                    <button onclick="closeVideoModal()" style="
                        padding: 8px 20px;
                        border-radius: 8px;
                        border: 1px solid #667eea;
                        background: transparent;
                        color: #667eea;
                        cursor: pointer;
                    ">Close</button>
                `;
            }
        }

        function changeQuality(quality) {
            if (isLoadingQuality) {
                console.log('⚠️ Already switching quality, please wait...');
                return;
            }
            
            console.log('🔄 Switching to:', quality);
            
            const video = document.getElementById('videoPlayer');
            const source = document.getElementById('videoSource');
            const loading = document.getElementById('videoLoading');
            const errorEl = document.getElementById('videoError');
            const downloadBtn = document.getElementById('downloadBtn');
            
            downloadBtn.style.display = 'inline-block';
            
            const currentTime = video.currentTime;
            const wasPlaying = !video.paused;
            
            isLoadingQuality = true;
            loading.style.display = 'block';
            loading.textContent = '⏳ Switching quality...';
            errorEl.style.display = 'none';
            
            let videoUrl = null;
            if (quality === '720p') {
                videoUrl = currentVideo720p;
            } else {
                videoUrl = currentVideo480p;
            }
            
            if (!videoUrl || !videoUrl.includes('get_file')) {
                if (quality === '720p' && currentVideo480p && currentVideo480p.includes('get_file')) {
                    videoUrl = currentVideo480p;
                    document.getElementById('qualitySelector').value = '480p';
                    currentQuality = '480p';
                    console.log('⚠️ 720p not available, switching to 480p');
                } else if (quality === '480p' && currentVideo720p && currentVideo720p.includes('get_file')) {
                    videoUrl = currentVideo720p;
                    document.getElementById('qualitySelector').value = '720p';
                    currentQuality = '720p';
                    console.log('⚠️ 480p not available, switching to 720p');
                } else {
                    loading.style.display = 'none';
                    isLoadingQuality = false;
                    alert('This quality is not available for this video');
                    return;
                }
            }
            
            currentQuality = quality;
            currentVideoUrl = videoUrl;
            currentDownloadUrl = videoUrl;
            
            source.src = videoUrl;
            video.load();
            
            let qualitySwitchDone = false;
            
            const onCanPlay = function() {
                if (!qualitySwitchDone) {
                    qualitySwitchDone = true;
                    console.log('✅ Quality switched to:', quality);
                    loading.style.display = 'none';
                    video.currentTime = currentTime;
                    if (wasPlaying) {
                        video.play().catch(e => console.log('Autoplay prevented:', e));
                    }
                    isLoadingQuality = false;
                    video.removeEventListener('canplay', onCanPlay);
                    video.removeEventListener('error', onError);
                }
            };
            
            const onError = function(e) {
                if (!qualitySwitchDone) {
                    qualitySwitchDone = true;
                    console.error('❌ Error switching quality:', e);
                    loading.style.display = 'none';
                    errorEl.style.display = 'block';
                    errorEl.innerHTML = `
                        ❌ Failed to switch quality
                        <br><br>
                        <span style="font-size: 12px; color: #666;">
                            The video may not be available in this quality.
                        </span>
                        <br><br>
                        <button onclick="closeVideoModal()" style="
                            padding: 8px 20px;
                            border-radius: 8px;
                            border: 1px solid #667eea;
                            background: transparent;
                            color: #667eea;
                            cursor: pointer;
                        ">Close</button>
                    `;
                    isLoadingQuality = false;
                    video.removeEventListener('canplay', onCanPlay);
                    video.removeEventListener('error', onError);
                }
            };
            
            video.addEventListener('canplay', onCanPlay);
            video.addEventListener('error', onError);
        }

        function downloadVideo() {
            if (!currentDownloadUrl) {
                alert('No video URL available');
                return;
            }
            
            let filename = currentVideoTitle || 'video';
            filename = filename.replace(/[^a-zA-Z0-9 ]/g, '').trim();
            filename = filename.replace(/\s+/g, '_') || 'video';
            filename += '.mp4';
            
            let downloadUrl = currentDownloadUrl;
            
            if (downloadUrl && downloadUrl.includes('fpvcdn.com')) {
                downloadUrl = currentQuality === '720p' ? currentVideo720p : currentVideo480p;
            }
            
            if (!downloadUrl || !downloadUrl.includes('get_file')) {
                alert('Download URL not available');
                return;
            }
            
            if (!downloadUrl.includes('download=true')) {
                downloadUrl = downloadUrl + 
                    (downloadUrl.includes('?') ? '&' : '?') + 
                    `download=true&download_filename=${encodeURIComponent(filename)}`;
            }
            
            console.log('⬇️ Downloading:', downloadUrl);
            window.open(downloadUrl, '_blank');
        }

        function closeVideoModal() {
            console.log('🔒 Closing video modal');
            const modal = document.getElementById('videoModal');
            const video = document.getElementById('videoPlayer');
            const source = document.getElementById('videoSource');
            
            isLoadingQuality = false;
            
            video.pause();
            video.currentTime = 0;
            source.src = '';
            video.load();
            modal.classList.remove('active');
            currentVideoUrl = null;
            
            document.getElementById('videoLoading').style.display = 'none';
            document.getElementById('videoLoading').textContent = '⏳ Loading video...';
            document.getElementById('videoError').style.display = 'none';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeVideoModal();
            }
        });

        document.getElementById('videoModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeVideoModal();
            }
        });

        window.addEventListener('beforeunload', function() {
            closeVideoModal();
        });
    </script>
</body>
</html>