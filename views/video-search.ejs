<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            background: #0a0a0a; 
            color: #e0e0e0; 
            min-height: 100vh;
        }
        .app { max-width: 1400px; margin: 0 auto; padding: 16px; }
        
        header { 
            margin-bottom: 20px; 
            padding: 16px 0; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            flex-wrap: wrap;
            border-bottom: 1px solid #1a1a1a;
        }
        header h1 { 
            font-size: 24px; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
        }
        .back-link { 
            display: inline-block; 
            color: #667eea; 
            text-decoration: none; 
            font-size: 14px;
            padding: 8px 16px;
            border: 1px solid #667eea;
            border-radius: 8px;
        }
        .back-link:hover { 
            background: #667eea; 
            color: #fff;
        }

        .controls-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
            padding: 16px;
            background: #1a1a1a;
            border-radius: 12px;
            border: 1px solid #2a2a2a;
            align-items: center;
        }
        .controls-bar .search-input {
            flex: 1;
            min-width: 200px;
            padding: 8px 14px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
        }
        .controls-bar .search-input:focus {
            outline: none;
            border-color: #667eea;
        }
        .controls-bar .search-btn {
            padding: 8px 20px;
            border-radius: 8px;
            border: none;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .controls-bar .search-btn:hover {
            opacity: 0.85;
        }
        .controls-bar .sort-select {
            padding: 8px 14px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
            cursor: pointer;
        }
        .controls-bar .sort-select:focus {
            outline: none;
            border-color: #667eea;
        }
        .controls-bar .clear-btn {
            padding: 8px 16px;
            border-radius: 8px;
            border: 1px solid #ff6b6b;
            background: transparent;
            color: #ff6b6b;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
        }
        .controls-bar .clear-btn:hover {
            background: #ff6b6b;
            color: #fff;
        }
        .controls-bar .favorites-btn {
            padding: 8px 16px;
            border-radius: 8px;
            border: 1px solid #ff9f43;
            background: transparent;
            color: #ff9f43;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
            text-decoration: none;
        }
        .controls-bar .favorites-btn:hover {
            background: #ff9f43;
            color: #fff;
        }
        .controls-bar .favorites-btn.active {
            background: #ff9f43;
            color: #fff;
        }

        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }

        .video-card {
            background: #1a1a1a;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2a2a2a;
            transition: transform 0.2s, border-color 0.2s;
            position: relative;
            cursor: pointer;
        }
        .video-card:hover {
            transform: translateY(-4px);
            border-color: #667eea;
        }

        .video-thumbnail {
            position: relative;
            width: 100%;
            padding-top: 56.25%;
            background: #111;
            overflow: hidden;
        }
        .video-thumbnail img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .video-thumbnail .no-image {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 40px;
            opacity: 0.3;
        }
        .video-thumbnail .duration {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(0,0,0,0.8);
            padding: 2px 10px;
            border-radius: 4px;
            font-size: 12px;
            color: #fff;
        }
        .video-thumbnail .play-btn {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            background: rgba(102, 126, 234, 0.9);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: #fff;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .video-card:hover .play-btn {
            opacity: 1;
        }

        .video-info {
            padding: 12px;
        }
        .video-info .title {
            font-size: 14px;
            color: #fff;
            margin-bottom: 4px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.3;
        }
        .video-info .meta {
            font-size: 12px;
            color: #888;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }
        .video-info .studio {
            color: #667eea;
        }
        .video-info .date {
            color: #888;
            font-size: 11px;
        }
        .video-info .performers {
            color: #888;
            font-size: 11px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 100%;
            display: block;
            margin-top: 2px;
        }

        .video-actions {
            display: flex;
            gap: 8px;
            padding: 6px 12px 10px 12px;
            border-top: 1px solid #1a1a1a;
            background: #111;
        }
        .video-actions .fav-btn {
            padding: 4px 12px;
            border-radius: 4px;
            border: 1px solid #ff9f43;
            background: transparent;
            color: #ff9f43;
            cursor: pointer;
            font-size: 11px;
            transition: all 0.2s;
            text-decoration: none;
        }
        .video-actions .fav-btn:hover {
            background: #ff9f43;
            color: #fff;
        }
        .video-actions .fav-btn.active {
            background: #ff9f43;
            color: #fff;
        }

        .no-videos {
            text-align: center;
            padding: 60px;
            color: #888;
        }
        .no-videos h3 { color: #fff; margin-bottom: 8px; }
        
        .video-stats {
            color: #888;
            font-size: 14px;
            margin-bottom: 16px;
        }

        .pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
            flex-wrap: wrap;
        }
        .page-link {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 8px;
            background: #1a1a1a;
            color: #e0e0e0;
            text-decoration: none;
            border: 1px solid #2a2a2a;
            font-size: 14px;
            transition: background 0.2s;
            cursor: pointer;
        }
        .page-link:hover {
            background: #2a2a2a;
            border-color: #667eea;
        }
        .page-link.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: #667eea;
            color: #fff;
        }

        .search-hint {
            color: #666;
            font-size: 13px;
            margin-bottom: 12px;
            padding: 8px 16px;
            background: #111;
            border-radius: 8px;
            border: 1px solid #1a1a1a;
        }
        .search-hint strong {
            color: #888;
        }

        @media (max-width: 768px) {
            .video-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
            .video-modal .video-container { width: 98%; }
            .video-modal .close-modal { top: 10px; right: 20px; font-size: 30px; }
            .controls-bar { flex-direction: column; align-items: stretch; }
            .controls-bar .search-input { min-width: auto; }
        }
    </style>
</head>
<body>
    <div class="app">
        <header>
            <div>
                <a href="/" class="back-link">← Back to Home</a>
                <h1>🎬 Global Video Search</h1>
            </div>
            <div>
                <span style="color: #888; font-size: 14px;">
                    <%= totalVideos %> videos found
                </span>
            </div>
        </header>

        <!-- Search Controls -->
        <div class="controls-bar">
            <form method="get" action="/video-search" style="display: flex; flex-wrap: wrap; gap: 12px; flex: 1; width: 100%;">
                <input type="text" name="q" class="search-input" placeholder="Search videos by title, studio, performer..." value="<%= searchTerm %>">
                <select name="sort" class="sort-select">
                    <option value="date" <%= sortBy === 'date' ? 'selected' : '' %>>Sort by Date</option>
                    <option value="title" <%= sortBy === 'title' ? 'selected' : '' %>>Sort by Title</option>
                    <option value="duration" <%= sortBy === 'duration' ? 'selected' : '' %>>Sort by Duration</option>
                </select>
                <button type="submit" class="search-btn">🔍 Search</button>
                <% if (searchTerm) { %>
                    <a href="/video-search?favorites=false" class="clear-btn">✕ Clear</a>
                <% } %>
                <a href="/video-search?favorites=true<%= searchTerm ? '&q=' + encodeURIComponent(searchTerm) : '' %>" class="favorites-btn <%= showFavoritesOnly ? 'active' : '' %>">⭐ Favorites</a>
            </form>
        </div>

        <% if (searchTerm) { %>
            <div class="search-hint">
                💡 Separate terms with commas: <strong>Studio X, Performer A, Performer B</strong>
                <br>
                Examples: <strong>Brazzers, Mia Malkova</strong> | <strong>Riley Reid, Abella Danger</strong> | <strong>BLACKED, Chloe Temple</strong>
            </div>
        <% } %>

        <% if (videos && videos.length > 0) { %>
            <div class="video-stats">
                Showing <%= (currentPage - 1) * perPage + 1 %> - <%= Math.min(currentPage * perPage, totalVideos) %> of <%= totalVideos %> videos
                <% if (searchTerm) { %>
                    <span style="color: #667eea;">— Search: "<%= searchTerm %>"</span>
                <% } %>
                <% if (showFavoritesOnly) { %>
                    <span style="color: #ff9f43;">— ⭐ Favorites Only</span>
                <% } %>
            </div>

            <div class="video-grid">
                <% videos.forEach(scene => { 
                    // Generate thumbnail
                    let thumbnail = scene.thumbnail || '';
                    let videoId = null;
                    
                    if (scene.video720p) {
                        const match = scene.video720p.match(/\/(\d+)_\d+[pm]\.mp4/);
                        if (match) videoId = match[1];
                    }
                    
                    if (!videoId && scene.video480p) {
                        const match = scene.video480p.match(/\/(\d+)_\d+[pm]\.mp4/);
                        if (match) videoId = match[1];
                    }
                    
                    if (!videoId && scene.url) {
                        const match = scene.url.match(/\/videos\/(\d+)/);
                        if (match) videoId = match[1];
                    }
                    
                    if (videoId && !thumbnail) {
                        const prefix = String(videoId).substring(0, 5);
                        thumbnail = `https://img.freesexvideos.xxx/${prefix}000/${videoId}/medium@2x/1.jpg`;
                    }
                    
                    let displayDate = '';
                    if (scene.date) {
                        const parts = scene.date.split('.');
                        if (parts.length === 3) {
                            displayDate = `${parts[1]}/${parts[0]}/${parts[2]}`;
                        } else {
                            displayDate = scene.date;
                        }
                    }
                    
                    // ESCAPE FOR JAVASCRIPT
                    const safeTitle = JSON.stringify(scene.title || 'Untitled Scene');
                    const safeSceneUrl = JSON.stringify(scene.url || '');
                    const safeThumbnail = JSON.stringify(thumbnail || '');
                    const safeVideo720p = JSON.stringify(scene.video720p || '');
                    const safeVideo480p = JSON.stringify(scene.video480p || '');
                    
                    const isFavorited = scene.isFavorited || false;
                %>
                <div class="video-card">
                    <div class="video-thumbnail" onclick="playVideo(<%= safeSceneUrl %>, <%= safeTitle %>, <%= safeThumbnail %>, <%= safeVideo720p %>, <%= safeVideo480p %>)">
                        <% if (thumbnail && thumbnail.startsWith('http')) { %>
                            <img src="<%= thumbnail %>" alt="<%= scene.title %>" loading="lazy">
                        <% } else { %>
                            <div class="no-image">🎬</div>
                        <% } %>
                        <div class="duration"><%= scene.duration || 'N/A' %></div>
                        <div class="play-btn">▶</div>
                    </div>
                    <div class="video-info">
                        <div class="title"><%= scene.title %></div>
                        <div class="meta">
                            <% if (scene.studio) { %>
                                <span class="studio">🏢 <%= scene.studio %></span>
                            <% } %>
                            <% if (displayDate) { %>
                                <span class="date">📅 <%= displayDate %></span>
                            <% } %>
                            <% if (scene.performers && scene.performers.length > 0) { %>
                                <span class="performers">👥 <%= scene.performers %></span>
                            <% } %>
                        </div>
                    </div>
                    <div class="video-actions">
                        <form method="POST" action="/video-favorites/toggle" style="display: inline;">
                            <input type="hidden" name="scene_url" value="<%= scene.url %>">
                            <input type="hidden" name="title" value="<%= scene.title %>">
                            <input type="hidden" name="thumbnail" value="<%= thumbnail %>">
                            <input type="hidden" name="video720p" value="<%= scene.video720p %>">
                            <input type="hidden" name="video480p" value="<%= scene.video480p %>">
                            <input type="hidden" name="studio" value="<%= scene.studio %>">
                            <input type="hidden" name="performers" value="<%= scene.performers %>">
                            <input type="hidden" name="duration" value="<%= scene.duration %>">
                            <input type="hidden" name="date" value="<%= scene.date %>">
                            <button type="submit" class="fav-btn <%= isFavorited ? 'active' : '' %>">
                                <%= isFavorited ? '⭐ Favorited' : '☆ Add Favorite' %>
                            </button>
                        </form>
                    </div>
                </div>
                <% }) %>
            </div>

            <!-- Pagination - FIXED -->
            <% if (totalPages > 1) { %>
                <div class="pagination">
                    <% if (currentPage > 1) { %>
                        <a href="/video-search?q=<%= encodeURIComponent(searchTerm) %>&sort=<%= sortBy %>&page=<%= currentPage - 1 %><% if (showFavoritesOnly) { %>&favorites=true<% } %>" class="page-link">← Previous</a>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <% if (i === currentPage) { %>
                            <span class="page-link active"><%= i %></span>
                        <% } else if (i <= 3 || i > totalPages - 3 || Math.abs(i - currentPage) <= 1) { %>
                            <a href="/video-search?q=<%= encodeURIComponent(searchTerm) %>&sort=<%= sortBy %>&page=<%= i %><% if (showFavoritesOnly) { %>&favorites=true<% } %>" class="page-link"><%= i %></a>
                        <% } else if (i === 4 && currentPage > 5) { %>
                            <span class="page-link">…</span>
                        <% } else if (i === totalPages - 3 && currentPage < totalPages - 4) { %>
                            <span class="page-link">…</span>
                        <% } %>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <a href="/video-search?q=<%= encodeURIComponent(searchTerm) %>&sort=<%= sortBy %>&page=<%= currentPage + 1 %><% if (showFavoritesOnly) { %>&favorites=true<% } %>" class="page-link">Next →</a>
                    <% } %>
                </div>
            <% } %>
        <% } else { %>
            <div class="no-videos">
                <% if (searchTerm) { %>
                    <h3>🔍 No Results Found</h3>
                    <p>No videos found for "<%= searchTerm %>"</p>
                    <% if (showFavoritesOnly) { %>
                        <p style="margin-top: 8px;">No favorites found matching your search.</p>
                    <% } %>
                    <p style="margin-top: 8px; font-size: 12px; color: #666;">
                        Try using fewer terms or different keywords.
                    </p>
                <% } else { %>
                    <h3>🔍 Search for Videos</h3>
                    <p>Enter a search term above to find videos</p>
                    <p style="margin-top: 8px; font-size: 12px; color: #666;">
                        Examples: Studio, Performer, Title
                    </p>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- ===== VIDEO MODAL ===== -->
    <div class="video-modal" id="videoModal">
        <button class="close-modal" onclick="closeVideoModal()">✕</button>
        <div class="video-container">
            <div id="videoLoading" class="video-loading" style="display: none;">⏳ Loading video...</div>
            <div id="videoError" class="video-error" style="display:none;"></div>
            
            <video id="videoPlayer" width="100%" controls preload="metadata" playsinline>
                <source id="videoSource" src="" type="video/mp4">
                Your browser does not support the video tag.
            </video>
            
            <div id="videoTitle" class="video-title">Video</div>
            
            <div class="video-controls">
                <button onclick="closeVideoModal()">✕ Close</button>
                <button onclick="document.getElementById('videoPlayer').requestFullscreen()">⛶ Fullscreen</button>
                <button onclick="document.getElementById('videoPlayer').play()">▶ Play</button>
                <button onclick="document.getElementById('videoPlayer').pause()">⏸ Pause</button>
                <select id="qualitySelector" class="quality-selector" onchange="changeQuality(this.value)">
                    <option value="720p">720p (HD)</option>
                    <option value="480p">480p (SD)</option>
                </select>
                <button onclick="downloadVideo()" class="download-btn" id="downloadBtn">⬇️ Download</button>
                <a href="#" id="originalSceneLink" target="_blank" class="original-link-btn" rel="noopener noreferrer" style="display: none;">
                    🌐 Original Scene
                </a>
            </div>
        </div>
    </div>

    <style>
        .video-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        .video-modal.active {
            display: flex;
        }
        .video-modal .close-modal {
            position: absolute;
            top: 20px;
            right: 30px;
            font-size: 40px;
            color: #fff;
            cursor: pointer;
            z-index: 1001;
            font-family: Arial, sans-serif;
            background: none;
            border: none;
            padding: 10px;
            line-height: 1;
        }
        .video-modal .close-modal:hover {
            color: #667eea;
            transform: scale(1.2);
        }
        .video-modal .video-container {
            width: 90%;
            max-width: 1000px;
            max-height: 90vh;
            position: relative;
        }
        .video-modal video {
            width: 100%;
            max-height: 80vh;
            background: #000;
            border-radius: 8px;
        }
        .video-modal .video-title {
            color: #fff;
            font-size: 18px;
            margin-top: 12px;
            text-align: center;
            max-width: 90%;
        }
        .video-modal .video-controls {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 12px;
            flex-wrap: wrap;
            align-items: center;
        }
        .video-modal .video-controls button {
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid #667eea;
            background: transparent;
            color: #667eea;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 14px;
        }
        .video-modal .video-controls button:hover {
            background: #667eea;
            color: #fff;
        }
        .video-modal .video-controls .download-btn {
            background: #4caf50;
            color: white;
            border-color: #4caf50;
            display: inline-block;
        }
        .video-modal .video-controls .download-btn:hover {
            background: #45a049;
            border-color: #45a049;
        }
        .video-modal .video-controls .quality-selector {
            padding: 8px 14px;
            border-radius: 20px;
            border: 1px solid #333;
            background: #1a1a1a;
            color: #e0e0e0;
            font-size: 13px;
            cursor: pointer;
            outline: none;
        }
        .video-modal .video-controls .quality-selector:focus {
            border-color: #667eea;
        }
        .video-modal .video-controls .quality-selector option {
            background: #1a1a1a;
            color: #e0e0e0;
        }
        .original-link-btn {
            display: inline-block;
            padding: 8px 20px;
            border-radius: 20px;
            border: 1px solid #ff9f43;
            background: transparent;
            color: #ff9f43;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 14px;
            font-family: inherit;
        }
        .original-link-btn:hover {
            background: #ff9f43;
            color: #fff;
        }
        .video-modal .video-loading {
            color: #888;
            text-align: center;
            padding: 40px;
            font-size: 18px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
        }
        .video-modal .video-error {
            color: #ff6b6b;
            text-align: center;
            padding: 40px;
            font-size: 18px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
        }
        .video-modal .video-error a {
            color: #667eea;
        }
    </style>

    <script>
        // =========================
        // VIDEO PLAYER
        // =========================
        let currentVideoUrl = null;
        let currentSceneUrl = null;
        let currentVideoTitle = '';
        let currentDownloadUrl = null;
        let currentVideo720p = null;
        let currentVideo480p = null;
        let currentQuality = '720p';
        let isLoadingQuality = false;
        let videoLoaded = false;

        async function playVideo(sceneUrl, title, thumbnail, video720p, video480p) {
            console.log('🎬 Playing video:', title);
            
            currentSceneUrl = sceneUrl;
            currentVideoTitle = title;
            currentVideo720p = video720p;
            currentVideo480p = video480p;
            currentQuality = '720p';
            isLoadingQuality = false;
            videoLoaded = false;
            
            const loading = document.getElementById('videoLoading');
            const modal = document.getElementById('videoModal');
            const errorEl = document.getElementById('videoError');
            const video = document.getElementById('videoPlayer');
            const titleEl = document.getElementById('videoTitle');
            const source = document.getElementById('videoSource');
            const downloadBtn = document.getElementById('downloadBtn');
            const qualitySelector = document.getElementById('qualitySelector');
            const originalLink = document.getElementById('originalSceneLink');
            
            downloadBtn.style.display = 'inline-block';
            
            if (originalLink) {
                originalLink.href = sceneUrl;
                originalLink.style.display = 'inline-block';
            }
            
            qualitySelector.value = '720p';
            
            modal.classList.add('active');
            loading.style.display = 'block';
            loading.textContent = '⏳ Loading video...';
            errorEl.style.display = 'none';
            titleEl.textContent = title || 'Video';
            video.pause();
            video.currentTime = 0;
            source.src = '';
            video.load();
            
            try {
                let videoUrl = video720p;
                
                if (!videoUrl || !videoUrl.includes('get_file')) {
                    videoUrl = video480p;
                    if (videoUrl && videoUrl.includes('get_file')) {
                        qualitySelector.value = '480p';
                        currentQuality = '480p';
                    }
                }
                
                if (!videoUrl || !videoUrl.includes('get_file')) {
                    const response = await fetch(`/api/video/url?sceneUrl=${encodeURIComponent(sceneUrl)}`);
                    const data = await response.json();
                    if (data.success && data.videoUrl) {
                        videoUrl = data.videoUrl;
                    } else {
                        throw new Error(data.error || 'Video URL not found');
                    }
                }
                
                console.log('🎬 Video URL:', videoUrl);
                
                currentVideoUrl = videoUrl;
                currentDownloadUrl = videoUrl;
                source.src = videoUrl;
                video.load();
                
                video.oncanplay = function() {
                    console.log('✅ Video can play');
                    videoLoaded = true;
                    loading.style.display = 'none';
                    video.play().catch(e => console.log('Autoplay prevented:', e));
                };
                
                video.onerror = function(e) {
                    console.error('❌ Video error:', e);
                    loading.style.display = 'none';
                    errorEl.style.display = 'block';
                    errorEl.innerHTML = `
                        ❌ Error loading video
                        <br><br>
                        <a href="${videoUrl}" target="_blank" style="color: #667eea; text-decoration: underline;">
                            📥 Try opening directly in new tab
                        </a>
                        <br><br>
                        <span style="font-size: 12px; color: #666;">
                            If the video doesn't play, the link may have expired.
                        </span>
                    `;
                };
                
            } catch (error) {
                console.error('❌ Error:', error.message);
                loading.style.display = 'none';
                errorEl.style.display = 'block';
                errorEl.innerHTML = `
                    ❌ ${error.message}
                    <br><br>
                    <button onclick="closeVideoModal()" style="
                        padding: 8px 20px;
                        border-radius: 8px;
                        border: 1px solid #667eea;
                        background: transparent;
                        color: #667eea;
                        cursor: pointer;
                    ">Close</button>
                `;
            }
        }

        function changeQuality(quality) {
            if (isLoadingQuality) {
                console.log('⚠️ Already switching quality, please wait...');
                return;
            }
            
            console.log('🔄 Switching to:', quality);
            
            const video = document.getElementById('videoPlayer');
            const source = document.getElementById('videoSource');
            const loading = document.getElementById('videoLoading');
            const errorEl = document.getElementById('videoError');
            const downloadBtn = document.getElementById('downloadBtn');
            
            downloadBtn.style.display = 'inline-block';
            
            const currentTime = video.currentTime;
            const wasPlaying = !video.paused;
            
            isLoadingQuality = true;
            loading.style.display = 'block';
            loading.textContent = '⏳ Switching quality...';
            errorEl.style.display = 'none';
            
            let videoUrl = null;
            if (quality === '720p') {
                videoUrl = currentVideo720p;
            } else {
                videoUrl = currentVideo480p;
            }
            
            if (!videoUrl || !videoUrl.includes('get_file')) {
                if (quality === '720p' && currentVideo480p && currentVideo480p.includes('get_file')) {
                    videoUrl = currentVideo480p;
                    document.getElementById('qualitySelector').value = '480p';
                    currentQuality = '480p';
                    console.log('⚠️ 720p not available, switching to 480p');
                } else if (quality === '480p' && currentVideo720p && currentVideo720p.includes('get_file')) {
                    videoUrl = currentVideo720p;
                    document.getElementById('qualitySelector').value = '720p';
                    currentQuality = '720p';
                    console.log('⚠️ 480p not available, switching to 720p');
                } else {
                    loading.style.display = 'none';
                    isLoadingQuality = false;
                    alert('This quality is not available for this video');
                    return;
                }
            }
            
            currentQuality = quality;
            currentVideoUrl = videoUrl;
            currentDownloadUrl = videoUrl;
            
            source.src = videoUrl;
            video.load();
            
            let qualitySwitchDone = false;
            
            const onCanPlay = function() {
                if (!qualitySwitchDone) {
                    qualitySwitchDone = true;
                    console.log('✅ Quality switched to:', quality);
                    loading.style.display = 'none';
                    video.currentTime = currentTime;
                    if (wasPlaying) {
                        video.play().catch(e => console.log('Autoplay prevented:', e));
                    }
                    isLoadingQuality = false;
                    video.removeEventListener('canplay', onCanPlay);
                    video.removeEventListener('error', onError);
                }
            };
            
            const onError = function(e) {
                if (!qualitySwitchDone) {
                    qualitySwitchDone = true;
                    console.error('❌ Error switching quality:', e);
                    loading.style.display = 'none';
                    errorEl.style.display = 'block';
                    errorEl.innerHTML = `
                        ❌ Failed to switch quality
                        <br><br>
                        <span style="font-size: 12px; color: #666;">
                            The video may not be available in this quality.
                        </span>
                        <br><br>
                        <button onclick="closeVideoModal()" style="
                            padding: 8px 20px;
                            border-radius: 8px;
                            border: 1px solid #667eea;
                            background: transparent;
                            color: #667eea;
                            cursor: pointer;
                        ">Close</button>
                    `;
                    isLoadingQuality = false;
                    video.removeEventListener('canplay', onCanPlay);
                    video.removeEventListener('error', onError);
                }
            };
            
            video.addEventListener('canplay', onCanPlay);
            video.addEventListener('error', onError);
        }

        function downloadVideo() {
            if (!currentDownloadUrl) {
                alert('No video URL available');
                return;
            }
            
            let filename = currentVideoTitle || 'video';
            filename = filename.replace(/[^a-zA-Z0-9 ]/g, '').trim();
            filename = filename.replace(/\s+/g, '_') || 'video';
            filename += '.mp4';
            
            let downloadUrl = currentDownloadUrl;
            
            if (downloadUrl && downloadUrl.includes('fpvcdn.com')) {
                downloadUrl = currentQuality === '720p' ? currentVideo720p : currentVideo480p;
            }
            
            if (!downloadUrl || !downloadUrl.includes('get_file')) {
                alert('Download URL not available');
                return;
            }
            
            if (!downloadUrl.includes('download=true')) {
                downloadUrl = downloadUrl + 
                    (downloadUrl.includes('?') ? '&' : '?') + 
                    `download=true&download_filename=${encodeURIComponent(filename)}`;
            }
            
            console.log('⬇️ Downloading:', downloadUrl);
            window.open(downloadUrl, '_blank');
        }

        function closeVideoModal() {
            console.log('🔒 Closing video modal');
            const modal = document.getElementById('videoModal');
            const video = document.getElementById('videoPlayer');
            const source = document.getElementById('videoSource');
            
            isLoadingQuality = false;
            
            video.pause();
            video.currentTime = 0;
            source.src = '';
            video.load();
            modal.classList.remove('active');
            currentVideoUrl = null;
            
            document.getElementById('videoLoading').style.display = 'none';
            document.getElementById('videoLoading').textContent = '⏳ Loading video...';
            document.getElementById('videoError').style.display = 'none';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeVideoModal();
            }
        });

        document.getElementById('videoModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeVideoModal();
            }
        });

        window.addEventListener('beforeunload', function() {
            closeVideoModal();
        });
    </script>
</body>
</html>