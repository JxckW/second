<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif; background: #0a0a0a; color: #e0e0e0; padding: 0; margin: 0; min-height: 100vh; }
        .app { max-width: 1200px; margin: 0 auto; padding: 16px; }
        header { margin-bottom: 20px; padding: 16px 0; }
        header h1 { font-size: 28px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block; }
        .back-link { display: inline-block; color: #667eea; text-decoration: none; font-size: 14px; margin-bottom: 10px; }
        .back-link:hover { text-decoration: underline; }
        .scene-detail { display: flex; flex-direction: column; gap: 24px; }
        .scene-detail-image { width: 100%; border-radius: 16px; overflow: hidden; background: #1a1a1a; }
        .scene-detail-image img { width: 100%; display: block; }
        .scene-detail-image .no-image { padding: 100px; text-align: center; font-size: 80px; opacity: 0.3; }
        .scene-detail-info h2 { font-size: 24px; color: #fff; margin-bottom: 16px; }
        .scene-detail-meta { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin-bottom: 20px; }
        .detail-item { background: #1a1a1a; padding: 10px 14px; border-radius: 8px; border: 1px solid #2a2a2a; }
        .detail-label { display: block; font-size: 12px; color: #888; margin-bottom: 2px; }
        .detail-value { font-size: 14px; color: #e0e0e0; }
        .scene-performers-list, .scene-detail-description, .scene-detail-tags { margin-top: 16px; }
        .scene-performers-list h4, .scene-detail-description h4, .scene-detail-tags h4 { color: #888; font-size: 14px; margin-bottom: 8px; }
        .scene-detail-description p { color: #ccc; font-size: 14px; line-height: 1.6; background: #1a1a1a; padding: 12px 16px; border-radius: 8px; border: 1px solid #2a2a2a; }
        .performer-list { display: flex; flex-wrap: wrap; gap: 8px; }
        .performer-chip { display: inline-block; background: #252525; padding: 6px 14px; border-radius: 12px; font-size: 13px; color: #e0e0e0; text-decoration: none; border: 1px solid #333; transition: border-color 0.2s; }
        .performer-chip:hover { border-color: #667eea; }
        .tag { display: inline-block; background: #252525; padding: 4px 10px; border-radius: 12px; font-size: 12px; border: 1px solid #333; margin: 3px; }
        .error-message { background: #2a1a1a; border: 1px solid #662222; color: #ff6b6b; padding: 12px 16px; border-radius: 12px; margin-bottom: 16px; }
        footer { text-align: center; color: #444; font-size: 12px; padding: 20px; margin-top: 20px; }
        .favorite-btn { background: none; border: 1px solid #555; color: #888; padding: 6px 16px; border-radius: 20px; cursor: pointer; font-size: 14px; transition: all 0.2s; white-space: nowrap; }
        .favorite-btn:hover { border-color: #667eea; color: #667eea; }
        .favorite-btn.active { border-color: #f0c040; color: #f0c040; }
        .scene-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
        @media (max-width: 768px) { .scene-detail-meta { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="app">
        <header>
            <a href="javascript:history.back()" class="back-link">← Back</a>
            <h1>Scene Details</h1>
        </header>

        <% if (scene) { %>
            <div class="scene-detail">
                <div class="scene-detail-image">
                    <% if (scene.images && scene.images.length > 0 && scene.images[0].url) { %>
                        <img src="<%= scene.images[0].url %>" alt="<%= scene.title || 'Scene' %>">
                    <% } else { %>
                        <div class="no-image">🎬</div>
                    <% } %>
                </div>
                
                <div class="scene-detail-info">
                    <div class="scene-header">
                        <h2><%= scene.title || 'Untitled Scene' %></h2>
                        <button onclick="toggleFavoriteScene()" 
                                class="favorite-btn <%= isFavorited ? 'active' : '' %>">
                            <%= isFavorited ? '⭐ Favorited' : '☆ Favorite' %>
                        </button>
                    </div>
                    
                    <div class="scene-detail-meta">
                        <% if (scene.studio) { %>
                            <div class="detail-item">
                                <span class="detail-label">🏢 Studio</span>
                                <span class="detail-value"><%= scene.studio.name %></span>
                            </div>
                        <% } %>
                        <% if (scene.date) { %>
                            <div class="detail-item">
                                <span class="detail-label">📅 Date</span>
                                <span class="detail-value"><%= new Date(scene.date).toLocaleDateString() %></span>
                            </div>
                        <% } %>
                        <% if (scene.duration) { %>
                            <div class="detail-item">
                                <span class="detail-label">⏱️ Duration</span>
                                <span class="detail-value"><%= Math.floor(scene.duration / 60) %>m <%= scene.duration % 60 %>s</span>
                            </div>
                        <% } %>
                        <% if (scene.director) { %>
                            <div class="detail-item">
                                <span class="detail-label">🎥 Director</span>
                                <span class="detail-value"><%= scene.director %></span>
                            </div>
                        <% } %>
                    </div>

                    <% if (scene.performers && scene.performers.length > 0) { %>
                        <div class="scene-performers-list">
                            <h4>👥 Performers</h4>
                            <div class="performer-list">
                                <% scene.performers.forEach(p => { %>
                                    <a href="/performer/<%= p.performer.id %>" class="performer-chip">
                                        <%= p.performer.name %>
                                    </a>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                    <% if (scene.details) { %>
                        <div class="scene-detail-description">
                            <h4>📝 Description</h4>
                            <p><%= scene.details %></p>
                        </div>
                    <% } %>

                    <% if (scene.tags && scene.tags.length > 0) { %>
                        <div class="scene-detail-tags">
                            <h4>🏷️ Tags</h4>
                            <div>
                                <% scene.tags.forEach(tag => { %>
                                    <span class="tag">#<%= tag.name %></span>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <div class="error-message">
                <p>❌ Scene not found</p>
                <a href="/" class="back-link">← Go back home</a>
            </div>
        <% } %>

        <footer>
            <p>Data from StashDB</p>
        </footer>
    </div>

    <script>
        // =========================
        // FAVORITE SCENE
        // =========================
        function toggleFavoriteScene() {
            fetch('/api/favorite/scene', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sceneId: '<%= scene.id %>' })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            })
            .catch(err => console.error('Error toggling scene favorite:', err));
        }
    </script>
</body>
</html>