<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <style>
        /* All your CSS styles here (keep the same) */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif; background: #0a0a0a; color: #e0e0e0; padding: 0; margin: 0; min-height: 100vh; }
        .app { max-width: 1200px; margin: 0 auto; padding: 16px; }
        header { margin-bottom: 20px; padding: 16px 0; }
        header h1 { font-size: 28px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block; }
        .back-link { display: inline-block; color: #667eea; text-decoration: none; font-size: 14px; margin-bottom: 10px; }
        .back-link:hover { text-decoration: underline; }
        .profile-header { background: #1a1a1a; border-radius: 16px; padding: 20px; margin-bottom: 24px; display: flex; gap: 20px; flex-wrap: wrap; border: 1px solid #2a2a2a; }
        .profile-image { width: 150px; height: 150px; border-radius: 50%; overflow: hidden; border: 3px solid #667eea; background: #1a1a1a; position: relative; }
        .profile-image img { width: 100%; height: 100%; object-fit: cover; }
        .image-count-badge { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.7); color: #fff; text-align: center; padding: 4px; font-size: 11px; }
        .profile-info { flex: 1; min-width: 200px; }
        .profile-info h2 { font-size: 24px; color: #fff; margin-bottom: 8px; }
        .profile-meta { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
        .badge { background: #252525; padding: 4px 12px; border-radius: 12px; font-size: 13px; border: 1px solid #333; color: #e0e0e0; }
        .profile-detail { font-size: 14px; color: #aaa; margin: 4px 0; }
        .grade-display { background: #2a2a2a; padding: 2px 12px; border-radius: 12px; font-size: 14px; border: 1px solid #444; display: inline-block; margin-top: 4px; }
        .grade-display strong { color: #f0c040; }
        .scenes-section { background: #1a1a1a; border-radius: 16px; padding: 20px; border: 1px solid #2a2a2a; }
        .scenes-section h3 { color: #fff; margin-bottom: 16px; }
        .scene-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
        .scene-card { background: #1a1a1a; border-radius: 12px; overflow: hidden; text-decoration: none; color: #e0e0e0; border: 1px solid #2a2a2a; display: flex; flex-direction: column; transition: transform 0.2s; position: relative; }
        .scene-card:hover { transform: translateY(-4px); border-color: #667eea; }
        .scene-card.hidden { display: none; }
        .scene-thumbnail { position: relative; width: 100%; padding-top: 56.25%; background: #111; overflow: hidden; }
        .scene-thumbnail img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; }
        .scene-thumbnail .no-image { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 40px; opacity: 0.3; }
        .scene-duration { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); padding: 2px 8px; border-radius: 4px; font-size: 12px; color: #fff; }
        .scene-favorite-btn { position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,0.6); border: none; border-radius: 50%; width: 32px; height: 32px; font-size: 16px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; }
        .scene-favorite-btn:hover { transform: scale(1.1); }
        .scene-info { padding: 12px; flex: 1; display: flex; flex-direction: column; }
        .scene-info h4 { font-size: 14px; color: #fff; margin-bottom: 4px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.3; min-height: 36px; }
        .scene-meta { display: flex; gap: 8px; flex-wrap: wrap; font-size: 12px; color: #888; margin-top: auto; }
        .scene-meta .studio { color: #667eea; }
        .scene-meta .date { color: #888; }
        .pagination { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 24px; flex-wrap: wrap; }
        .page-link { display: inline-block; padding: 8px 14px; border-radius: 8px; background: #1a1a1a; color: #e0e0e0; text-decoration: none; border: 1px solid #2a2a2a; font-size: 14px; transition: background 0.2s; }
        .page-link:hover { background: #2a2a2a; border-color: #667eea; }
        .page-link.active { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-color: #667eea; color: #fff; }
        .error-message { background: #2a1a1a; border: 1px solid #662222; color: #ff6b6b; padding: 12px 16px; border-radius: 12px; margin-bottom: 16px; }
        footer { text-align: center; color: #444; font-size: 12px; padding: 20px; margin-top: 20px; }
        .image-nav-btn { background: #667eea; color: #fff; border: none; width: 36px; height: 36px; border-radius: 50%; font-size: 18px; cursor: pointer; transition: background 0.2s; flex-shrink: 0; }
        .image-nav-btn:hover { background: #764ba2; }
        .grade-select { background: #1a1a1a; color: #e0e0e0; border: 1px solid #333; border-radius: 8px; padding: 4px 8px; font-size: 14px; cursor: pointer; }
        .grade-select:focus { outline: none; border-color: #667eea; }
        .favorite-btn { background: none; border: 1px solid #555; color: #888; padding: 4px 14px; border-radius: 20px; cursor: pointer; font-size: 13px; transition: all 0.2s; white-space: nowrap; }
        .favorite-btn:hover { border-color: #667eea; color: #667eea; }
        .favorite-btn.active { border-color: #f0c040; color: #f0c040; }
        .scene-search { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; align-items: center; }
        .scene-search input { flex: 1; min-width: 200px; padding: 10px 14px; border: 2px solid #333; border-radius: 10px; background: #1a1a1a; color: #fff; font-size: 14px; transition: border-color 0.3s; }
        .scene-search input:focus { outline: none; border-color: #667eea; }
        .scene-search button { padding: 10px 18px; border: none; border-radius: 10px; color: #fff; font-weight: 600; font-size: 14px; cursor: pointer; transition: transform 0.2s, opacity 0.2s; }
        .scene-search button:first-of-type { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .scene-search button:last-of-type { background: #333; }
        .scene-search button:hover { transform: scale(1.02); opacity: 0.9; }
        .filter-count { color: #888; font-size: 13px; margin-left: auto; }
        .loading-indicator { text-align: center; padding: 40px; color: #888; }
        .search-form { display: flex; gap: 10px; flex-wrap: wrap; width: 100%; align-items: center; }
        .search-form input { flex: 1; min-width: 200px; padding: 10px 14px; border: 2px solid #333; border-radius: 10px; background: #1a1a1a; color: #fff; font-size: 14px; transition: border-color 0.3s; }
        .search-form input:focus { outline: none; border-color: #667eea; }
        .search-form .btn-search { padding: 10px 18px; border: none; border-radius: 10px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; font-weight: 600; font-size: 14px; cursor: pointer; }
        .search-form .btn-clear { padding: 10px 18px; border: none; border-radius: 10px; background: #333; color: #fff; font-weight: 600; font-size: 14px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; }
        .search-form .btn-search:hover, .search-form .btn-clear:hover { transform: scale(1.02); opacity: 0.9; }
        .search-info { color: #888; font-size: 13px; margin-left: auto; }
        @media (max-width: 1024px) { .scene-grid { grid-template-columns: repeat(3, 1fr); } }
        @media (max-width: 768px) { .scene-grid { grid-template-columns: repeat(2, 1fr); } .profile-image { width: 100px; height: 100px; } }
        @media (max-width: 480px) { .scene-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="app">
        <header>
            <a href="/" class="back-link">← Back</a>
            <h1>Performer Profile</h1>
        </header>

        <% if (performer) { %>
            <div class="performer-profile">
                <div class="profile-header">

                    <!-- Video Mode Button -->
                    <a href="/performer/<%= performerId %>/videos" class="mode-btn" style="
                        display: inline-block;
                        padding: 8px 20px;
                        border-radius: 20px;
                        border: 1px solid #667eea;
                        background: transparent;
                        color: #667eea;
                        text-decoration: none;
                        transition: all 0.2s;
                        margin-left: 10px;
                    ">
                        🎬 Video Mode
                    </a>
                    
                    <div class="profile-image-container">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <button onclick="changeImage(-1)" class="image-nav-btn">❮</button>
                            <div class="profile-image">
                                <% if (performer.images && performer.images.length > 0) { %>
                                    <img id="mainProfileImage" src="<%= performer.images[0].url %>" alt="<%= performer.name %>">
                                    <div class="image-count-badge" id="imageCounter"><%= performer.images.length %> photos</div>
                                <% } else { %>
                                    <div class="no-image large" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 80px; opacity: 0.3;">🎭</div>
                                <% } %>
                            </div>
                            <button onclick="changeImage(1)" class="image-nav-btn">❯</button>
                        </div>
                        <div style="text-align: center; margin-top: 6px; font-size: 12px; color: #888;">
                            <span id="imageIndexDisplay">
                                <% if (performer.images && performer.images.length > 0) { %>
                                    1 / <%= performer.images.length %>
                                <% } else { %>
                                    0 / 0
                                <% } %>
                            </span>
                        </div>
                    </div>
                    <div class="profile-info">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap;">
                            <div>
                                <h2><%= performer.name %></h2>
                                <% if (searchTerm && searchTerm.trim()) { %>
                                    <div style="color: #667eea; font-size: 14px; margin-top: 4px;">
                                        🔍 Searching: "<%= searchTerm %>"
                                    </div>
                                <% } %>
                            </div>
                            <div style="display: flex; align-items: center; gap: 12px; margin-top: 4px; flex-wrap: wrap;">
                                <!-- ⭐ RATING - Updated to use form submission (works through proxy) -->
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span style="color: #888; font-size: 13px;">Grade:</span>
                                    <form method="post" action="/performer/<%= performerId %>/rate" style="display: inline;">
                                        <select name="rating" class="grade-select" onchange="this.closest('form').submit()">
                                            <option value="">—</option>
                                            <option value="S" <%= performerRating === 'S' ? 'selected' : '' %>>S</option>
                                            <option value="A" <%= performerRating === 'A' ? 'selected' : '' %>>A</option>
                                            <option value="B" <%= performerRating === 'B' ? 'selected' : '' %>>B</option>
                                            <option value="C" <%= performerRating === 'C' ? 'selected' : '' %>>C</option>
                                            <option value="D" <%= performerRating === 'D' ? 'selected' : '' %>>D</option>
                                            <option value="F" <%= performerRating === 'F' ? 'selected' : '' %>>F</option>
                                            <option value="U" <%= performerRating === 'U' ? 'selected' : '' %>>U</option>
                                            <option value="L" <%= performerRating === 'L' ? 'selected' : '' %>>L</option>
                                        </select>
                                    </form>
                                </div>
                                <!-- ⭐ FAVORITE - Updated to use form submission (works through proxy) -->
                                <form method="post" action="/performer/<%= performerId %>/favorite" style="display: inline;">
                                    <button type="submit" class="favorite-btn <%= isPerformerFavorited ? 'active' : '' %>">
                                        <%= isPerformerFavorited ? '❤️ Favorited' : '🤍 Favorite' %>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <% if (performerRating) { %>
                            <div class="grade-display">⭐ Grade: <strong><%= performerRating %></strong></div>
                        <% } %>
                        <div class="profile-meta">
                            <% if (performer.gender) { %><span class="badge">⚥ <%= performer.gender %></span><% } %>
                            <% if (performer.age) { %><span class="badge">🎂 <%= performer.age %> years</span><% } %>
                            <% if (performer.scene_count) { %><span class="badge">🎬 <%= performer.scene_count %> scenes</span><% } %>
                            <% if (performer.is_favorite) { %><span class="badge" style="background: #764ba2;">❤️ Favorite</span><% } %>
                        </div>
                        <% if (performer.height) { %><div class="profile-detail">Height: <%= performer.height %> cm</div><% } %>
                        <% if (performer.ethnicity) { %><div class="profile-detail">Ethnicity: <%= performer.ethnicity %></div><% } %>
                        <% if (performer.country) { %><div class="profile-detail">Country: <%= performer.country %></div><% } %>
                        <% if (performer.aliases && performer.aliases.length > 0) { %>
                            <div class="profile-detail">Also known as: <%= performer.aliases.join(', ') %></div>
                        <% } %>
                    </div>
                </div>

                <div class="scenes-section">
                    <h3>🎬 Scenes (<span id="totalSceneCount"><%= totalScenes %></span>)</h3>

                    <!-- Scene Search Bar - Server Side Form -->
                    <div class="scene-search">
                        <form method="get" action="/performer/<%= performerId %>" class="search-form">
                            <input type="text" 
                                   name="q" 
                                   value="<%= searchTerm || '' %>" 
                                   placeholder="Search scenes by title or studio..." 
                                   autofocus>
                            <button type="submit" class="btn-search">🔍 Search</button>
                            <% if (searchTerm && searchTerm.trim()) { %>
                                <a href="/performer/<%= performerId %>" class="btn-clear">✕ Clear</a>
                            <% } %>
                            <span class="search-info">Showing <%= scenes.length %> of <%= totalScenes %> scenes</span>
                        </form>
                    </div>

                    <div class="scene-grid" id="sceneGrid">
                        <% scenes.forEach(scene => { %>
                            <div class="scene-card" data-scene-id="<%= scene.id %>">
                                <a href="/scene/<%= scene.id %>" style="text-decoration: none; color: inherit; display: block; height: 100%;">
                                    <div class="scene-thumbnail">
                                        <% if (scene.images && scene.images.length > 0 && scene.images[0].url) { %>
                                            <img src="<%= scene.images[0].url %>" alt="<%= scene.title || 'Scene' %>" loading="lazy">
                                        <% } else { %>
                                            <div class="no-image">🎬</div>
                                        <% } %>
                                        <% if (scene.duration) { %>
                                            <div class="scene-duration"><%= Math.floor(scene.duration / 60) %>m</div>
                                        <% } %>
                                        <button onclick="event.preventDefault(); event.stopPropagation(); toggleFavoriteScene('<%= scene.id %>', this)" 
                                                class="scene-favorite-btn" 
                                                style="color: <%= scene.isFavorited ? '#f0c040' : '#555' %>;">
                                            <%= scene.isFavorited ? '⭐' : '☆' %>
                                        </button>
                                    </div>
                                    <div class="scene-info">
                                        <h4><%= scene.title || 'Untitled Scene' %></h4>
                                        <div class="scene-meta">
                                            <% if (scene.studio_name) { %>
                                                <span class="studio">🏢 <%= scene.studio_name %></span>
                                            <% } %>
                                            <% if (scene.date) { %>
                                                <span class="date">📅 <%= new Date(scene.date).toLocaleDateString() %></span>
                                            <% } %>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }) %>
                    </div>

                    <!-- No results message -->
                    <% if (scenes.length === 0) { %>
                        <div style="text-align: center; padding: 40px; color: #888;">
                            <p>No scenes found matching "<%= searchTerm %>"</p>
                            <a href="/performer/<%= performerId %>" style="color: #667eea; text-decoration: none;">Clear search</a>
                        </div>
                    <% } %>

                    <!-- Pagination -->
                    <div id="paginationContainer">
                        <% if (totalPages > 1) { %>
                            <div class="pagination" id="pagination">
                                <% if (currentPage > 1) { %>
                                    <a href="/performer/<%= performerId %>?q=<%= searchTerm || '' %>&page=<%= currentPage - 1 %>" class="page-link">← Previous</a>
                                <% } %>
                                <% for (let i = 1; i <= totalPages; i++) { %>
                                    <% if (i === currentPage) { %>
                                        <span class="page-link active"><%= i %></span>
                                    <% } else if (i <= 3 || i > totalPages - 3 || Math.abs(i - currentPage) <= 1) { %>
                                        <a href="/performer/<%= performerId %>?q=<%= searchTerm || '' %>&page=<%= i %>" class="page-link"><%= i %></a>
                                    <% } else if (i === 4 && currentPage > 5) { %>
                                        <span class="page-link">…</span>
                                    <% } else if (i === totalPages - 3 && currentPage < totalPages - 4) { %>
                                        <span class="page-link">…</span>
                                    <% } %>
                                <% } %>
                                <% if (currentPage < totalPages) { %>
                                    <a href="/performer/<%= performerId %>?q=<%= searchTerm || '' %>&page=<%= currentPage + 1 %>" class="page-link">Next →</a>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Store image URLs -->
            <div id="imageData" data-images='<%= JSON.stringify(performer.images || []) %>' style="display: none;"></div>

        <% } else { %>
            <div class="error-message">
                <p>❌ Performer not found</p>
                <a href="/" class="back-link">← Go back to search</a>
            </div>
        <% } %>

        <footer>
            <p>Data from StashDB</p>
        </footer>
    </div>

    <script>
        // =========================
        // FAVORITE SCENE (Still uses fetch - this is for scenes, not performer)
        // =========================
        function toggleFavoriteScene(sceneId, button) {
            event.preventDefault();
            event.stopPropagation();
            fetch('/api/favorite/scene', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sceneId: sceneId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.favorited) {
                        button.textContent = '⭐';
                        button.style.color = '#f0c040';
                    } else {
                        button.textContent = '☆';
                        button.style.color = '#555';
                    }
                }
            })
            .catch(err => console.error('Error toggling scene favorite:', err));
        }

        // =========================
        // IMAGE CYCLING
        // =========================
        var performerImages = [];
        var currentImageIndex = 0;
        var imageDataElement = document.getElementById('imageData');
        if (imageDataElement) {
            try {
                var imagesData = imageDataElement.getAttribute('data-images');
                if (imagesData && imagesData !== '[]') {
                    performerImages = JSON.parse(imagesData);
                }
            } catch (e) { console.log('Error parsing image data:', e); }
        }

        function changeImage(direction) {
            if (performerImages.length === 0) return;
            currentImageIndex = (currentImageIndex + direction + performerImages.length) % performerImages.length;
            var mainImage = document.getElementById('mainProfileImage');
            var imageCounter = document.getElementById('imageCounter');
            var imageIndexDisplay = document.getElementById('imageIndexDisplay');
            if (mainImage) mainImage.src = performerImages[currentImageIndex].url;
            if (imageCounter) imageCounter.textContent = performerImages.length + ' photos';
            if (imageIndexDisplay) imageIndexDisplay.textContent = (currentImageIndex + 1) + ' / ' + performerImages.length;
        }
    </script>
</body>
</html>