<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            background: #0a0a0a; 
            color: #e0e0e0; 
            min-height: 100vh;
        }
        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }
        
        .back-link {
            display: inline-block;
            color: #667eea;
            text-decoration: none;
            padding: 8px 16px;
            border: 1px solid #667eea;
            border-radius: 8px;
            margin-bottom: 20px;
            transition: all 0.2s;
            font-size: 14px;
        }
        .back-link:hover { background: #667eea; color: #fff; }
        
        h1 {
            font-size: 28px;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .search-section {
            background: #1a1a1a;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 20px;
            border: 1px solid #2a2a2a;
        }
        .search-row {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 12px;
        }
        .search-row label {
            color: #888;
            font-size: 14px;
            min-width: 80px;
            font-weight: 500;
        }
        .search-row input[type="text"],
        .search-row select {
            flex: 1;
            min-width: 150px;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
            transition: border-color 0.2s;
        }
        .search-row input[type="text"]:focus,
        .search-row select:focus {
            outline: none;
            border-color: #667eea;
        }
        .search-row select option {
            background: #1a1a1a;
        }
        
        .search-btn {
            padding: 10px 28px;
            border-radius: 8px;
            border: none;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
        }
        .search-btn:hover { opacity: 0.85; }
        .search-btn:active { transform: scale(0.97); }
        .search-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .cupsize-checkboxes {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            flex: 1;
        }
        .cupsize-checkboxes label {
            display: flex;
            align-items: center;
            gap: 4px;
            color: #ccc;
            font-size: 13px;
            cursor: pointer;
            padding: 4px 10px;
            border-radius: 20px;
            border: 1px solid #333;
            background: #111;
            min-width: auto;
            transition: all 0.2s;
            user-select: none;
        }
        .cupsize-checkboxes label:hover {
            border-color: #667eea;
            background: #1a1a2a;
        }
        .cupsize-checkboxes label input[type="checkbox"] {
            accent-color: #667eea;
            width: 14px;
            height: 14px;
            cursor: pointer;
        }
        
        .selected-studios {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 8px 0;
            min-height: 36px;
        }
        .studio-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #2a2a2a;
            padding: 4px 12px;
            border-radius: 16px;
            font-size: 13px;
            color: #e0e0e0;
            border: 1px solid #333;
        }
        .studio-tag .remove {
            cursor: pointer;
            color: #ff6b6b;
            font-weight: bold;
            font-size: 14px;
            line-height: 1;
            padding: 0 2px;
        }
        .studio-tag .remove:hover { color: #ff4444; }
        
        .studio-search-input {
            flex: 1;
            min-width: 200px;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
            transition: border-color 0.2s;
        }
        .studio-search-input:focus {
            outline: none;
            border-color: #667eea;
        }
        
        .studio-suggestions {
            display: none;
            position: absolute;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 8px;
            max-height: 200px;
            overflow-y: auto;
            min-width: 200px;
            z-index: 100;
            margin-top: 4px;
        }
        .studio-suggestions.show {
            display: block;
        }
        .studio-suggestions .suggestion {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 13px;
            transition: background 0.2s;
        }
        .studio-suggestions .suggestion:hover {
            background: #2a2a2a;
        }
        
        .results-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
            margin-top: 20px;
        }
        .performer-card {
            background: #1a1a1a;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2a2a2a;
            transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
            text-decoration: none;
            color: #e0e0e0;
            cursor: pointer;
            display: block;
        }
        .performer-card:hover {
            transform: translateY(-4px);
            border-color: #667eea;
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.15);
        }
        .performer-card .image {
            width: 100%;
            aspect-ratio: 1;
            background: #111;
            overflow: hidden;
            position: relative;
        }
        .performer-card .image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }
        .performer-card:hover .image img {
            transform: scale(1.03);
        }
        .performer-card .image .no-image {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            font-size: 48px;
            opacity: 0.3;
        }
        .performer-card .info {
            padding: 12px;
        }
        .performer-card .name {
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #fff;
        }
        .performer-card .details {
            font-size: 12px;
            color: #888;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            align-items: center;
            margin-top: 4px;
        }
        .performer-card .details .scene-count {
            color: #888;
        }
        .performer-card .cupsize-badge {
            background: #2a2a2a;
            padding: 1px 8px;
            border-radius: 10px;
            color: #667eea;
            font-weight: bold;
            font-size: 11px;
        }
        .performer-card .cupsize-badge.no-cupsize {
            color: #666;
            font-weight: normal;
        }
        .performer-card .rating {
            font-weight: bold;
            font-size: 15px;
            padding: 0 4px;
            border-radius: 4px;
            min-width: 20px;
            text-align: center;
        }
        .performer-card .favorite-icon {
            color: #ff6b6b;
            font-size: 14px;
        }
        
        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #888;
        }
        .no-results h3 { color: #fff; margin-bottom: 8px; font-size: 20px; }
        .no-results p { font-size: 14px; }
        
        .pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
            flex-wrap: wrap;
        }
        .page-link {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 8px;
            background: #1a1a1a;
            color: #e0e0e0;
            text-decoration: none;
            border: 1px solid #2a2a2a;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
        }
        .page-link:hover {
            background: #2a2a2a;
            border-color: #667eea;
        }
        .page-link.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: #667eea;
            color: #fff;
        }
        .page-link:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }
        
        .loading {
            text-align: center;
            padding: 60px 20px;
            color: #888;
        }
        .loading .spinner {
            display: inline-block;
            width: 40px;
            height: 40px;
            border: 3px solid #2a2a2a;
            border-top-color: #667eea;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .results-info {
            color: #888;
            font-size: 14px;
            margin-top: 16px;
            padding: 12px;
            background: #111;
            border-radius: 8px;
            border: 1px solid #1a1a1a;
        }

        .min-scenes-input {
            width: 80px;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
            text-align: center;
        }
        .min-scenes-input:focus {
            outline: none;
            border-color: #667eea;
        }
        .min-scenes-label {
            color: #888;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }
        .min-scenes-label input[type="checkbox"] {
            accent-color: #667eea;
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        .clear-filters-btn {
            padding: 10px 20px;
            border-radius: 8px;
            border: 1px solid #ff6b6b;
            background: transparent;
            color: #ff6b6b;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
            text-decoration: none;
        }
        .clear-filters-btn:hover {
            background: #ff6b6b;
            color: #fff;
        }

        @media (max-width: 768px) {
            .container { padding: 12px; }
            .search-row { 
                flex-direction: column; 
                align-items: stretch; 
            }
            .search-row label { 
                min-width: auto; 
                font-size: 13px;
            }
            .cupsize-checkboxes { 
                justify-content: flex-start; 
            }
            .cupsize-checkboxes label {
                font-size: 12px;
                padding: 3px 8px;
            }
            .results-grid { 
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); 
                gap: 12px;
            }
            .studio-search-input { min-width: 100%; }
            .search-btn { width: 100%; justify-content: center; }
            h1 { font-size: 22px; }
            .min-scenes-label { 
                flex-wrap: wrap; 
                gap: 4px;
            }
            .min-scenes-input { 
                width: 60px; 
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← Back to Home</a>
        
        <h1>🔍 Advanced Studio Search</h1>
        
        <!-- Server-side search form -->
        <div class="search-section">
            <form method="get" action="/advanced-search" style="width: 100%;">
                <!-- Studios Search -->
                <div class="search-row" style="position: relative;">
                    <label>🎬 Studios</label>
                    <input type="text" id="studioSearch" class="studio-search-input" placeholder="Type studio name and press Enter..." autocomplete="off" value="">
                    <div class="studio-suggestions" id="studioSuggestions"></div>
                </div>
                
                <!-- Selected Studios -->
                <div class="selected-studios" id="selectedStudios">
                    <% if (studios && studios.length > 0) { %>
                        <% studios.forEach(name => { %>
                            <span class="studio-tag">
                                <%= name %>
                                <span class="remove" onclick="removeStudio('<%= name %>')">✕</span>
                            </span>
                        <% }) %>
                    <% } else { %>
                        <span style="color: #666; font-size: 14px;">No studios selected</span>
                    <% } %>
                </div>
                
                <!-- Hidden input for studios -->
                <input type="hidden" name="studios" id="studiosHidden" value="<%= studios ? studios.join(',') : '' %>">
                
                <!-- Match Mode -->
                <div class="search-row">
                    <label>📋 Match</label>
                    <select name="match" id="matchMode">
                        <option value="any" <%= match === 'any' ? 'selected' : '' %>>Any Studio</option>
                        <option value="all" <%= match === 'all' ? 'selected' : '' %>>All Studios</option>
                        <option value="exact" <%= match === 'exact' ? 'selected' : '' %>>Exactly These Studios</option>
                    </select>
                </div>
                
                <!-- Min Scenes Filter -->
                <div class="search-row">
                    <label>🎬 Min Scenes</label>
                    <div class="min-scenes-label">
                        <input type="checkbox" name="minScenesEnabled" id="minScenesToggle" <%= minScenesEnabled !== false ? 'checked' : '' %>>
                        <span>Only performers with at least</span>
                        <input type="number" name="minScenes" id="minScenesValue" class="min-scenes-input" value="<%= minScenes || 12 %>" min="1" max="1000">
                        <span>videos</span>
                    </div>
                </div>
                
                <!-- Cupsize Filter -->
                <div class="search-row">
                    <label>📏 Cup Size</label>
                    <div class="cupsize-checkboxes" id="cupsizeFilter">
                        <label><input type="checkbox" name="cupsize" value="A" <%= cupsize && cupsize.includes('A') ? 'checked' : '' %>> A</label>
                        <label><input type="checkbox" name="cupsize" value="B" <%= cupsize && cupsize.includes('B') ? 'checked' : '' %>> B</label>
                        <label><input type="checkbox" name="cupsize" value="C" <%= cupsize && cupsize.includes('C') ? 'checked' : '' %>> C</label>
                        <label><input type="checkbox" name="cupsize" value="D" <%= cupsize && cupsize.includes('D') ? 'checked' : '' %>> D</label>
                        <label><input type="checkbox" name="cupsize" value="DD" <%= cupsize && cupsize.includes('DD') ? 'checked' : '' %>> DD</label>
                        <label><input type="checkbox" name="cupsize" value="DDD" <%= cupsize && cupsize.includes('DDD') ? 'checked' : '' %>> DDD</label>
                        <label><input type="checkbox" name="cupsize" value="E" <%= cupsize && cupsize.includes('E') ? 'checked' : '' %>> E</label>
                        <label><input type="checkbox" name="cupsize" value="F" <%= cupsize && cupsize.includes('F') ? 'checked' : '' %>> F</label>
                        <label><input type="checkbox" name="cupsize" value="G" <%= cupsize && cupsize.includes('G') ? 'checked' : '' %>> G</label>
                        <label><input type="checkbox" name="cupsize" value="H" <%= cupsize && cupsize.includes('H') ? 'checked' : '' %>> H</label>
                        <label><input type="checkbox" name="cupsize" value="OTHER" <%= cupsize && cupsize.includes('OTHER') ? 'checked' : '' %>> ❓ Other/None</label>
                    </div>
                </div>
                
                <!-- Rating Filter -->
                <div class="search-row">
                    <label>⭐ Rating</label>
                    <select name="tier" id="ratingFilter">
                        <option value="">All</option>
                        <option value="rated" <%= tier === 'rated' ? 'selected' : '' %>>Rated</option>
                        <option value="unrated" <%= tier === 'unrated' ? 'selected' : '' %>>Unrated</option>
                        <option value="S" <%= tier === 'S' ? 'selected' : '' %>>S - Super</option>
                        <option value="A" <%= tier === 'A' ? 'selected' : '' %>>A - Excellent</option>
                        <option value="B" <%= tier === 'B' ? 'selected' : '' %>>B - Good</option>
                        <option value="C" <%= tier === 'C' ? 'selected' : '' %>>C - Average</option>
                        <option value="D" <%= tier === 'D' ? 'selected' : '' %>>D - Poor</option>
                        <option value="F" <%= tier === 'F' ? 'selected' : '' %>>F - Fail</option>
                        <option value="U" <%= tier === 'U' ? 'selected' : '' %>>U - Unrated</option>
                        <option value="L" <%= tier === 'L' ? 'selected' : '' %>>L - Liked</option>
                    </select>
                </div>
                
                <!-- Favorite Filter -->
                <div class="search-row">
                    <label>❤️ Favorite</label>
                    <select name="favorite" id="favoriteFilter">
                        <option value="">All</option>
                        <option value="true" <%= favorite === 'true' ? 'selected' : '' %>>Favorites Only</option>
                        <option value="false" <%= favorite === 'false' ? 'selected' : '' %>>Non-Favorites</option>
                    </select>
                </div>
                
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                    <button type="submit" class="search-btn">🔍 Search</button>
                    <a href="/advanced-search" class="clear-filters-btn">✕ Clear All Filters</a>
                </div>
            </form>
        </div>
        
        <!-- Results - Server Rendered -->
        <div id="resultsContainer">
            <% if (performers && performers.length > 0) { %>
                <div class="results-info">
                    Found <%= total %> performers 
                    <% if (studios && studios.length > 0) { %>in <%= studios.join(', ') %><% } %>
                    <% if (minScenesEnabled !== false && minScenes > 0) { %>with <%= minScenes %>+ scenes<% } %>
                    <% if (cupsize && cupsize.length > 0) { %>with cupsize <%= cupsize.join(', ') %><% } %>
                    <% if (tier) { %>(rating: <%= tier %>)<% } %>
                </div>

                <div class="results-grid">
                    <% 
                    // ⭐ Define helper inside the EJS for rendering
                    function getRatingColor(rating) {
                        switch(rating) {
                            case 'S': return '#ff6b6b';
                            case 'A': return '#ff9f43';
                            case 'B': return '#feca57';
                            case 'C': return '#54a0ff';
                            case 'D': return '#5f27cd';
                            case 'F': return '#ff4757';
                            case 'U': return '#747d8c';
                            case 'L': return '#ff6b81';
                            default: return '#888';
                        }
                    }
                    %>
                    <% performers.forEach(p => { 
                        const imageUrl = p.images && p.images.length > 0 ? p.images[0].url : null;
                        const ratingLetter = p.rating || '';
                        const ratingColor = getRatingColor(ratingLetter);
                    %>
                    <a href="/performer/<%= p.id %>" class="performer-card">
                        <div class="image">
                            <% if (imageUrl) { %>
                                <img src="<%= imageUrl %>" alt="<%= p.name %>" loading="lazy">
                            <% } else { %>
                                <div class="no-image">👤</div>
                            <% } %>
                        </div>
                        <div class="info">
                            <div class="name"><%= p.name %></div>
                            <div class="details">
                                <span class="scene-count">🎬 <%= p.scene_count || 0 %></span>
                                <% if (p.cupsize) { %>
                                    <span class="cupsize-badge"><%= p.cupsize %></span>
                                <% } else { %>
                                    <span class="cupsize-badge no-cupsize">❓</span>
                                <% } %>
                                <% if (ratingLetter) { %>
                                    <span class="rating" style="color: <%= ratingColor %>;"><%= ratingLetter %></span>
                                <% } %>
                                <% if (p.is_favorited) { %>
                                    <span class="favorite-icon">❤️</span>
                                <% } %>
                            </div>
                        </div>
                    </a>
                    <% }) %>
                </div>

                <% if (totalPages > 1) { %>
                    <div class="pagination">
                        <% if (currentPage > 1) { %>
                            <a href="?<%= buildQueryString({ page: currentPage - 1 }) %>" class="page-link">← Previous</a>
                        <% } %>
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <% if (i === currentPage) { %>
                                <span class="page-link active"><%= i %></span>
                            <% } else if (i <= 3 || i > totalPages - 3 || Math.abs(i - currentPage) <= 1) { %>
                                <a href="?<%= buildQueryString({ page: i }) %>" class="page-link"><%= i %></a>
                            <% } else if (i === 4 && currentPage > 5) { %>
                                <span class="page-link">…</span>
                            <% } else if (i === totalPages - 3 && currentPage < totalPages - 4) { %>
                                <span class="page-link">…</span>
                            <% } %>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <a href="?<%= buildQueryString({ page: currentPage + 1 }) %>" class="page-link">Next →</a>
                        <% } %>
                    </div>
                <% } %>

            <% } else if (hasFilters) { %>
                <div class="no-results">
                    <h3>🔍 No Results Found</h3>
                    <p>Try adjusting your search filters</p>
                </div>
            <% } else { %>
                <div class="no-results">
                    <h3>🔍 Search for Performers</h3>
                    <p>Select studios, cup sizes, or ratings to find performers</p>
                    <p style="margin-top: 8px; font-size: 13px; color: #666;">💡 Try searching for a studio name above</p>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        // =========================
        // HELPER FUNCTIONS FOR PAGINATION (Client-side)
        // =========================
        function buildQueryString(params) {
            const current = new URLSearchParams(window.location.search);
            Object.keys(params).forEach(key => {
                if (params[key] !== null && params[key] !== undefined) {
                    current.set(key, params[key]);
                }
            });
            return current.toString();
        }

        // =========================
        // STUDIO SEARCH (Client-side for autocomplete)
        // =========================
        let studioTimeout = null;
        let currentSuggestions = [];
        const studioSearch = document.getElementById('studioSearch');
        const studioSuggestions = document.getElementById('studioSuggestions');
        const selectedStudios = document.getElementById('selectedStudios');
        const studiosHidden = document.getElementById('studiosHidden');

        function getSelectedStudios() {
            return studiosHidden.value ? studiosHidden.value.split(',').filter(s => s) : [];
        }

        function renderStudios() {
            const studios = getSelectedStudios();
            if (studios.length === 0) {
                selectedStudios.innerHTML = '<span style="color: #666; font-size: 14px;">No studios selected</span>';
            } else {
                selectedStudios.innerHTML = studios.map(name => `
                    <span class="studio-tag">
                        ${name}
                        <span class="remove" onclick="removeStudio('${name.replace(/'/g, "\\'")}')">✕</span>
                    </span>
                `).join('');
            }
            studiosHidden.value = studios.join(',');
        }

        function addStudio(name) {
            const studios = getSelectedStudios();
            if (!studios.includes(name)) {
                studios.push(name);
                studiosHidden.value = studios.join(',');
                renderStudios();
                studioSuggestions.classList.remove('show');
                studioSearch.value = '';
            }
        }

        function removeStudio(name) {
            let studios = getSelectedStudios();
            studios = studios.filter(s => s !== name);
            studiosHidden.value = studios.join(',');
            renderStudios();
            // Auto-submit after removing
            document.querySelector('form').submit();
        }

        studioSearch.addEventListener('input', function() {
            clearTimeout(studioTimeout);
            const query = this.value.trim();
            if (query.length < 2) {
                studioSuggestions.classList.remove('show');
                return;
            }
            studioTimeout = setTimeout(() => {
                searchStudios(query);
            }, 300);
        });

        studioSearch.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const query = this.value.trim();
                if (query.length >= 2) {
                    if (currentSuggestions.length > 0) {
                        addStudio(currentSuggestions[0].name);
                    } else {
                        addStudio(query);
                    }
                }
            }
            if (e.key === 'Escape') {
                studioSuggestions.classList.remove('show');
            }
        });

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.search-row')) {
                studioSuggestions.classList.remove('show');
            }
        });

        async function searchStudios(query) {
            try {
                const response = await fetch(`/api/search/studios?q=${encodeURIComponent(query)}`);
                const data = await response.json();
                if (data.studios && data.studios.length > 0) {
                    currentSuggestions = data.studios.slice(0, 10);
                    renderSuggestions(currentSuggestions);
                } else {
                    studioSuggestions.classList.remove('show');
                }
            } catch (error) {
                console.error('Studio search error:', error);
            }
        }

        function renderSuggestions(suggestions) {
            if (suggestions.length === 0) {
                studioSuggestions.classList.remove('show');
                return;
            }
            studioSuggestions.innerHTML = suggestions.map(s => `
                <div class="suggestion" onclick="addStudio('${s.name.replace(/'/g, "\\'")}')">
                    ${s.name} (${s.scene_count || 0} scenes)
                </div>
            `).join('');
            studioSuggestions.classList.add('show');
        }

        // =========================
        // INIT
        // =========================
        renderStudios();
    </script>
</body>
</html>