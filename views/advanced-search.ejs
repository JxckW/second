<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            background: #0a0a0a; 
            color: #e0e0e0; 
            min-height: 100vh;
        }
        .container { max-width: 1400px; margin: 0 auto; padding: 20px; }
        
        .back-link {
            display: inline-block;
            color: #667eea;
            text-decoration: none;
            padding: 8px 16px;
            border: 1px solid #667eea;
            border-radius: 8px;
            margin-bottom: 20px;
            transition: all 0.2s;
            font-size: 14px;
        }
        .back-link:hover { background: #667eea; color: #fff; }
        
        h1 {
            font-size: 28px;
            margin-bottom: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .search-section {
            background: #1a1a1a;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 20px;
            border: 1px solid #2a2a2a;
        }
        .search-row {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 12px;
        }
        .search-row label {
            color: #888;
            font-size: 14px;
            min-width: 80px;
            font-weight: 500;
        }
        .search-row input[type="text"],
        .search-row select {
            flex: 1;
            min-width: 150px;
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
            transition: border-color 0.2s;
        }
        .search-row input[type="text"]:focus,
        .search-row select:focus {
            outline: none;
            border-color: #667eea;
        }
        .search-row select option {
            background: #1a1a1a;
        }
        
        .search-btn {
            padding: 10px 28px;
            border-radius: 8px;
            border: none;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
        }
        .search-btn:hover { opacity: 0.85; }
        .search-btn:active { transform: scale(0.97); }
        .search-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .cupsize-checkboxes {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            flex: 1;
        }
        .cupsize-checkboxes label {
            display: flex;
            align-items: center;
            gap: 4px;
            color: #ccc;
            font-size: 13px;
            cursor: pointer;
            padding: 4px 10px;
            border-radius: 20px;
            border: 1px solid #333;
            background: #111;
            min-width: auto;
            transition: all 0.2s;
            user-select: none;
        }
        .cupsize-checkboxes label:hover {
            border-color: #667eea;
            background: #1a1a2a;
        }
        .cupsize-checkboxes label.active {
            border-color: #667eea;
            background: rgba(102, 126, 234, 0.15);
        }
        .cupsize-checkboxes input[type="checkbox"] {
            accent-color: #667eea;
            width: 14px;
            height: 14px;
            cursor: pointer;
        }
        .cupsize-checkboxes label .checkmark {
            display: none;
        }
        .cupsize-checkboxes label.checked .checkmark {
            display: inline;
        }
        
        .selected-studios {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 8px 0;
            min-height: 36px;
        }
        .studio-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #2a2a2a;
            padding: 4px 12px;
            border-radius: 16px;
            font-size: 13px;
            color: #e0e0e0;
            border: 1px solid #333;
        }
        .studio-tag .remove {
            cursor: pointer;
            color: #ff6b6b;
            font-weight: bold;
            font-size: 14px;
            line-height: 1;
            padding: 0 2px;
        }
        .studio-tag .remove:hover { color: #ff4444; }
        
        .studio-search-input {
            flex: 1;
            min-width: 200px;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
            transition: border-color 0.2s;
        }
        .studio-search-input:focus {
            outline: none;
            border-color: #667eea;
        }
        
        .studio-suggestions {
            display: none;
            position: absolute;
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 8px;
            max-height: 200px;
            overflow-y: auto;
            min-width: 200px;
            z-index: 100;
            margin-top: 4px;
        }
        .studio-suggestions.show {
            display: block;
        }
        .studio-suggestions .suggestion {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 13px;
            transition: background 0.2s;
        }
        .studio-suggestions .suggestion:hover {
            background: #2a2a2a;
        }
        
        .results-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
            margin-top: 20px;
        }
        .performer-card {
            background: #1a1a1a;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2a2a2a;
            transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
            text-decoration: none;
            color: #e0e0e0;
            cursor: pointer;
            display: block;
        }
        .performer-card:hover {
            transform: translateY(-4px);
            border-color: #667eea;
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.15);
        }
        .performer-card .image {
            width: 100%;
            aspect-ratio: 1;
            background: #111;
            overflow: hidden;
            position: relative;
        }
        .performer-card .image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }
        .performer-card:hover .image img {
            transform: scale(1.03);
        }
        .performer-card .image .no-image {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            font-size: 48px;
            opacity: 0.3;
        }
        .performer-card .info {
            padding: 12px;
        }
        .performer-card .name {
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #fff;
        }
        .performer-card .details {
            font-size: 12px;
            color: #888;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            align-items: center;
            margin-top: 4px;
        }
        .performer-card .details .scene-count {
            color: #888;
        }
        .performer-card .cupsize-badge {
            background: #2a2a2a;
            padding: 1px 8px;
            border-radius: 10px;
            color: #667eea;
            font-weight: bold;
            font-size: 11px;
        }
        .performer-card .cupsize-badge.no-cupsize {
            color: #666;
            font-weight: normal;
        }
        .performer-card .rating {
            font-weight: bold;
            font-size: 15px;
            padding: 0 4px;
            border-radius: 4px;
            min-width: 20px;
            text-align: center;
        }
        .performer-card .favorite-icon {
            color: #ff6b6b;
            font-size: 14px;
        }
        
        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #888;
        }
        .no-results h3 { color: #fff; margin-bottom: 8px; font-size: 20px; }
        .no-results p { font-size: 14px; }
        
        .pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
            flex-wrap: wrap;
        }
        .page-link {
            display: inline-block;
            padding: 8px 14px;
            border-radius: 8px;
            background: #1a1a1a;
            color: #e0e0e0;
            text-decoration: none;
            border: 1px solid #2a2a2a;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            font-family: inherit;
        }
        .page-link:hover {
            background: #2a2a2a;
            border-color: #667eea;
        }
        .page-link.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-color: #667eea;
            color: #fff;
        }
        .page-link:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }
        
        .loading {
            text-align: center;
            padding: 60px 20px;
            color: #888;
        }
        .loading .spinner {
            display: inline-block;
            width: 40px;
            height: 40px;
            border: 3px solid #2a2a2a;
            border-top-color: #667eea;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .results-info {
            color: #888;
            font-size: 14px;
            margin-top: 16px;
            padding: 12px;
            background: #111;
            border-radius: 8px;
            border: 1px solid #1a1a1a;
        }

        /* ⭐ NEW: Min Scenes Filter Styles */
        .min-scenes-input {
            width: 80px;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid #333;
            background: #111;
            color: #e0e0e0;
            font-size: 14px;
            text-align: center;
        }
        .min-scenes-input:focus {
            outline: none;
            border-color: #667eea;
        }
        .min-scenes-label {
            color: #888;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }
        .min-scenes-label input[type="checkbox"] {
            accent-color: #667eea;
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        @media (max-width: 768px) {
            .container { padding: 12px; }
            .search-row { 
                flex-direction: column; 
                align-items: stretch; 
            }
            .search-row label { 
                min-width: auto; 
                font-size: 13px;
            }
            .cupsize-checkboxes { 
                justify-content: flex-start; 
            }
            .cupsize-checkboxes label {
                font-size: 12px;
                padding: 3px 8px;
            }
            .results-grid { 
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); 
                gap: 12px;
            }
            .studio-search-input { min-width: 100%; }
            .search-btn { width: 100%; justify-content: center; }
            h1 { font-size: 22px; }
            .min-scenes-label { 
                flex-wrap: wrap; 
                gap: 4px;
            }
            .min-scenes-input { 
                width: 60px; 
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Back link with preserved state -->
        <a href="javascript:history.back()" class="back-link">← Back to Search Results</a>
        
        <h1>🔍 Advanced Studio Search</h1>
        
        <div class="search-section">
            <!-- Studios Search -->
            <div class="search-row" style="position: relative;">
                <label>🎬 Studios</label>
                <input type="text" id="studioSearch" class="studio-search-input" placeholder="Type studio name and press Enter..." autocomplete="off">
                <div class="studio-suggestions" id="studioSuggestions"></div>
            </div>
            
            <!-- Selected Studios -->
            <div class="selected-studios" id="selectedStudios">
                <span style="color: #666; font-size: 14px;">No studios selected</span>
            </div>
            
            <!-- Match Mode -->
            <div class="search-row">
                <label>📋 Match</label>
                <select id="matchMode">
                    <option value="any">Any Studio</option>
                    <option value="all">All Studios</option>
                    <option value="exact">Exactly These Studios</option>
                </select>
            </div>
            
            <!-- ⭐ NEW: Min Scenes Filter -->
            <div class="search-row">
                <label>🎬 Min Scenes</label>
                <div class="min-scenes-label">
                    <input type="checkbox" id="minScenesToggle" checked>
                    <span>Only performers with at least</span>
                    <input type="number" id="minScenesValue" class="min-scenes-input" value="12" min="1" max="1000">
                    <span>videos</span>
                </div>
            </div>
            
            <!-- Cupsize Filter -->
            <div class="search-row">
                <label>📏 Cup Size</label>
                <div class="cupsize-checkboxes" id="cupsizeFilter">
                    <label><input type="checkbox" value="A"> A</label>
                    <label><input type="checkbox" value="B"> B</label>
                    <label><input type="checkbox" value="C"> C</label>
                    <label><input type="checkbox" value="D"> D</label>
                    <label><input type="checkbox" value="DD"> DD</label>
                    <label><input type="checkbox" value="DDD"> DDD</label>
                    <label><input type="checkbox" value="E"> E</label>
                    <label><input type="checkbox" value="F"> F</label>
                    <label><input type="checkbox" value="G"> G</label>
                    <label><input type="checkbox" value="H"> H</label>
                    <label><input type="checkbox" value="OTHER" id="cupsizeOther"> ❓ Other/None</label>
                </div>
            </div>
            
            <!-- Rating Filter -->
            <div class="search-row">
                <label>⭐ Rating</label>
                <select id="ratingFilter">
                    <option value="">All</option>
                    <option value="rated">Rated</option>
                    <option value="unrated">Unrated</option>
                    <option value="S">S - Super</option>
                    <option value="A">A - Excellent</option>
                    <option value="B">B - Good</option>
                    <option value="C">C - Average</option>
                    <option value="D">D - Poor</option>
                    <option value="F">F - Fail</option>
                    <option value="U">U - Unrated</option>
                    <option value="L">L - Liked</option>
                </select>
            </div>
            
            <!-- Favorite Filter -->
            <div class="search-row">
                <label>❤️ Favorite</label>
                <select id="favoriteFilter">
                    <option value="">All</option>
                    <option value="true">Favorites Only</option>
                    <option value="false">Non-Favorites</option>
                </select>
            </div>
            
            <button class="search-btn" id="searchBtn">🔍 Search</button>
        </div>
        
        <div id="resultsContainer">
            <div class="loading">
                <div class="spinner"></div>
                <p style="margin-top: 12px;">Search for performers by studio, cup size, or rating...</p>
            </div>
        </div>
    </div>

    <script>
        // =========================
        // STATE MANAGEMENT
        // =========================
        let state = {
            studios: [],
            matchMode: 'any',
            minScenes: 12,
            minScenesEnabled: true,
            cupsize: [],
            rating: '',
            favorite: '',
            page: 1,
            totalPages: 0
        };
        
        // Load state from URL on page load
        function loadStateFromURL() {
            const params = new URLSearchParams(window.location.search);
            const studiosParam = params.get('studios');
            if (studiosParam) {
                state.studios = studiosParam.split(',').filter(s => s);
            }
            state.matchMode = params.get('match') || 'any';
            state.minScenes = parseInt(params.get('minScenes')) || 12;
            state.minScenesEnabled = params.get('minScenesEnabled') !== 'false';
            state.cupsize = params.get('cupsize') ? params.get('cupsize').split(',').filter(c => c) : [];
            state.rating = params.get('tier') || '';
            state.favorite = params.get('favorite') || '';
            state.page = parseInt(params.get('page')) || 1;
        }
        
        // Update URL with current state
        function updateURL() {
            const params = new URLSearchParams();
            if (state.studios.length > 0) {
                params.set('studios', state.studios.join(','));
            }
            if (state.matchMode && state.matchMode !== 'any') {
                params.set('match', state.matchMode);
            }
            if (state.minScenesEnabled && state.minScenes > 0) {
                params.set('minScenes', state.minScenes);
                params.set('minScenesEnabled', 'true');
            } else {
                params.set('minScenesEnabled', 'false');
            }
            if (state.cupsize.length > 0) {
                params.set('cupsize', state.cupsize.join(','));
            }
            if (state.rating) {
                params.set('tier', state.rating);
            }
            if (state.favorite) {
                params.set('favorite', state.favorite);
            }
            if (state.page > 1) {
                params.set('page', state.page);
            }
            
            const newURL = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
            window.history.replaceState({ ...state }, '', newURL);
        }
        
        // =========================
        // DOM REFS
        // =========================
        const studioSearch = document.getElementById('studioSearch');
        const selectedStudios = document.getElementById('selectedStudios');
        const studioSuggestions = document.getElementById('studioSuggestions');
        const matchMode = document.getElementById('matchMode');
        const minScenesToggle = document.getElementById('minScenesToggle');
        const minScenesValue = document.getElementById('minScenesValue');
        const cupsizeCheckboxes = document.querySelectorAll('#cupsizeFilter input[type="checkbox"]');
        const cupsizeOther = document.getElementById('cupsizeOther');
        const ratingFilter = document.getElementById('ratingFilter');
        const favoriteFilter = document.getElementById('favoriteFilter');
        const searchBtn = document.getElementById('searchBtn');
        const resultsContainer = document.getElementById('resultsContainer');
        
        // =========================
        // MIN SCENES HANDLING
        // =========================
        function getMinScenes() {
            if (!minScenesToggle.checked) return 0;
            const val = parseInt(minScenesValue.value);
            return isNaN(val) || val < 1 ? 12 : val;
        }
        
        minScenesToggle.addEventListener('change', function() {
            state.minScenesEnabled = this.checked;
            state.minScenes = getMinScenes();
            updateURL();
            autoSearch();
        });
        
        minScenesValue.addEventListener('change', function() {
            state.minScenes = getMinScenes();
            updateURL();
            autoSearch();
        });
        
        // =========================
        // STUDIO SEARCH
        // =========================
        let studioTimeout = null;
        let currentSuggestions = [];
        
        studioSearch.addEventListener('input', function() {
            clearTimeout(studioTimeout);
            const query = this.value.trim();
            if (query.length < 2) {
                studioSuggestions.classList.remove('show');
                return;
            }
            
            studioTimeout = setTimeout(() => {
                searchStudios(query);
            }, 300);
        });
        
        studioSearch.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const query = this.value.trim();
                if (query.length >= 2) {
                    if (currentSuggestions.length > 0) {
                        addStudio(currentSuggestions[0].name);
                        studioSearch.value = '';
                        studioSuggestions.classList.remove('show');
                    } else {
                        addStudio(query);
                        studioSearch.value = '';
                    }
                }
            }
            if (e.key === 'Escape') {
                studioSuggestions.classList.remove('show');
            }
        });
        
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.search-row')) {
                studioSuggestions.classList.remove('show');
            }
        });
        
        async function searchStudios(query) {
            try {
                const response = await fetch(`/api/search/studios?q=${encodeURIComponent(query)}`);
                const data = await response.json();
                
                if (data.studios && data.studios.length > 0) {
                    currentSuggestions = data.studios.slice(0, 10);
                    renderSuggestions(currentSuggestions);
                } else {
                    studioSuggestions.classList.remove('show');
                }
            } catch (error) {
                console.error('Studio search error:', error);
            }
        }
        
        function renderSuggestions(suggestions) {
            if (suggestions.length === 0) {
                studioSuggestions.classList.remove('show');
                return;
            }
            
            studioSuggestions.innerHTML = suggestions.map(s => `
                <div class="suggestion" onclick="addStudio('${s.name.replace(/'/g, "\\'")}')">
                    ${s.name} (${s.scene_count || 0} scenes)
                </div>
            `).join('');
            studioSuggestions.classList.add('show');
        }
        
        // =========================
        // STUDIO MANAGEMENT
        // =========================
        function addStudio(name) {
            if (!state.studios.includes(name)) {
                state.studios.push(name);
                renderStudios();
                updateURL();
                studioSuggestions.classList.remove('show');
                studioSearch.value = '';
                autoSearch();
            }
        }
        
        function removeStudio(name) {
            state.studios = state.studios.filter(s => s !== name);
            renderStudios();
            updateURL();
            autoSearch();
        }
        
        function renderStudios() {
            if (state.studios.length === 0) {
                selectedStudios.innerHTML = '<span style="color: #666; font-size: 14px;">No studios selected</span>';
                return;
            }
            
            selectedStudios.innerHTML = state.studios.map(name => `
                <span class="studio-tag">
                    ${name}
                    <span class="remove" onclick="removeStudio('${name.replace(/'/g, "\\'")}')">✕</span>
                </span>
            `).join('');
        }
        
        // =========================
        // CUPSIZE MANAGEMENT
        // =========================
        function getSelectedCupsize() {
            const selected = [];
            let otherChecked = false;
            
            cupsizeCheckboxes.forEach(cb => {
                if (cb.checked) {
                    if (cb.value === 'OTHER') {
                        otherChecked = true;
                    } else {
                        selected.push(cb.value);
                    }
                }
            });
            
            if (otherChecked) {
                selected.push('OTHER');
            }
            
            return selected;
        }
        
        function setCupsizeFromState() {
            cupsizeCheckboxes.forEach(cb => {
                cb.checked = state.cupsize.includes(cb.value);
            });
        }
        
        function updateCupsizeUI() {
            cupsizeCheckboxes.forEach(cb => {
                const label = cb.closest('label');
                if (cb.checked) {
                    label.classList.add('checked');
                } else {
                    label.classList.remove('checked');
                }
            });
        }
        
        cupsizeOther.addEventListener('change', function() {
            if (this.checked) {
                cupsizeCheckboxes.forEach(cb => {
                    if (cb.value !== 'OTHER') cb.checked = false;
                });
            }
            state.cupsize = getSelectedCupsize();
            updateCupsizeUI();
            updateURL();
            autoSearch();
        });
        
        cupsizeCheckboxes.forEach(cb => {
            cb.addEventListener('change', function() {
                if (this.value !== 'OTHER' && this.checked) {
                    cupsizeOther.checked = false;
                }
                state.cupsize = getSelectedCupsize();
                updateCupsizeUI();
                updateURL();
                autoSearch();
            });
        });
        
        // =========================
        // FILTER CHANGES
        // =========================
        matchMode.addEventListener('change', function() {
            state.matchMode = this.value;
            updateURL();
            autoSearch();
        });
        
        ratingFilter.addEventListener('change', function() {
            state.rating = this.value;
            updateURL();
            autoSearch();
        });
        
        favoriteFilter.addEventListener('change', function() {
            state.favorite = this.value;
            updateURL();
            autoSearch();
        });
        
        // =========================
        // SEARCH
        // =========================
        let searchTimeout = null;
        
        function autoSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                performSearch();
            }, 400);
        }
        
        searchBtn.addEventListener('click', function() {
            performSearch();
        });
        
        async function performSearch(page = 1) {
            state.page = page;
            updateURL();
            
            resultsContainer.innerHTML = `
                <div class="loading">
                    <div class="spinner"></div>
                    <p style="margin-top: 12px;">Searching...</p>
                </div>
            `;
            
            const params = new URLSearchParams();
            if (state.studios.length > 0) {
                params.set('studios', state.studios.join(','));
            }
            if (state.matchMode) {
                params.set('match', state.matchMode);
            }
            if (state.minScenesEnabled && state.minScenes > 0) {
                params.set('minScenes', state.minScenes);
            }
            if (state.cupsize.length > 0) {
                params.set('cupsize', state.cupsize.join(','));
            }
            if (state.rating) {
                params.set('tier', state.rating);
            }
            if (state.favorite) {
                params.set('favorite', state.favorite);
            }
            params.set('page', page);
            params.set('perPage', 50);
            
            try {
                const response = await fetch(`/api/search/advanced?${params.toString()}`);
                const data = await response.json();
                
                if (!data.success) {
                    resultsContainer.innerHTML = `
                        <div class="no-results">
                            <h3>❌ Error</h3>
                            <p>${data.error || 'Something went wrong'}</p>
                        </div>
                    `;
                    return;
                }
                
                if (data.performers.length === 0) {
                    resultsContainer.innerHTML = `
                        <div class="no-results">
                            <h3>🔍 No Results Found</h3>
                            <p>Try adjusting your search filters</p>
                        </div>
                    `;
                    return;
                }
                
                renderResults(data);
                
            } catch (error) {
                console.error('Search error:', error);
                resultsContainer.innerHTML = `
                    <div class="no-results">
                        <h3>❌ Error</h3>
                        <p>${error.message}</p>
                    </div>
                `;
            }
        }
        
        function getRatingColor(rating) {
            switch(rating) {
                case 'S': return '#ff6b6b';
                case 'A': return '#ff9f43';
                case 'B': return '#feca57';
                case 'C': return '#54a0ff';
                case 'D': return '#5f27cd';
                case 'F': return '#ff4757';
                case 'U': return '#747d8c';
                case 'L': return '#ff6b81';
                default: return '#888';
            }
        }
        
        function renderResults(data) {
            const performers = data.performers;
            state.totalPages = data.totalPages || 1;
            
            let resultsInfo = `
                <div class="results-info">
                    Found ${data.total || performers.length} performers 
                    ${state.studios.length > 0 ? `in ${state.studios.join(', ')}` : ''}
                    ${state.minScenesEnabled ? `with ${state.minScenes}+ scenes` : ''}
                    ${state.cupsize.length > 0 ? `with cupsize ${state.cupsize.join(', ')}` : ''}
                    ${state.rating ? `(rating: ${state.rating})` : ''}
                </div>
            `;
            
            let html = resultsInfo;
            html += `<div class="results-grid">`;
            
            performers.forEach(p => {
                const imageUrl = p.images && p.images.length > 0 ? p.images[0].url : null;
                const ratingLetter = p.rating || '';
                const ratingColor = getRatingColor(ratingLetter);
                
                html += `
                    <a href="/performer/${p.id}" class="performer-card">
                        <div class="image">
                            ${imageUrl ? `<img src="${imageUrl}" alt="${p.name}" loading="lazy">` : '<div class="no-image">👤</div>'}
                        </div>
                        <div class="info">
                            <div class="name">${p.name}</div>
                            <div class="details">
                                <span class="scene-count">🎬 ${p.scene_count || 0}</span>
                                ${p.cupsize ? `<span class="cupsize-badge">${p.cupsize}</span>` : '<span class="cupsize-badge no-cupsize">❓</span>'}
                                ${ratingLetter ? `<span class="rating" style="color: ${ratingColor};">${ratingLetter}</span>` : ''}
                                ${p.is_favorited ? '<span class="favorite-icon">❤️</span>' : ''}
                            </div>
                        </div>
                    </a>
                `;
            });
            
            html += `</div>`;
            
            if (state.totalPages > 1) {
                html += `<div class="pagination">`;
                
                if (state.page > 1) {
                    html += `<button class="page-link" onclick="performSearch(${state.page - 1})">← Previous</button>`;
                }
                
                for (let i = 1; i <= state.totalPages; i++) {
                    if (i === state.page) {
                        html += `<span class="page-link active">${i}</span>`;
                    } else if (i <= 3 || i > state.totalPages - 3 || Math.abs(i - state.page) <= 1) {
                        html += `<button class="page-link" onclick="performSearch(${i})">${i}</button>`;
                    } else if (i === 4 && state.page > 5) {
                        html += `<span class="page-link">…</span>`;
                    } else if (i === state.totalPages - 3 && state.page < state.totalPages - 4) {
                        html += `<span class="page-link">…</span>`;
                    }
                }
                
                if (state.page < state.totalPages) {
                    html += `<button class="page-link" onclick="performSearch(${state.page + 1})">Next →</button>`;
                }
                
                html += `</div>`;
            }
            
            resultsContainer.innerHTML = html;
        }
        
        // =========================
        // HISTORY / BACK NAVIGATION
        // =========================
        window.addEventListener('popstate', function(event) {
            if (event.state) {
                state = { ...state, ...event.state };
                matchMode.value = state.matchMode || 'any';
                minScenesToggle.checked = state.minScenesEnabled !== false;
                minScenesValue.value = state.minScenes || 12;
                ratingFilter.value = state.rating || '';
                favoriteFilter.value = state.favorite || '';
                setCupsizeFromState();
                updateCupsizeUI();
                renderStudios();
                performSearch(state.page || 1);
            }
        });
        
        // =========================
        // INIT
        // =========================
        function init() {
            loadStateFromURL();
            
            matchMode.value = state.matchMode || 'any';
            minScenesToggle.checked = state.minScenesEnabled !== false;
            minScenesValue.value = state.minScenes || 12;
            ratingFilter.value = state.rating || '';
            favoriteFilter.value = state.favorite || '';
            setCupsizeFromState();
            updateCupsizeUI();
            renderStudios();
            
            if (state.studios.length > 0 || state.cupsize.length > 0 || state.rating || state.minScenesEnabled) {
                performSearch(state.page || 1);
            } else {
                resultsContainer.innerHTML = `
                    <div class="no-results">
                        <h3>🔍 Search for Performers</h3>
                        <p>Select studios, cup sizes, or ratings to find performers</p>
                        <p style="margin-top: 8px; font-size: 13px; color: #666;">💡 Try searching for a studio name above</p>
                    </div>
                `;
            }
        }
        
        init();
    </script>
</body>
</html>