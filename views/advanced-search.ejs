<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Advanced Studio Search</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif; background: #0a0a0a; color: #e0e0e0; padding: 0; margin: 0; min-height: 100vh; }
        .app { max-width: 1200px; margin: 0 auto; padding: 16px; }
        header { margin-bottom: 20px; padding: 16px 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; }
        header h1 { font-size: 28px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block; }
        .back-link { display: inline-block; color: #667eea; text-decoration: none; font-size: 14px; }
        .back-link:hover { text-decoration: underline; }
        .logout-btn { color: #ff6b6b; text-decoration: none; padding: 8px 16px; border: 1px solid #ff6b6b; border-radius: 8px; font-size: 14px; transition: all 0.2s; }
        .logout-btn:hover { background: #ff6b6b; color: #fff; }

        .filter-section { background: #1a1a1a; border-radius: 16px; padding: 24px; margin-bottom: 24px; border: 1px solid #2a2a2a; }
        .filter-section label { color: #888; font-size: 13px; font-weight: 600; display: block; margin-bottom: 6px; }
        
        .studio-search-row { display: flex; gap: 10px; margin-bottom: 12px; }
        .studio-search-row input { flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid #333; background: #252525; color: #e0e0e0; font-size: 14px; }
        .studio-search-row input:focus { outline: none; border-color: #667eea; }
        .studio-search-row button { padding: 10px 20px; border-radius: 8px; border: none; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; cursor: pointer; font-weight: 600; }
        .studio-search-row button:hover { opacity: 0.9; }
        
        .studio-list { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; min-height: 40px; padding: 8px; background: #111; border-radius: 8px; border: 1px solid #2a2a2a; }
        .studio-tag { display: inline-flex; align-items: center; gap: 6px; background: #252525; padding: 4px 10px; border-radius: 16px; font-size: 13px; border: 1px solid #667eea; }
        .studio-tag .remove { cursor: pointer; color: #ff6b6b; font-weight: bold; margin-left: 4px; }
        .studio-tag .remove:hover { color: #ff4444; }
        
        .filter-section select { width: 100%; padding: 10px 14px; border-radius: 8px; background: #252525; color: #e0e0e0; border: 1px solid #333; font-size: 14px; cursor: pointer; }
        .filter-section select[multiple] { min-height: 150px; }
        .filter-section select:focus { outline: none; border-color: #667eea; }
        .filter-section select option:checked { background: #667eea; }
        .filter-section .hint { color: #666; font-size: 12px; margin-top: 4px; }
        .filter-section .row { display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-end; margin-top: 16px; }
        .filter-section .row .group { flex: 1; min-width: 200px; }
        .filter-section .row .group label { display: block; color: #888; font-size: 13px; margin-bottom: 4px; }
        .filter-section .row .group select { width: 100%; }
        .filter-section .match-type { display: flex; gap: 16px; align-items: center; margin-top: 12px; flex-wrap: wrap; }
        .filter-section .match-type label { color: #888; font-size: 13px; display: flex; align-items: center; gap: 6px; cursor: pointer; }
        .filter-section .match-type input[type="radio"] { accent-color: #667eea; }
        .filter-section .actions { display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap; }
        .filter-section .actions button { padding: 12px 24px; border-radius: 8px; border: none; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; cursor: pointer; font-weight: 600; font-size: 16px; }
        .filter-section .actions button:hover { opacity: 0.9; }
        .filter-section .actions button.secondary { background: #333; }

        .result-stats { color: #888; font-size: 14px; margin-bottom: 16px; }
        .performer-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
        .performer-card { background: #1a1a1a; border-radius: 12px; padding: 16px; border: 1px solid #2a2a2a; transition: transform 0.2s; cursor: pointer; }
        .performer-card:hover { transform: translateY(-4px); border-color: #667eea; }
        .performer-card .name { font-size: 18px; font-weight: bold; color: #fff; }
        .performer-card .name:hover { color: #667eea; }
        .performer-card .rating { display: inline-block; padding: 2px 10px; border-radius: 12px; margin-top: 8px; font-size: 13px; }
        .performer-card .rating.rated { background: #2a2a2a; border: 1px solid #f0c040; color: #f0c040; }
        .performer-card .rating.unrated { background: #1a1a1a; border: 1px solid #444; color: #666; }
        .performer-card .meta { color: #888; font-size: 13px; margin-top: 8px; }
        .performer-card .meta span { margin-right: 12px; }
        .performer-card .studios { color: #667eea; font-size: 12px; margin-top: 6px; }

        .loading { text-align: center; padding: 40px; color: #888; }
        .pagination { display: flex; justify-content: center; gap: 8px; margin-top: 20px; flex-wrap: wrap; }
        .page-link { padding: 8px 16px; border-radius: 8px; background: #1a1a1a; border: 1px solid #333; color: #e0e0e0; cursor: pointer; }
        .page-link.active { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-color: #667eea; color: #fff; }
        .page-link:hover { background: #2a2a2a; }

        @media (max-width: 768px) { .filter-section .row { flex-direction: column; } }
    </style>
</head>
<body>
    <div class="app">
        <header>
            <div>
                <a href="/" class="back-link">← Back to Home</a>
                <h1>🔍 Studio Search</h1>
            </div>
            <a href="/logout" class="logout-btn">🚪 Logout</a>
        </header>

        <div class="filter-section">
            <!-- Studio Search with Add Button -->
            <div class="studio-search-row">
                <input type="text" id="studioSearchInput" placeholder="Search for a studio..." onkeyup="if(event.key==='Enter') addStudio()">
                <button onclick="addStudio()">➕ Add</button>
            </div>
            
            <!-- Selected Studios Display -->
            <div class="studio-list" id="studioList">
                <span style="color: #666; font-size: 13px;">No studios selected. Search and add above.</span>
            </div>
            
            <div style="margin-bottom: 12px;">
                <label>🏢 Or select from list:</label>
                <select id="studioFilter" multiple>
                    <option value="">Loading studios...</option>
                </select>
                <div class="hint">Hold Ctrl (Cmd on Mac) to select multiple studios from the list</div>
            </div>

            <div class="row">
                <div class="group">
                    <label>⭐ Tier Filter</label>
                    <select id="tierFilter">
                        <option value="all">All</option>
                        <option value="rated">Rated Only</option>
                        <option value="unrated">Unrated Only</option>
                        <option value="S">S</option>
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                        <option value="D">D</option>
                        <option value="F">F</option>
                        <option value="U">U</option>
                        <option value="L">L</option>
                    </select>
                </div>
                <div class="group">
                    <label>❤️ Favorites</label>
                    <select id="favoriteFilter">
                        <option value="all">All</option>
                        <option value="true">Favorited Only</option>
                        <option value="false">Not Favorited</option>
                    </select>
                </div>
            </div>

            <div class="match-type">
    <label>
        <input type="radio" name="matchType" value="any">
        Any selected studio
    </label>
    <label>
        <input type="radio" name="matchType" value="all" checked>
        All selected studios
    </label>
    <label>
        <input type="radio" name="matchType" value="exact">
        Exactly selected studios (no others)
    </label>
</div>

            <div class="actions">
                <button onclick="searchPerformers()">🔍 Search</button>
                <button class="secondary" onclick="clearFilters()">✕ Clear All</button>
            </div>
        </div>

        <div id="resultStats" class="result-stats"></div>
        <div id="results" class="performer-grid"></div>
        <div id="pagination" class="pagination"></div>
        <div id="loadingIndicator" class="loading" style="display:none;">Loading...</div>
    </div>

    <script>
        let currentPage = 1;
        let totalPages = 1;
        let selectedStudios = [];

        // =========================
        // LOAD STUDIOS
        // =========================
        async function loadStudios() {
            try {
                const response = await fetch('/api/search/studios?q=');
                const data = await response.json();
                const select = document.getElementById('studioFilter');
                if (data.studios && data.studios.length > 0) {
                    console.log(`📊 Loaded ${data.studios.length} studios`);
                    select.innerHTML = data.studios.map(s => 
                        `<option value="${s.name}">${s.name} (${s.scene_count || 0} scenes)</option>`
                    ).join('');
                } else {
                    select.innerHTML = '<option value="">No studios found</option>';
                }
            } catch (error) {
                console.error('Error loading studios:', error);
                document.getElementById('studioFilter').innerHTML = '<option value="">Error loading studios</option>';
            }
        }

        // =========================
        // ADD STUDIO FROM SEARCH
        // =========================
        function addStudio() {
            const input = document.getElementById('studioSearchInput');
            const studioName = input.value.trim();
            
            if (!studioName) return;
            
            // Check if already selected
            if (selectedStudios.includes(studioName)) {
                alert('Studio already selected');
                return;
            }
            
            // Verify the studio exists in the list
            const select = document.getElementById('studioFilter');
            const options = Array.from(select.options).map(opt => opt.value);
            if (!options.includes(studioName)) {
                alert('Studio not found. Please select from the list.');
                return;
            }
            
            selectedStudios.push(studioName);
            input.value = '';
            updateStudioTags();
        }

        // =========================
        // REMOVE STUDIO
        // =========================
        function removeStudio(studioName) {
            selectedStudios = selectedStudios.filter(s => s !== studioName);
            updateStudioTags();
        }

        // =========================
        // UPDATE STUDIO TAGS
        // =========================
        function updateStudioTags() {
            const container = document.getElementById('studioList');
            
            if (selectedStudios.length === 0) {
                container.innerHTML = '<span style="color: #666; font-size: 13px;">No studios selected. Search and add above, or select from the list.</span>';
                return;
            }
            
            container.innerHTML = selectedStudios.map(name => `
                <span class="studio-tag">
                    🏢 ${name}
                    <span class="remove" onclick="removeStudio('${name}')">✕</span>
                </span>
            `).join('');
        }

        // =========================
        // HANDLE MULTI-SELECT FROM LIST
        // =========================
        document.getElementById('studioFilter').addEventListener('change', function() {
            const selected = Array.from(this.selectedOptions).map(opt => opt.value);
            // Add any new selections
            for (const name of selected) {
                if (!selectedStudios.includes(name)) {
                    selectedStudios.push(name);
                }
            }
            // Remove any that were deselected
            selectedStudios = selectedStudios.filter(s => selected.includes(s));
            updateStudioTags();
        });

        // =========================
        // SEARCH - WITH RATING DISPLAY FIX
        // =========================
        async function searchPerformers(page = 1) {
            const tier = document.getElementById('tierFilter').value;
            const favorite = document.getElementById('favoriteFilter').value;
            const matchType = document.querySelector('input[name="matchType"]:checked').value;
            
            const loading = document.getElementById('loadingIndicator');
            const results = document.getElementById('results');
            
            if (selectedStudios.length === 0) {
                results.innerHTML = '<div class="loading">Please select at least one studio</div>';
                return;
            }
            
            loading.style.display = 'block';
            results.innerHTML = '';
            document.getElementById('resultStats').textContent = '';
            
            // Send studio names
            const url = `/api/search/advanced?studios=${selectedStudios.map(s => encodeURIComponent(s)).join(',')}&tier=${tier}&favorite=${favorite}&match=${matchType}&page=${page}&perPage=50`;
            
            try {
                const response = await fetch(url);
                const data = await response.json();
                loading.style.display = 'none';
                
                // Debug: Log the first performer to check ratings
                if (data.success && data.performers && data.performers.length > 0) {
                    console.log('📊 First performer:', data.performers[0]);
                    console.log('📊 Rating value:', data.performers[0].rating);
                    console.log('📊 Is favorited:', data.performers[0].is_favorited);
                }
                
                if (data.success) {
                    if (data.performers.length === 0) {
                        results.innerHTML = '<div class="loading">No performers found matching your criteria</div>';
                        document.getElementById('resultStats').textContent = '0 results';
                        return;
                    }
                    
                    results.innerHTML = data.performers.map(p => {
                        // Check if rating exists
                        const hasRating = p.rating && p.rating !== 'null' && p.rating !== 'undefined' && p.rating !== '';
                        const ratingClass = hasRating ? 'rated' : 'unrated';
                        const ratingText = hasRating ? `⭐ Grade: ${p.rating}` : 'Not rated';
                        
                        return `
                            <div class="performer-card" onclick="window.location.href='/performer/${p.id}'">
                                <div class="name">${p.name}</div>
                                <div class="rating ${ratingClass}">
                                    ${ratingText}
                                </div>
                                <div class="meta">
                                    ${p.gender ? `⚥ ${p.gender} ` : ''}
                                    ${p.age ? `🎂 ${p.age} • ` : ''}
                                    ${p.scene_count || 0} scenes
                                    ${p.is_favorited ? ' ❤️' : ''}
                                    ${p.country ? ` • ${p.country}` : ''}
                                </div>
                                <div class="studios">
                                    🏢 ${p.studios ? p.studios.join(', ') : ''}
                                </div>
                            </div>
                        `;
                    }).join('');
                    
                    document.getElementById('resultStats').textContent = `${data.total} results`;
                    totalPages = data.totalPages;
                    currentPage = data.page;
                    updatePagination();
                } else {
                    results.innerHTML = `<div class="loading">Error: ${data.error || 'Please try again'}</div>`;
                }
            } catch (error) {
                loading.style.display = 'none';
                results.innerHTML = '<div class="loading">Error searching. Please try again.</div>';
                console.error('Search error:', error);
            }
        }

        // =========================
        // PAGINATION
        // =========================
        function updatePagination() {
            const container = document.getElementById('pagination');
            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }
            
            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                html += `<button class="page-link ${i === currentPage ? 'active' : ''}" onclick="searchPerformers(${i})">${i}</button>`;
            }
            container.innerHTML = html;
        }

        // =========================
        // CLEAR FILTERS
        // =========================
        function clearFilters() {
            selectedStudios = [];
            updateStudioTags();
            document.getElementById('studioFilter').selectedIndex = -1;
            document.getElementById('tierFilter').value = 'all';
            document.getElementById('favoriteFilter').value = 'all';
            document.querySelector('input[name="matchType"][value="any"]').checked = true;
            document.getElementById('results').innerHTML = '';
            document.getElementById('resultStats').textContent = '';
        }

        // =========================
        // LOAD STUDIOS ON PAGE LOAD
        // =========================
        loadStudios();
    </script>
</body>
</html>